---
export interface Props {
  postCount: number;
  lastUpdate: Date;
}

const { postCount, lastUpdate } = Astro.props;
---

<div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 shadow-sm space-y-4">
  <h3 class="text-sm font-semibold text-gray-700">站点统计</h3>

  <div class="space-y-3">
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">文章数目</span>
      <span class="text-sm font-bold text-gray-800">{postCount}</span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">访客总量</span>
      <span class="text-sm font-bold text-gray-800" id="busuanzi_value_site_uv">--</span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">浏览数量</span>
      <span class="text-sm font-bold text-gray-800" id="busuanzi_value_site_pv">--</span>
    </div>
    <hr class="border-gray-200" />
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">最后更新</span>
      <span class="text-xs text-gray-600">
        {lastUpdate.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
      </span>
    </div>
  </div>
</div>
