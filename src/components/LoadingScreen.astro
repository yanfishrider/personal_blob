---
// LoadingScreen.astro — NieR 风格页面加载动画（网格点阵徽章 + 代码雨 + 终端打字）
// 徽章源码: ascii-art.txt（编辑此文件即可改徽章）
---

<div id="nier-loading" class="fixed inset-0 z-[9999] overflow-hidden" style="background: #1C1814; background-image: linear-gradient(rgba(0,0,0,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.15) 1px, transparent 1px); background-size: 5px 5px;">
  <canvas id="nier-grid-art" class="absolute inset-0 w-full h-full z-[5] pointer-events-none"></canvas>

  <div class="absolute top-8 left-8 sm:top-12 sm:left-12 z-10">
    <p class="text-white tracking-[0.15em]">
      <span class="text-3xl sm:text-4xl">LOADING</span><span class="text-lg sm:text-xl">_系统启动中</span><span id="nier-dots" class="text-lg sm:text-xl"></span>
    </p>
  </div>

  <div id="nier-lines" class="absolute top-[22%] left-[3%] sm:top-[28%] sm:left-[3%] space-y-2 text-sm sm:text-base z-10"></div>
</div>

<script>
  import asciiRaw from '../../ascii-art.txt?raw';
  const ASCII_EMBLEM = asciiRaw.split('\n').filter(r => r.length > 0);

  const GLITCH_CHARS = '!@#$%^&*<>?|/\\{}[]±§※☆★○●◎◇◆□■△▲▽▼→←↑↓↔↕♠♣♥♦♂♀∞≈≠≤≥';
  function randomGlitch() { return GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)]; }
  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

  const lines = [
    '正在连接服务器 - 完成','加载页面资源 - 完毕','初始化渲染引擎 - 通过',
    '解析全局样式表 - 通过','加载字体文件 - 完成','编译脚本模块 - 完毕',
    '建立WebSocket连接 - 完成','初始化路由表 - 通过','验证资源完整性 - 通过','页面准备就绪',
  ];

  if ((localStorage.getItem('loading-animation') || 'nier') !== 'nier') {
    document.getElementById('nier-loading')?.remove();
  } else if (sessionStorage.getItem('nier-intro-done')) {
    document.getElementById('nier-loading')?.remove();
  } else {
    sessionStorage.setItem('nier-intro-done', '1');

    // 5px 格 → 与 CSS 网格对齐
    const CELL = 1.5, GAP = 0, STEP = CELL + GAP; // 缩小25%
    const DOT = 2, OFF = (CELL - DOT) / 2;
    const STRETCH_Y = 2.75; // 拉长10%
    const STRETCH_X = 1.5;  // 拉宽10%
    const DENSITY_MAP = {
      ' ': 0, '@': 0.50, '#': 0.44, '%': 0.38, '*': 0.32, '=': 0.26,
      '+': 0.20, '-': 0.14, ':': 0.08, '.': 0.04,
    };

    function drawGridArt() {
      const canvas = document.getElementById('nier-grid-art');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      function drawDots(arr, ox, oy) {
        for (let r = 0; r < arr.length; r++) {
          const row = arr[r];
          for (let c = 0; c < row.length; c++) {
            const a = DENSITY_MAP[row[c]] || 0;
            if (a > 0) {
              ctx.fillStyle = `rgba(200,200,210,${a})`;
              ctx.fillRect(ox + c * STEP * STRETCH_X + OFF, oy + r * STEP * STRETCH_Y + OFF, DOT * STRETCH_X, DOT * STRETCH_Y);
            }
          }
        }
      }

      const ew = ASCII_EMBLEM[0].length * STEP * STRETCH_X;
      const eh = ASCII_EMBLEM.length * STEP * STRETCH_Y;
      const ox = (canvas.width - ew) / 2; // 居中
      const oy = (canvas.height - eh) / 2;

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawDots(ASCII_EMBLEM, ox, oy);
    }

    drawGridArt();
    window.addEventListener('resize', drawGridArt);

    const container = document.getElementById('nier-lines');
    if (!container) throw new Error('missing #nier-lines');
    const CHAR_DELAY = 22, GLITCH_DURATION = 28;
    const glitchChance = Math.random() * 0.08;
    const dotsEl = document.getElementById('nier-dots');
    const dotStates = ['_', '.', '..', '...', ''];
    let dotIdx = 0;
    const dotTimer = setInterval(() => { if (dotsEl) dotsEl.textContent = dotStates[dotIdx]; dotIdx = (dotIdx + 1) % dotStates.length; }, 400);

    async function typeLine(text, isLast) {
      const el = document.createElement('p');
      el.className = 'tracking-wider';
      container.appendChild(el);
      for (let i = 0; i < text.length; i++) {
        const span = document.createElement('span');
        span.className = 'nier-char'; span.style.color = 'rgba(255,255,255,0.2)'; span.textContent = text[i];
        if (Math.random() < glitchChance) {
          const gs = document.createElement('span'); gs.textContent = randomGlitch(); gs.style.color = 'rgba(255,255,255,0.5)';
          el.appendChild(gs); await sleep(GLITCH_DURATION); el.removeChild(gs);
        }
        el.appendChild(span);
        requestAnimationFrame(() => { span.style.transition = 'color 0.25s ease-out'; span.style.color = '#fff'; });
        await sleep(CHAR_DELAY);
      }
      if (isLast) { const c = document.createElement('span'); c.className = 'nier-char'; c.style.color = '#fff'; c.textContent = '_'; el.appendChild(c); await sleep(300); c.style.opacity = '0'; await sleep(200); c.style.opacity = '1'; await sleep(300); }
      await sleep(80);
    }

    async function run() {
      for (let i = 0; i < lines.length; i++) await typeLine(lines[i], i === lines.length - 1);
      clearInterval(dotTimer); if (dotsEl) dotsEl.textContent = '';
      await sleep(500);
      const overlay = document.getElementById('nier-loading');
      if (overlay) { overlay.style.transition = 'opacity 0.6s ease-out'; overlay.style.opacity = '0'; setTimeout(() => overlay.remove(), 600); }
    }
    run();
  }
</script>

<style is:global>
  #nier-loading { font-family: 'Courier New', 'Source Code Pro', 'Consolas', 'Noto Sans SC', monospace; letter-spacing: 0.05em; }
</style>
