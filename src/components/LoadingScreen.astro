---
// LoadingScreen.astro — 页面加载动画（NieR 风格 / P3RE 风格 / 无动画）
// NieR 徽章源码: ascii-art.txt
// P3RE 素材: public/assset/, public/img/waves/, public/img/P3RE.svg
const base = import.meta.env.BASE_URL;
---

<!-- ===== NieR 风格（首屏模式） ===== -->
<!-- #nier-loading 占 100vh 文档流、永驻页面顶部（刷新不销毁，向上滚可看回加载动画）；
     #nier-stage sticky 钉在视口顶部，滚动时实时 rotateX 翻转（可逆：向下滚翻走、向上滚翻回） -->
<div id="nier-loading" class="relative z-[60]" style="height:100vh;">
  <div id="nier-stage" class="sticky top-0 overflow-hidden" style="height:100vh; background: #1C1814; background-image: linear-gradient(rgba(0,0,0,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.15) 1px, transparent 1px); background-size: 5px 5px; transform-origin: 50% 50%; will-change: transform;">
    <canvas id="nier-grid-art" class="absolute inset-0 w-full h-full z-[5] pointer-events-none"></canvas>

    <div class="absolute top-8 left-8 sm:top-12 sm:left-12 z-10">
      <p class="text-white tracking-[0.15em]">
        <span class="text-3xl sm:text-4xl">LOADING</span><span class="text-lg sm:text-xl">_系统启动中</span><span id="nier-dots" class="text-lg sm:text-xl"></span>
      </p>
    </div>

    <div id="nier-lines" class="absolute top-[22%] left-[3%] sm:top-[28%] sm:left-[3%] space-y-2 text-sm sm:text-base z-10"></div>
  </div>
</div>

<!-- ===== 全局滚动指示器：fixed 右下角（right:10% bottom:10%），随整页滚动进度移动 ===== -->
<!-- 两种样式：ruler 横条刻度尺（默认）/ clock 圆形表盘+时针；由 localStorage['scroll-indicator-style'] 切换 -->
<div id="nier-scroll-hint" class="fixed z-[70] flex flex-col items-center" style="right:10%; bottom:10%; opacity:0; transition: opacity .5s ease; pointer-events:none; background: transparent; padding: 8px 14px 6px;">
  <!-- 样式一：横向刻度尺（ruler） -->
  <div id="nier-indicator-ruler" class="flex flex-col items-center">
    <div id="nier-hint-label" class="text-xs tracking-[0.25em] mb-2" style="opacity:.9; color:#22D3EE;">向下滚动</div>
    <div id="nier-ruler" class="relative" style="width:240px; height:22px; background-image: repeating-linear-gradient(90deg, rgba(34,211,238,.4) 0 1.5px, transparent 1.5px 16px), repeating-linear-gradient(90deg, rgba(34,211,238,.22) 0 1px, transparent 1px 4px); background-size: 100% 13px, 100% 7px; background-position: 0 1px, 0 6px; background-repeat: no-repeat;">
      <div class="absolute left-0 right-0" style="top:15px; height:2px; background: rgba(34,211,238,.35);"></div>
      <!-- 已滚动区域高亮填充层（宽度随进度更新） -->
      <div id="nier-ruler-fill" class="absolute left-0" style="top:0; bottom:0; width:0%; background-image: repeating-linear-gradient(90deg, #22D3EE 0 1.5px, transparent 1.5px 16px), repeating-linear-gradient(90deg, rgba(34,211,238,.9) 0 1px, transparent 1px 4px); background-size: 100% 13px, 100% 7px; background-position: 0 1px, 0 6px; background-repeat: no-repeat; -webkit-mask-image: linear-gradient(90deg, #000 0%, rgba(0,0,0,.92) 100%); mask-image: linear-gradient(90deg, #000 0%, rgba(0,0,0,.92) 100%);"></div>
      <div id="nier-ruler-knob" class="absolute" style="top:-5.5px; left:0; width:2px; height:19.5px; transform:translateX(-50%); background:#7FF3FF; box-shadow:0 0 8px rgba(34,211,238,.9), 0 0 2px rgba(255,255,255,.8);"></div>
    </div>
    <div class="text-[10px] tracking-[0.15em] mt-1.5" style="color:rgba(34,211,238,.55);">SCROLL</div>
  </div>

  <!-- 样式二：圆形表盘 + 时针（clock），刻度/时针由 JS 动态生成 -->
  <div id="nier-indicator-clock" class="flex flex-col items-center" style="display:none;">
    <div class="text-xs tracking-[0.25em] mb-2" style="opacity:.9; color:#22D3EE;">向下滚动</div>
    <div id="nier-clock" class="relative" style="width:72px; height:72px;">
      <svg id="nier-clock-svg" width="72" height="72" viewBox="0 0 72 72"></svg>
      <div id="nier-clock-center" class="absolute rounded-full" style="top:50%; left:50%; width:6px; height:6px; transform:translate(-50%,-50%); background:#7FF3FF; box-shadow:0 0 8px rgba(34,211,238,.9);"></div>
    </div>
    <div class="text-[10px] tracking-[0.15em] mt-1.5" style="color:rgba(34,211,238,.55);">SCROLL</div>
  </div>
</div>

<!-- ===== P3RE 风格 ===== -->
<div id="p3re-loading" class="fixed inset-0 z-[9999] overflow-hidden" style="display:none" data-base={import.meta.env.BASE_URL}>
  <!-- 海浪幕布 -->
  <div id="p3re-startwaves" class="fixed flex justify-center w-full" style="height:120vh;background-color:#469ce5;transform:translateY(-10vh);z-index:999;">
    <div id="p3re-waves" class="block absolute w-full" style="bottom:120vh;">
      <img src={`${base}/img/waves/wave-1.svg`} alt="" />
      <img src={`${base}/img/waves/wave-2.svg`} alt="" />
      <img src={`${base}/img/waves/wave-3.svg`} alt="" />
      <img src={`${base}/img/waves/wave-4.svg`} alt="" />
      <img src={`${base}/img/waves/wave-5.svg`} id="p3re-shape" alt="" />
    </div>
  </div>

  <!-- 视频背景 -->
  <div id="p3re-videobg" style="width:100%;height:100%;">
    <video id="p3re-video1" muted playsinline class="p3re-video"></video>
    <video id="p3re-video2" muted playsinline loop class="p3re-video"></video>

    <div id="p3re-centertext">
      <h1>Memento Mori</h1>
      <p>Remember, You Will Die.<br/>Time never waits.<br/>It delivers all equally to the same end.</p>
    </div>

    <img id="p3re-logo" src={`${base}/img/P3RE.svg`} alt="" />

    <div id="p3re-enter" style="display:none;position:absolute;bottom:3rem;left:50%;transform:translateX(-50%);color:#fff;font-size:0.875rem;opacity:0.6;cursor:pointer;letter-spacing:0.1em;transition:opacity 0.3s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
      点击任意位置进入
    </div>
  </div>
</div>

<script>
  var B = document.getElementById('p3re-loading').dataset.base;

  var anim = localStorage.getItem('loading-animation') || 'nier';
  var nierWrap = document.getElementById('nier-loading');
  var nierEl = document.getElementById('nier-stage');
  var p3reEl = document.getElementById('p3re-loading');
  var hintEl = document.getElementById('nier-scroll-hint');

  // 检测页面是否可整页滚动：尝试滚动 10px，看 scrollY 是否变化。
  // notes/game 等 overflow:hidden 固定布局页滚动无效 → 回退旧 fixed 遮罩模式
  // （不依赖 getComputedStyle——dev 下 CSS 由 Vite 异步注入，检测样式有时序竞态）
  var testY = window.scrollY;
  window.scrollBy(0, 10);
  var canScroll = window.scrollY !== testY;
  window.scrollTo(0, testY);
  var fixedMode = !canScroll;
  if (fixedMode) {
    nierWrap?.classList.add('nier-fixed');
    hintEl?.remove();
  }

  if (anim === 'none') {
    nierWrap?.remove();
    p3reEl?.remove();
    hintEl?.remove();
  } else if (anim === 'p3re') {
    nierWrap?.remove();
    hintEl?.remove();
    p3reEl.style.display = '';
    runP3RE();
  } else {
    // nier
    p3reEl?.remove();
    if (fixedMode && sessionStorage.getItem('nier-intro-done')) {
      // 不可滚动页刷新/回访：直接移除，不占文档流、不阻塞固定布局
      nierWrap?.remove();
    } else if (!sessionStorage.getItem('nier-intro-done')) {
      sessionStorage.setItem('nier-intro-done', '1');
      runNier(false); // 首次进入：播放打字动画
    } else {
      runNier(true);  // 可滚动页刷新/回访：跳过动画直接完成态（首屏不销毁，向上滚可见）
    }
  }

  /* ============ P3RE ============ */
  function runP3RE() {
    var baseAsset = B + '/assset/';
    var v1 = document.getElementById('p3re-video1');
    var v2 = document.getElementById('p3re-video2');
    var waves = document.getElementById('p3re-startwaves');

    // 海浪幕布下滑
    waves.style.animation = 'p3re-down 3s ease-out 1s forwards';

    // 用 setTimeout 作主触发器（比 animationend 更可靠）
    var WAVE_TOTAL = 3600; // 1s delay + 3s duration - 500ms提前
    var revealed = false;

    function revealVideo() {
      if (revealed) return;
      revealed = true;
      waves.style.display = 'none';

      // 设置视频 src 并在 load 后播放
      v1.src = baseAsset + 'fv_movie1.mp4';
      v1.load();
      var play1 = v1.play();
      if (play1) play1.catch(function(){});

      v1.addEventListener('ended', function() {
        v1.style.display = 'none';
        v2.src = baseAsset + 'fv_movie2.mp4';
        v2.load();
        var play2 = v2.play();
        if (play2) play2.catch(function(){});

        setTimeout(function() {
          var enter = document.getElementById('p3re-enter');
          if (enter) enter.style.display = 'block';
        }, 2000);
      });
    }

    setTimeout(revealVideo, WAVE_TOTAL);
    // animationend 作为兜底，提前触发也不浪费
    waves.addEventListener('animationend', revealVideo);

    // 点击任意位置关闭
    p3reEl.addEventListener('click', function() {
      p3reEl.style.transition = 'opacity 0.6s ease-out';
      p3reEl.style.opacity = '0';
      sessionStorage.setItem('nier-intro-done', '1');
      setTimeout(function() { p3reEl.remove(); }, 600);
    });
  }

  /* ============ NieR ============ */
  // quick=true：跳过打字动画，直接渲染完成态（刷新/回访场景）
  function runNier(quick) {
    var hintLabel = document.getElementById('nier-hint-label');
    var rulerKnob = document.getElementById('nier-ruler-knob');
    var rulerFill = document.getElementById('nier-ruler-fill');
    var indRuler = document.getElementById('nier-indicator-ruler');
    var indClock = document.getElementById('nier-indicator-clock');
    var clockSvg = document.getElementById('nier-clock-svg');
    var clockHand = null;
    var clockTicks = [];

    // 指示器样式：ruler（横条刻度尺，默认）/ clock（圆形表盘+时针）
    var indicatorStyle = localStorage.getItem('scroll-indicator-style') || 'ruler';
    if (indicatorStyle !== 'ruler' && indicatorStyle !== 'clock') indicatorStyle = 'ruler';

    function applyIndicatorStyle() {
      if (!indRuler || !indClock) return;
      if (indicatorStyle === 'clock') {
        indRuler.style.display = 'none';
        indClock.style.display = '';
      } else {
        indRuler.style.display = '';
        indClock.style.display = 'none';
      }
    }

    // 生成圆形表盘：60 条刻度线（12 主 + 48 次）+ 时针（指向 12 点起始）
    function buildClock() {
      if (!clockSvg) return;
      var NS = 'http://www.w3.org/2000/svg';
      var cx = 36, cy = 36, R = 30; // 圆心 + 刻度半径
      clockSvg.innerHTML = '';
      clockTicks = [];
      for (var i = 0; i < 60; i++) {
        var a = (i * 6 - 90) * Math.PI / 180; // 从 12 点方向开始
        var isMajor = (i % 5 === 0);
        var r1 = isMajor ? R - 9 : R - 5;     // 主刻度长（向圆心延伸更多）
        var x1 = cx + r1 * Math.cos(a), y1 = cy + r1 * Math.sin(a);
        var x2 = cx + R * Math.cos(a), y2 = cy + R * Math.sin(a);
        var line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', x1); line.setAttribute('y1', y1);
        line.setAttribute('x2', x2); line.setAttribute('y2', y2);
        line.setAttribute('stroke', isMajor ? 'rgba(34,211,238,.75)' : 'rgba(34,211,238,.3)');
        line.setAttribute('stroke-width', isMajor ? '1.6' : '1');
        line.setAttribute('stroke-linecap', 'round');
        clockSvg.appendChild(line);
        clockTicks.push(line);
      }
      // 底环
      var ring = document.createElementNS(NS, 'circle');
      ring.setAttribute('cx', cx); ring.setAttribute('cy', cy); ring.setAttribute('r', R);
      ring.setAttribute('fill', 'none');
      ring.setAttribute('stroke', 'rgba(34,211,238,.25)');
      ring.setAttribute('stroke-width', '1.5');
      clockSvg.appendChild(ring);
      // 时针：从圆心指向 12 点，rotate 由滚动驱动
      clockHand = document.createElementNS(NS, 'line');
      clockHand.setAttribute('x1', cx); clockHand.setAttribute('y1', cy);
      clockHand.setAttribute('x2', cx); clockHand.setAttribute('y2', cy - 20);
      clockHand.setAttribute('stroke', '#7FF3FF');
      clockHand.setAttribute('stroke-width', '2.5');
      clockHand.setAttribute('stroke-linecap', 'round');
      clockHand.style.transformOrigin = cx + 'px ' + cy + 'px';
      clockHand.style.transition = 'transform .08s linear';
      clockSvg.appendChild(clockHand);
      applyIndicatorStyle();
    }

    // 滚动驱动（可逆）：首屏翻转 + 指示器整页进度
    function onScrollFlip() {
      var vh = window.innerHeight;
      // 首屏翻转：前 100vh 内完成 0 → -90°
      var flip = Math.min(window.scrollY / vh, 1);
      nierEl.style.transform = 'rotateX(' + (-90 * flip) + 'deg)';
      // 指示器：整个文档滚动进度 0 → 100%
      var doc = document.documentElement;
      var maxScroll = doc.scrollHeight - vh;
      var page = maxScroll > 0 ? Math.min(window.scrollY / maxScroll, 1) : 0;
      if (indicatorStyle === 'clock' && clockHand) {
        // 时针旋转 0 → 360°（从 12 点起），扫过的刻度高亮
        clockHand.style.transform = 'rotate(' + (page * 360) + 'deg)';
        var passed = Math.round(page * 60);
        for (var i = 0; i < 60; i++) {
          var isMajorT = (i % 5 === 0);
          clockTicks[i].setAttribute('stroke', i <= passed
            ? (isMajorT ? '#22D3EE' : 'rgba(34,211,238,.8)')
            : (isMajorT ? 'rgba(34,211,238,.75)' : 'rgba(34,211,238,.3)'));
        }
      } else {
        rulerKnob.style.left = (page * 100) + '%';
        if (rulerFill) rulerFill.style.width = (page * 100) + '%';
      }
      // 提示文字随首屏翻走淡出
      hintLabel.style.opacity = String(Math.max(0, 1 - flip * 3));
    }

    function showEnterHint() {
      buildClock(); // 生成圆形表盘（ruler 样式时仅应用显隐）
      hintEl.style.opacity = '1';
      window.addEventListener('scroll', onScrollFlip, { passive: true });
      onScrollFlip();
    }

    // 点击首屏任意位置：首屏模式 = 平滑滚到进入点；fixed 模式 = 淡出移除（旧行为）
    nierEl.addEventListener('click', function() {
      if (fixedMode) {
        dismissNier();
      } else {
        window.scrollTo({ top: window.innerHeight, behavior: 'smooth' });
      }
    });

    // fixed 模式（notes/game 等不可滚动页）：淡出移除
    function dismissNier() {
      if (!nierEl) return;
      nierEl.style.transition = 'opacity 0.6s ease-out';
      nierEl.style.opacity = '0';
      setTimeout(function() { nierWrap?.remove(); }, 600);
    }

    import('../../ascii-art.txt?raw').then(function(m) {
      var ASCII_EMBLEM = m.default.split('\n').filter(function(r) { return r.length > 0; });

      var GLITCH_CHARS = '!@#$%^&*<>?|/\\{}[]\u00b1\u00a7\u203b\u2606\u2605\u25cb\u25cf\u25c7\u25c6\u25a1\u25a0\u25b3\u25b2\u25bd\u25bc\u2192\u2190\u2191\u2193\u2194\u2195\u2660\u2663\u2665\u2666\u2642\u2640\u221e\u2248\u2260\u2264\u2265';
      function randomGlitch() { return GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)]; }
      function sleep(ms) { return new Promise(function(r) { setTimeout(r, ms); }); }

      var lines = [
        '连接服务器 - 完成','页面资源 - 完毕','渲染引擎 - 初始化',
        '全局样式表 - 已解析','字体文件 - 已加载','脚本模块 - 已编译',
        'WebSocket连接 - 已建立','路由表 - 初始化','资源完整性 - 已验证','页面准备就绪',
      ];

      var CELL = 1.5, GAP = 0, STEP = CELL + GAP;
      var DOT = 2, OFF = (CELL - DOT) / 2;
      var STRETCH_Y = 2.75, STRETCH_X = 1.5;
      var DENSITY_MAP = {
        ' ': 0, '@': 0.50, '#': 0.44, '%': 0.38, '*': 0.32, '=': 0.26,
        '+': 0.20, '-': 0.14, ':': 0.08, '.': 0.04,
      };

      function drawGridArt() {
        var canvas = document.getElementById('nier-grid-art');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;

        function drawDots(arr, ox, oy) {
          for (var r = 0; r < arr.length; r++) {
            var row = arr[r];
            for (var c = 0; c < row.length; c++) {
              var a = DENSITY_MAP[row[c]] || 0;
              if (a > 0) {
                ctx.fillStyle = 'rgba(200,200,210,' + a + ')';
                ctx.fillRect(ox + c * STEP * STRETCH_X + OFF, oy + r * STEP * STRETCH_Y + OFF, DOT * STRETCH_X, DOT * STRETCH_Y);
              }
            }
          }
        }

        var ew = ASCII_EMBLEM[0].length * STEP * STRETCH_X;
        var eh = ASCII_EMBLEM.length * STEP * STRETCH_Y;
        var ox = (canvas.width - ew) / 2;
        var oy = (canvas.height - eh) / 2;

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drawDots(ASCII_EMBLEM, ox, oy);
      }

      drawGridArt();
      window.addEventListener('resize', drawGridArt);

      var container = document.getElementById('nier-lines');
      var CHAR_DELAY = 22, GLITCH_DURATION = 28;
      var glitchChance = Math.random() * 0.08;
      var dotsEl = document.getElementById('nier-dots');
      var dotStates = ['_', '.', '..', '...', ''];
      var dotIdx = 0;
      var dotTimer = setInterval(function() { if (dotsEl) dotsEl.textContent = dotStates[dotIdx]; dotIdx = (dotIdx + 1) % dotStates.length; }, 400);

      // 完成态：直接填满全部终端行（无打字动画）
      function fillAllLines() {
        for (var i = 0; i < lines.length; i++) {
          var el = document.createElement('p');
          el.className = 'tracking-wider';
          var span = document.createElement('span');
          span.style.color = '#fff';
          span.textContent = lines[i];
          el.appendChild(span);
          container.appendChild(el);
        }
        clearInterval(dotTimer); if (dotsEl) dotsEl.textContent = '';
      }

      async function typeLine(text, isLast) {
        var el = document.createElement('p');
        el.className = 'tracking-wider';
        container.appendChild(el);
        for (var i = 0; i < text.length; i++) {
          var span = document.createElement('span');
          span.className = 'nier-char'; span.style.color = 'rgba(255,255,255,0.2)'; span.textContent = text[i];
          if (Math.random() < glitchChance) {
            var gs = document.createElement('span'); gs.textContent = randomGlitch(); gs.style.color = 'rgba(255,255,255,0.5)';
            el.appendChild(gs); await sleep(GLITCH_DURATION); el.removeChild(gs);
          }
          el.appendChild(span);
          requestAnimationFrame(function() { span.style.transition = 'color 0.25s ease-out'; span.style.color = '#fff'; });
          await sleep(CHAR_DELAY);
        }
        if (isLast) { var c = document.createElement('span'); c.className = 'nier-char'; c.style.color = '#fff'; c.textContent = '_'; el.appendChild(c); await sleep(300); c.style.opacity = '0'; await sleep(200); c.style.opacity = '1'; await sleep(300); }
        await sleep(80);
      }

      async function run() {
        for (var i = 0; i < lines.length; i++) await typeLine(lines[i], i === lines.length - 1);
        clearInterval(dotTimer); if (dotsEl) dotsEl.textContent = '';
        await sleep(500);
        if (fixedMode) {
          // 不可滚动页：播完淡出移除（旧行为）
          dismissNier();
        } else {
          // 播放完不淡出：停留为首屏，亮出右下角刻度尺
          showEnterHint();
        }
      }

      if (quick) {
        if (fixedMode) {
          // 不可滚动页刷新/回访：直接移除，不占文档流
          nierWrap?.remove();
        } else {
          fillAllLines();
          showEnterHint();
        }
      } else {
        run();
      }
    });
  }
</script>

<style is:global>
  #nier-loading { font-family: 'Courier New', 'Source Code Pro', 'Consolas', 'Noto Sans SC', monospace; letter-spacing: 0.05em; }

  /* 不可滚动页（notes/game 等 overflow:hidden 固定布局）回退 fixed 遮罩模式：
     不占文档流、播完淡出移除，避免 100vh 首屏把固定布局内容推出视口 */
  #nier-loading.nier-fixed {
    position: fixed !important;
    inset: 0 !important;
    z-index: 9999 !important;
    height: 100vh !important;
  }
  #nier-loading.nier-fixed #nier-stage {
    position: absolute !important;
    top: 0 !important;
    height: 100vh !important;
  }

  /* P3RE 海浪动画 */
  @keyframes p3re-down {
    0%   { transform: translateY(-10vh); }
    100% { transform: translateY(110vh); }
  }
  /* P3RE 淡出 */
  @keyframes p3re-out {
    100% { opacity: 0; display: none; }
  }
  @keyframes p3re-in {
    100% { opacity: 1; }
  }

  #p3re-shape {
    position: absolute; left: 0; bottom: -1vw;
  }
  #p3re-waves img:not(#p3re-shape) {
    position: absolute; left: 0;
  }
