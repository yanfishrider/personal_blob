---
// LabLoading.astro — 首页加载动画：动画实验室 8 段圆弧自动轮播（NieR 首屏模式）
// 复用 animation-lab 的 8 段动画核心，改为时间驱动自动切换；滚动 rotateX 翻转进入首页
const base = import.meta.env.BASE_URL;
---

<!-- ===== 首屏模式：sticky 8 屏（8 段滚轮驱动，照搬 animation-lab 原效果）；默认隐藏，由 LoadingScreen 按 loading-animation 配置调度 ===== -->
<div id="ll-loading" class="relative z-[60]" style="display:none; height:800vh;">
  <div id="ll-stage" class="sticky top-0 overflow-hidden" style="height:100vh; background:#1C1814; background-image:linear-gradient(rgba(0,0,0,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.15) 1px, transparent 1px); background-size:5px 5px; will-change:transform;">
    <!-- 中央动画容器（750×750 viewBox 等比缩放，同原页面 lab-circle 尺寸） -->
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="relative" style="width:min(750px, 92vw, 92vh); aspect-ratio:1/1;">
        <svg id="ll-dots" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-arc" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-rings" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-tick" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-shapes" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-ellipse" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-track" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-burst" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-engine" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-slots" class="ll-layer" viewBox="0 0 750 750"></svg>
        <svg id="ll-fengshui" class="ll-layer" viewBox="0 0 750 750"></svg>
        <div id="ll-square" class="ll-layer"></div>
      </div>
    </div>
    <!-- 引擎 RPM 计数器（第六段显示，随指针转速跳动） -->
    <div id="ll-counter" class="absolute left-1/2 -translate-x-1/2" style="bottom:5%; z-index:6; font-family:'Courier New','Consolas',monospace; font-size:34px; font-weight:bold; letter-spacing:0.18em; color:#6A9622; filter:brightness(1.42); text-shadow:0 0 10px rgba(106,150,34,.8),0 0 26px rgba(106,150,34,.4); opacity:0; transition:opacity .35s ease; text-align:center;">
      <span id="ll-counter-val">0000</span><span style="display:block; font-size:12px; letter-spacing:0.25em; color:rgba(106,150,34,.7);">RPM</span>
    </div>

    <!-- 顶部 LOADING 文字 -->
    <div class="absolute top-8 left-8 sm:top-12 sm:left-12" style="font-family:'Courier New','Consolas',monospace;">
      <p class="text-white tracking-[0.15em]">
        <span class="text-3xl sm:text-4xl">LAB</span><span class="text-lg sm:text-xl">_实验室加载中</span><span id="ll-dots-anim" class="text-lg sm:text-xl"></span>
      </p>
    </div>
    <!-- 跳过按钮：直接跳到首页内容（跳过 8 段动画） -->
    <button id="ll-skip" class="absolute top-8 right-8 sm:top-12 sm:right-12 px-4 py-2 rounded-full text-xs tracking-[0.25em] transition-all duration-300" style="z-index:10; color:rgba(255,255,255,.9); border:1px solid rgba(255,255,255,.35); background:rgba(255,255,255,.08); cursor:pointer; font-family:'Courier New','Consolas',monospace;" onmouseover="this.style.background='rgba(255,255,255,.18)';this.style.borderColor='rgba(34,211,238,.8)';this.style.color='#7FF3FF'" onmouseout="this.style.background='rgba(255,255,255,.08)';this.style.borderColor='rgba(255,255,255,.35)';this.style.color='rgba(255,255,255,.9)'">跳过 加载动画 »</button>
    <!-- 当前段名 -->
    <div id="ll-label" class="absolute bottom-10 left-1/2 -translate-x-1/2 text-sm tracking-[0.3em]" style="color:rgba(255,255,255,.75); font-family:'Courier New','Consolas',monospace;">SEGMENT 01</div>
    <!-- 滚动提示 -->
    <div id="ll-hint" class="absolute bottom-8 right-8 text-xs tracking-[0.25em] transition-opacity duration-500" style="color:rgba(34,211,238,.85); opacity:0; font-family:'Courier New','Consolas',monospace; pointer-events:none;">向下滚动 ↓</div>
  </div>
</div>

<script>
  // ============ 配置（同 animation-lab） ============
  var ARC = {
    cx: 375, cy: 375, r: 357.5, width: 5, segments: 8, gapDeg: 1,
    colors: ['#16899B', '#539EA6', '#228963', '#6A9622', '#A37C17', '#9F4A76', '#6D5AA3', '#AAAAAA'],
  };
  var TICKS = { r: 333.5, len: 15, count: 180, width: 2, startDeg: -90 };
  var RINGS = { radii: [310, 305, 290, 295, 275, 270], width: 2, jitter: 0.8, step: 2 };
  var DOTS = { gap: 30, radius: 270, dotR: 2.5, minOpacity: 0.06 };
  var LL_NAMES = ['中心色块旋转', '12图形随机游走', '3D球体错觉', '闭合赛道绕行', '中心绽开特效', '引擎仪表盘', '老虎机排队绕行', '风水转盘解谜'];

  (function () {
    var NS = 'http://www.w3.org/2000/svg';
    var a = ARC;
    var wrap = document.getElementById('ll-loading');
    var stage = document.getElementById('ll-stage');
    if (!wrap || !stage) return;
    // 调度：仅当配置为实验室风格（或未配置且当前为首页）时初始化并显示
    function isHomePage() {
      var p = window.location.pathname;
      var b = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
      return p === b || p === b + '/' || p === '/';
    }
    var storedAnim = localStorage.getItem('loading-animation');
    var wantLab = (storedAnim === 'lab') || (storedAnim === null && isHomePage());
    if (!wantLab) return;
    wrap.style.display = '';

    function darken(hex, factor) {
      var r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
      r = Math.round(r * factor); g = Math.round(g * factor); b = Math.round(b * factor);
      return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }

    // ============ 背景：点阵 + 圆弧 + 手抖环 + 刻度线 ============
    var svgDots = document.getElementById('ll-dots');
    var dotEls = [];
    if (svgDots) {
      for (var gx = -DOTS.radius; gx <= DOTS.radius; gx += DOTS.gap) {
        for (var gy = -DOTS.radius; gy <= DOTS.radius; gy += DOTS.gap) {
          var dd = Math.sqrt(gx * gx + gy * gy);
          if (dd > DOTS.radius) continue;
          var op = 1 - dd / DOTS.radius;
          if (op < DOTS.minOpacity) continue;
          var dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', a.cx + gx); dot.setAttribute('cy', a.cy + gy);
          dot.setAttribute('r', DOTS.dotR); dot.setAttribute('fill', a.colors[0]);
          dot.setAttribute('opacity', op.toFixed(2));
          svgDots.appendChild(dot);
          dotEls.push(dot);
        }
      }
    }
    var arcSvg = document.getElementById('ll-arc');
    var arcBases = [], arcTops = [];
    var arcC = 0, arcSeg = 0, arcStepDeg = 0;
    if (arcSvg) {
      arcC = 2 * Math.PI * a.r;
      var arcGap = arcC * a.gapDeg / 360;
      arcSeg = arcC / a.segments - arcGap;
      arcStepDeg = 360 / a.segments;
      for (var si = 0; si < a.segments; si++) {
        var rot = 'rotate(' + (si * arcStepDeg - 90) + ' ' + a.cx + ' ' + a.cy + ')';
        // 底层：整段（初始暗版弧色，细）
        var base = document.createElementNS(NS, 'circle');
        base.setAttribute('cx', a.cx); base.setAttribute('cy', a.cy); base.setAttribute('r', a.r);
        base.setAttribute('fill', 'none');
        base.setAttribute('stroke', darken(a.colors[si % a.colors.length], 0.35));
        base.setAttribute('stroke-width', 5);
        base.setAttribute('stroke-dasharray', arcSeg + ' ' + arcC);
        base.setAttribute('transform', rot);
        base.style.transition = 'stroke-width .4s ease';
        arcSvg.appendChild(base);
        arcBases.push(base);
        // 顶层：高亮进度条（初始隐藏）
        var top = document.createElementNS(NS, 'circle');
        top.setAttribute('cx', a.cx); top.setAttribute('cy', a.cy); top.setAttribute('r', a.r);
        top.setAttribute('fill', 'none');
        top.setAttribute('stroke', a.colors[si % a.colors.length]);
        top.setAttribute('stroke-width', 10);
        top.setAttribute('stroke-dasharray', '0 ' + arcC);
        top.setAttribute('transform', rot);
        top.style.filter = 'brightness(1.5) drop-shadow(0 0 6px ' + a.colors[si % a.colors.length] + ')';
        arcSvg.appendChild(top);
        arcTops.push(top);
      }
    }
    var ringsSvg = document.getElementById('ll-rings');
    if (ringsSvg) {
      for (var ri = 0; ri < RINGS.radii.length; ri++) {
        var pts = '';
        for (var ai = 0; ai < 360; ai += RINGS.step) {
          var jx = (Math.random() - 0.5) * RINGS.jitter, jy = (Math.random() - 0.5) * RINGS.jitter;
          var rx = a.cx + (RINGS.radii[ri] + jx) * Math.cos(ai * Math.PI / 180);
          var ry = a.cy + (RINGS.radii[ri] + jy) * Math.sin(ai * Math.PI / 180);
          pts += rx.toFixed(1) + ',' + ry.toFixed(1) + ' ';
        }
        var rp = document.createElementNS(NS, 'polyline');
        rp.setAttribute('points', pts);
        rp.setAttribute('fill', 'none');
        rp.setAttribute('stroke', '#000000');
        rp.setAttribute('stroke-width', RINGS.width);
        ringsSvg.appendChild(rp);
      }
    }
    var tickSvg = document.getElementById('ll-tick');
    var tickLines = [];
    if (tickSvg) {
      // 刻度线：短刻度几何 20px、30° 长刻度几何 40px；显示长度用 stroke-dashoffset 控制
      var long30 = {};
      for (var l30 = 0; l30 < 12; l30++) long30[Math.round(15 * l30)] = true;   // 每 30° 一条（step 2° → 索引间隔 15）
      for (var ti = 0; ti < TICKS.count; ti++) {
        var ang = (TICKS.startDeg + ti * 360 / TICKS.count) * Math.PI / 180;
        var isLong30 = !!long30[ti];
        var geoLen = (isLong30 ? 30 : 20) + 10;   // 几何长度 = 基础显示 + 隆起余量（短 30 / 长 40）
        var line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', a.cx + TICKS.r * Math.cos(ang));
        line.setAttribute('y1', a.cy + TICKS.r * Math.sin(ang));
        line.setAttribute('x2', a.cx + (TICKS.r - geoLen) * Math.cos(ang));
        line.setAttribute('y2', a.cy + (TICKS.r - geoLen) * Math.sin(ang));
        line.setAttribute('stroke', a.colors[0]);
        line.setAttribute('stroke-width', TICKS.width);
        line.setAttribute('stroke-linecap', 'round');
        line.setAttribute('stroke-dasharray', geoLen + ' ' + geoLen);
        line.setAttribute('stroke-dashoffset', String(geoLen - 15));   // 初始显示 15px
        tickSvg.appendChild(line);
        tickLines.push({ el: line, ang: ang, isLong30: isLong30 });
      }
    }
    var layers = ['ll-dots', 'll-arc', 'll-rings', 'll-tick', 'll-shapes', 'll-ellipse', 'll-track', 'll-burst', 'll-engine', 'll-slots', 'll-fengshui', 'll-square'];

    // ============ 第一段：中心色块旋转（anime.js） ============
    var squareEl = document.getElementById('ll-square');
    if (squareEl) {
      squareEl.style.background = a.colors[0];
      squareEl.style.filter = 'brightness(1.42)';
    }

    // ============ 第二段：12 图形随机游走（anime.js） ============
    var shapesSvg = document.getElementById('ll-shapes');
    var shapesEls = [];
    if (shapesSvg) {
      var shapeG = document.createElementNS(NS, 'g');
      shapeG.setAttribute('transform', 'translate(375 375)');
      shapesSvg.appendChild(shapeG);
      var SHAPES = ['circle', 'triangle', 'rect', 'diamond', 'star', 'crossarc'];
      function buildShape(type) {
        var el;
        if (type === 'circle') { el = document.createElementNS(NS, 'circle'); el.setAttribute('r', 20); }
        else if (type === 'triangle') { el = document.createElementNS(NS, 'polygon'); el.setAttribute('points', '0,-20 17.3,10 -17.3,10'); }
        else if (type === 'rect') { el = document.createElementNS(NS, 'rect'); el.setAttribute('x', -18); el.setAttribute('y', -18); el.setAttribute('width', 36); el.setAttribute('height', 36); el.setAttribute('rx', 6); }
        else if (type === 'diamond') { el = document.createElementNS(NS, 'polygon'); el.setAttribute('points', '0,-22 12,0 0,22 -12,0'); }
        else if (type === 'star') { el = document.createElementNS(NS, 'polygon'); el.setAttribute('points', '0,-22 5.8,-7 22,-7 9,2 13.6,18 0,10 -13.6,18 -9,2 -22,-7 -5.8,-7'); }
        else { el = document.createElementNS(NS, 'path'); el.setAttribute('d', 'M 0 -18 A 18 18 0 1 1 -0.1 -18'); }
        return el;
      }
      for (var shi = 0; shi < SHAPES.length; shi++) {
        for (var svi = 0; svi < 2; svi++) {
          var se = buildShape(SHAPES[shi]);
          var col = a.colors[1 % a.colors.length];
          if (svi === 0) { se.setAttribute('fill', col); }
          else { se.setAttribute('fill', 'none'); se.setAttribute('stroke', col); se.setAttribute('stroke-width', 2); }
          shapeG.appendChild(se);
          shapesEls.push(se);
        }
      }
    }

    // ============ 第三段：20 椭圆 3D 球（时间驱动自动画-保持-擦除） ============
    var ellipseSvg = document.getElementById('ll-ellipse');
    var ELLIPSES = [], ellipseItems = [];
    var ELL_N = 20, ELL_MID = (ELL_N - 1) / 2;
    for (var ei0 = 0; ei0 < ELL_N; ei0++) {
      var et = (ei0 - ELL_MID) / ELL_MID;
      var erx = 57.5 + 201.25 * (1 - et * et);
      var eshift = 48 * (ei0 - ELL_MID) / ELL_MID;
      ELLIPSES.push({
        cx: 375 + (ei0 - ELL_MID) * 12 + eshift, cy: 375 + (ei0 - ELL_MID) * 12 + eshift,
        rx: erx, ry: Math.round(erx * 0.2), rotate: -45,
        color: a.colors[2 % a.colors.length],
        drawRange: { start: ei0 * 0.0125, end: 1 }, drawScale: 2.5
      });
    }
    if (ellipseSvg) {
      for (var ei = 0; ei < ELLIPSES.length; ei++) {
        var ec = ELLIPSES[ei];
        var tp = document.createElementNS(NS, 'path');
        tp.setAttribute('d', 'M ' + (ec.cx - ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx + ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx - ec.rx) + ' ' + ec.cy);
        tp.setAttribute('fill', 'none');
        tp.setAttribute('stroke', ec.color);
        tp.setAttribute('stroke-width', 1.2);
        tp.setAttribute('transform', 'rotate(' + ec.rotate + ' ' + ec.cx + ' ' + ec.cy + ')');
        tp.style.opacity = '0';
        ellipseSvg.appendChild(tp);
        ellipseItems.push({ path: tp, len: 0, drawP: 0, cfg: ec });
        // 圆点标记（每条轨迹端点）
        var dp = document.createElementNS(NS, 'circle');
        dp.setAttribute('cx', ec.cx - ec.rx); dp.setAttribute('cy', ec.cy);
        dp.setAttribute('r', 3); dp.setAttribute('fill', ec.color);
        dp.setAttribute('transform', 'rotate(' + ec.rotate + ' ' + ec.cx + ' ' + ec.cy + ')');
        dp.style.opacity = '0';
        ellipseSvg.appendChild(dp);
        ellipseItems[ellipseItems.length - 1].dot = dp;
        ellipseItems[ellipseItems.length - 1].len = tp.getTotalLength();
      }
      // 呼吸浮动（传递式）：每条椭圆独立浮动，带相位差（第 i 条延迟 i×0.35 rad）→ 波浪传递；仅第三段活跃
      (function breathLoop() {
        if (llIdx === 2) {
          var bt = Date.now() / 1000;
          for (var bi = 0; bi < ellipseItems.length; bi++) {
            var bit = ellipseItems[bi];
            var bec = bit.cfg;
            var bbr = Math.sin(bt * 2 * Math.PI / 3 + bi * 0.35) * 8;
            var bfx = bbr * 0.707, bfy = bbr * 0.707;
            bit.path.setAttribute('transform', 'translate(' + bfx + ' ' + bfy + ') rotate(' + bec.rotate + ' ' + bec.cx + ' ' + bec.cy + ')');
          }
        }
        requestAnimationFrame(breathLoop);
      })();
    }

    // ============ 第四段：闭合赛道（星系）独立 rAF ============
    var trackSvg = document.getElementById('ll-track');
    var trackColor = a.colors[3 % a.colors.length];
    var trackShape = 'solar', trackPath = null, trackDot = null, trackLen = 0;
    var trackProg = 0, trackLast = 0, trackScale = 0.8;
    var PLANET_COLORS = ['#FFD54F', '#7FF3FF', '#FF8A9A'];
    var ORBITS = [
      { rx: 110, ry: 42, period: 4000, r: 7 },
      { rx: 170, ry: 65, period: 6000, r: 9 },
      { rx: 230, ry: 87, period: 8500, r: 11 },
    ];
    var solarPlanets = [];
    function trackShapeD(shape) {
      var cx = a.cx, cy = a.cy, R = 235 * trackScale;
      var pts = [];
      var i, n, ang, x, y, t, r;
      function push(px, py) { pts.push([px, py]); }
      if (shape === 'circle') { n = 72; for (i = 0; i < n; i++) { ang = i / n * 2 * Math.PI; push(cx + R * Math.cos(ang), cy + R * Math.sin(ang)); } }
      else if (shape === 'ellipse') { n = 72; for (i = 0; i < n; i++) { ang = i / n * 2 * Math.PI; push(cx + 288 * trackScale * Math.cos(ang), cy + 158 * trackScale * Math.sin(ang)); } }
      else if (shape === 'diamond') { push(cx, cy - R); push(cx + R, cy); push(cx, cy + R); push(cx - R, cy); }
      else if (shape === 'square') { push(cx - R * 0.78, cy - R * 0.78); push(cx + R * 0.78, cy - R * 0.78); push(cx + R * 0.78, cy + R * 0.78); push(cx - R * 0.78, cy + R * 0.78); }
      else if (shape === 'triangle') { push(cx, cy - R); push(cx + R * 0.866, cy + R * 0.5); push(cx - R * 0.866, cy + R * 0.5); }
      else if (shape === 'star') { for (i = 0; i < 10; i++) { ang = -90 + i * 36; r = (i % 2 === 0) ? R : R * 0.42; push(cx + r * Math.cos(ang * Math.PI / 180), cy + r * Math.sin(ang * Math.PI / 180)); } }
      else if (shape === 'heart') { for (i = 0; i < 96; i++) { t = i / 96 * 2 * Math.PI; x = 16 * Math.pow(Math.sin(t), 3); y = 13 * Math.cos(t) - 5 * Math.cos(2 * t) - 2 * Math.cos(3 * t) - Math.cos(4 * t); push(cx + x * R / 17, cy - y * R / 17); } }
      else { return null; }
      var d = 'M ';
      for (i = 0; i < pts.length; i++) d += pts[i][0].toFixed(1) + ' ' + pts[i][1].toFixed(1) + (i === pts.length - 1 ? ' Z' : ' L ');
      return d;
    }
    function trackBuildSolar() {
      if (!trackSvg) return;
      var ns = NS;
      // 太阳 + 光晕
      var sun = document.createElementNS(ns, 'circle');
      sun.setAttribute('cx', a.cx); sun.setAttribute('cy', a.cy); sun.setAttribute('r', 15);
      sun.setAttribute('fill', trackColor); sun.style.filter = 'brightness(1.3)';
      trackSvg.appendChild(sun);
      var glow = document.createElementNS(ns, 'circle');
      glow.setAttribute('cx', a.cx); glow.setAttribute('cy', a.cy); glow.setAttribute('r', 26);
      glow.setAttribute('fill', 'none'); glow.setAttribute('stroke', trackColor);
      glow.setAttribute('stroke-width', 10); glow.setAttribute('opacity', 0.25);
      trackSvg.appendChild(glow);
      // 轨道（静态）+ 行星组
      for (var oi = 0; oi < ORBITS.length; oi++) {
        var ob = ORBITS[oi];
        var op = document.createElementNS(ns, 'path');
        op.setAttribute('d', 'M ' + (a.cx - ob.rx) + ' ' + a.cy + ' A ' + ob.rx + ' ' + ob.ry + ' 0 1 0 ' + (a.cx + ob.rx) + ' ' + a.cy + ' A ' + ob.rx + ' ' + ob.ry + ' 0 1 0 ' + (a.cx - ob.rx) + ' ' + a.cy);
        op.setAttribute('fill', 'none'); op.setAttribute('stroke', trackColor);
        op.setAttribute('stroke-width', 1.6); op.setAttribute('opacity', 0.4);
        trackSvg.appendChild(op);
        var pg = document.createElementNS(ns, 'g');
        var pl = document.createElementNS(ns, 'circle');
        pl.setAttribute('cx', 0); pl.setAttribute('cy', 0); pl.setAttribute('r', ob.r);
        pl.setAttribute('fill', PLANET_COLORS[oi % PLANET_COLORS.length]);
        pl.style.filter = 'brightness(1.25)';
        pg.appendChild(pl);
        var mk = document.createElementNS(ns, 'circle');
        mk.setAttribute('cx', 0); mk.setAttribute('cy', -ob.r * 0.55);
        mk.setAttribute('r', Math.max(2, ob.r * 0.3)); mk.setAttribute('fill', '#ffffff'); mk.setAttribute('opacity', 0.85);
        pg.appendChild(mk);
        var satOrbit = null, sat = null, satAng = 0;
        if (oi === ORBITS.length - 1) {
          satOrbit = document.createElementNS(ns, 'path');
          satOrbit.setAttribute('d', 'M -24 0 A 24 12 0 1 0 24 0 A 24 12 0 1 0 -24 0');
          satOrbit.setAttribute('fill', 'none'); satOrbit.setAttribute('stroke', trackColor);
          satOrbit.setAttribute('stroke-width', 1); satOrbit.setAttribute('opacity', 0.4);
          pg.appendChild(satOrbit);
          sat = document.createElementNS(ns, 'circle');
          sat.setAttribute('r', 3); sat.setAttribute('fill', PLANET_COLORS[oi % PLANET_COLORS.length]);
          pg.appendChild(sat);
        }
        trackSvg.appendChild(pg);
        solarPlanets.push({ g: pg, angle: oi * 2 * Math.PI / 3, spin: oi * 0.8, sat: sat, satAng: satAng });
      }
    }
    function trackRebuild() {
      if (!trackSvg) return;
      trackSvg.innerHTML = '';
      solarPlanets = [];
      if (trackShape === 'solar') {
        trackBuildSolar();
        trackPath = null; trackDot = null;
      } else {
        var d = trackShapeD(trackShape);
        trackPath = document.createElementNS(NS, 'path');
        trackPath.setAttribute('d', d);
        trackPath.setAttribute('fill', 'none');
