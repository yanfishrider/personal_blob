          // move 第一帧：弹射已在底部槽位的方块（ph >= bottomPh），顶部补入 fresh 方块
          // （提前弹射 → 移动的方块恰好到位，底部方块永不滚出网格底边悬空）
          if (slotsPhaseT <= dt) {
            var ejectIdx = -1;
            for (var bi0 = 0; bi0 < slotBars.length; bi0++) {
              if (slotBars[bi0].ph >= bottomPh) { ejectIdx = bi0; break; }
            }
            if (ejectIdx >= 0) {
              slotEject();
              if (slotBars[ejectIdx].el.parentNode) slotBars[ejectIdx].el.parentNode.removeChild(slotBars[ejectIdx].el);
              slotBars.splice(ejectIdx, 1);
              var freshEl = makeBar(0);
              freshEl.setAttribute('y', slotsBaseY - slotsStep);
              slotBars.push({ el: freshEl, ph: 0, phStart: 0, fresh: true });
            }
          }
          var mp = Math.min(slotsPhaseT / nsg2.moveMs, 1);
          var easeM = mp * mp * (3 - 2 * mp);
          for (var bi = 0; bi < slotBars.length; bi++) {
            if (slotBars[bi].fresh) {
              slotBars[bi].el.setAttribute('y', slotsBaseY - slotsStep + slotsStep * easeM);
            } else {
              slotBars[bi].el.setAttribute('y', slotsBaseY + slotBars[bi].phStart + slotsStep * easeM);
            }
          }
          if (mp >= 1) {
            for (var bi2 = 0; bi2 < slotBars.length; bi2++) {
              if (!slotBars[bi2].fresh) slotBars[bi2].ph = slotBars[bi2].phStart + slotsStep;
              slotBars[bi2].fresh = false;
            }
            slotsPhase = 'pause'; slotsPhaseT = 0;
          }
        } else {
          if (slotsPhaseT >= nsg2.pauseMs) {
            slotsPhase = 'move'; slotsPhaseT = 0;
            for (var bi3 = 0; bi3 < slotBars.length; bi3++) slotBars[bi3].phStart = slotBars[bi3].ph;
          }
        }
        for (var fi = slotFlies.length - 1; fi >= 0; fi--) {
          var f = slotFlies[fi];
          var age = t - f.t0;
          if (f.phase === 'squeeze') {
            var sq = Math.min(age / nsg2.squeezeDur, 1);
            var hh = nsg2.h * (1 - 0.78 * sq);
            f.el.setAttribute('y', f.sy - hh / 2);
            f.el.setAttribute('height', hh);
            if (sq >= 1) { f.phase = 'fly'; f.t0 = t; }
          } else if (f.phase === 'fly') {
            var fp = Math.min(age / nsg2.flyDur, 1);
            var fe = 1 - Math.pow(1 - fp, 2);
            var fx = f.sx + (f.ex - f.sx) * fe;
            var fy = f.sy + (f.ey - f.sy) * fe;
            var hh2 = nsg2.h * (0.22 + 0.78 * fe);
            f.el.setAttribute('x', fx - nsg2.w / 2);
            f.el.setAttribute('y', fy - hh2 / 2);
            f.el.setAttribute('height', hh2);
            if (fp >= 1) {
              f.phase = 'grid'; f.gi = 0; f.gPhase = 'move'; f.posFrac = 0;
              f.gx = f.ex; f.gy = f.ey; f.tLast = t;
              f.el.setAttribute('height', nsg2.h);
            }
          } else if (f.phase === 'grid') {
            if (f.gPhase === 'move') {
              var gp = Math.min((t - f.tLast) / nsg2.moveMs, 1);
              var gpe = gp * gp * (3 - 2 * gp);
              var ga0 = SLOT_PATH[f.gi], ga1 = SLOT_PATH[f.gi + 1];
              var cc0 = slotCellPos(ga0[0], ga0[1]), cc1 = slotCellPos(ga1[0], ga1[1]);
              var gxe = cc0.x + (cc1.x - cc0.x) * gpe;
              var gye = cc0.y + (cc1.y - cc0.y) * gpe;
              f.el.setAttribute('x', gxe - nsg2.w / 2);
              f.el.setAttribute('y', gye - nsg2.h / 2);
              if (gp >= 1) {
                f.gi++;
                if (f.gi >= SLOT_PATH.length - 1) {
                  f.phase = 'vanish'; f.vanishT = t;
                } else {
                  f.gPhase = 'pause'; f.tLast = t;
                }
              }
            } else {
              if (t - f.tLast >= nsg2.pauseMs) { f.gPhase = 'move'; f.tLast = t; }
            }
          } else if (f.phase === 'vanish') {
            var vp = Math.min((t - f.vanishT) / nsg2.vanishDur, 1);
            var center = slotCellPos(2, 2);
            var vw = nsg2.w * (1 - vp), vh = nsg2.h * (1 - vp);
            f.el.setAttribute('x', center.x - vw / 2);
            f.el.setAttribute('y', center.y - vh / 2);
            f.el.setAttribute('width', vw);
            f.el.setAttribute('height', vh);
            f.el.setAttribute('opacity', 1 - vp);
            if (vp >= 1) {
              if (f.el.parentNode) f.el.parentNode.removeChild(f.el);
              slotFlies.splice(fi, 1);
              continue;
            }
          }
        }
      }
      }  // slotsLoop 活跃段结束
      requestAnimationFrame(slotsLoop);
    })(0);

    // ============ 第八段：风水转盘（完整交互：点击转动 + 联动 + 数字提示 + 对齐提亮） ============
    var fengshuiSvg = document.getElementById('ll-fengshui');
    var FS = { n: 8, width: 18, gap: 14, rMin: 25, segGap: 2, spinMs: 420, stepDeg: 45 };
    var fsRings = [];
    function fsShuffle(arr) {
      var c = arr.slice();
      for (var si = c.length - 1; si > 0; si--) {
        var sj = Math.floor(Math.random() * (si + 1));
        var st = c[si]; c[si] = c[sj]; c[sj] = st;
      }
      return c;
    }
    if (fengshuiSvg) {
      var fsg = FS;
      var fsStep = fsg.width + fsg.gap;
      // 联动：1~2 独立环（无出边）；其余各 1 条单向出边，入度 ≤ 1、禁止相互关联、步数 1/2
      var indepN = 1 + Math.floor(Math.random() * 2);
      var indepSet = {};
      var shufAll = fsShuffle([0, 1, 2, 3, 4, 5, 6, 7]);
      for (var idi = 0; idi < indepN; idi++) indepSet[shufAll[idi]] = true;
      var usedTarget = {}, fsLink = {};
      for (var lki = 0; lki < 8; lki++) {
        if (indepSet[lki]) continue;
        var cands = [];
        for (var cdi = 0; cdi < 8; cdi++) {
          if (cdi === lki) continue;
          if (usedTarget[cdi]) continue;
          if (fsLink[cdi] && fsLink[cdi].target === lki) continue;
          cands.push(cdi);
        }
        if (!cands.length) continue;
        var lt2 = cands[Math.floor(Math.random() * cands.length)];
        usedTarget[lt2] = true;
        fsLink[lki] = { target: lt2, steps: (Math.random() < 0.5) ? 1 : 2 };
      }
      for (var fri = 0; fri < fsg.n; fri++) {
        var fr = fsg.rMin + fri * fsStep;
        var farcC = 2 * Math.PI * fr;
        var fsegDeg = (360 - fsg.segGap * 8) / 8;
        var fsegLen = farcC * fsegDeg / 360;
        var fsegStep = fsegDeg + fsg.segGap;
        var fgrp = document.createElementNS(NS, 'g');
        var fring = {
          r: fr, grp: fgrp, arcs: [],
          spin: { cur: 0, target: 0, from: 0, t0: 0, spinning: false },
          link: fsLink[fri] || null, label: null, hit: null, aligned: false
        };
        for (var fsi = 0; fsi < 8; fsi++) {
          var fslot = document.createElementNS(NS, 'circle');
          fslot.setAttribute('cx', a.cx); fslot.setAttribute('cy', a.cy); fslot.setAttribute('r', fr);
          fslot.setAttribute('fill', 'none');
          fslot.setAttribute('stroke', 'rgba(255,255,255,0.08)');
          fslot.setAttribute('stroke-width', fsg.width);
          fslot.setAttribute('stroke-dasharray', fsegLen + ' ' + (farcC - fsegLen));
          fslot.setAttribute('stroke-dashoffset', -farcC * (fsi * fsegStep) / 360);
          fengshuiSvg.appendChild(fslot);
        }
        var fcolors = a.colors.slice();
        var foff = Math.floor(Math.random() * 8);
        var foffDeg = foff * fsg.stepDeg;
        fring.spin.cur = foffDeg; fring.spin.target = foffDeg;
        for (var fsi2 = 0; fsi2 < 8; fsi2++) {
          var fseg = document.createElementNS(NS, 'circle');
          fseg.setAttribute('cx', a.cx); fseg.setAttribute('cy', a.cy); fseg.setAttribute('r', fr);
          fseg.setAttribute('fill', 'none');
          fseg.setAttribute('stroke', fcolors[fsi2]);
          fseg.setAttribute('stroke-width', fsg.width);
          fseg.setAttribute('stroke-dasharray', fsegLen + ' ' + (farcC - fsegLen));
          fseg.setAttribute('stroke-dashoffset', -farcC * (fsi2 * fsegStep) / 360);
          fseg.style.filter = 'brightness(1.25)';
          fgrp.appendChild(fseg);
          fring.arcs.push(fseg);
        }
        fgrp.setAttribute('transform', 'rotate(' + foffDeg + ' ' + a.cx + ' ' + a.cy + ')');
        fengshuiSvg.appendChild(fgrp);
        // 数字提示 label（环带外侧上方，不覆盖弧带——否则白色数字盖住彩色弧看起来像环消失）
        var flb = document.createElementNS(NS, 'text');
        flb.setAttribute('x', a.cx);
        flb.setAttribute('y', a.cy - fr - fsg.width / 2 - 6);
        flb.setAttribute('text-anchor', 'middle');
        flb.setAttribute('font-size', 11);
        flb.setAttribute('font-weight', 700);
        flb.setAttribute('fill', '#FFFFFF');
        flb.setAttribute('opacity', '0');
        flb.style.pointerEvents = 'none';
        flb.style.filter = 'drop-shadow(0 1px 3px rgba(0,0,0,.85))';
        flb.textContent = '+1';
        fengshuiSvg.appendChild(flb);
        fring.label = flb;
        // 命中层：环形 stroke 带（只命中环带，不遮挡内层环）
        var fhit = document.createElementNS(NS, 'circle');
        fhit.setAttribute('cx', a.cx); fhit.setAttribute('cy', a.cy);
        fhit.setAttribute('r', fr);
        fhit.setAttribute('fill', 'none');
        fhit.setAttribute('stroke', 'rgba(255,255,255,0.001)');
        fhit.setAttribute('stroke-width', fsg.width + 3);
        fhit.style.pointerEvents = 'stroke';
        fhit.setAttribute('data-native-cursor', 'true');
        fengshuiSvg.appendChild(fhit);
        fring.hit = fhit;
        fsRings.push(fring);
      }
      // 事件绑定（IIFE 捕获；点击 stopPropagation 防触发 stage 滚屏）
      for (var fei = 0; fei < fsRings.length; fei++) {
        (function (ring) {
          ring.hit.addEventListener('mouseenter', function () { fsShowHint(ring); });
          ring.hit.addEventListener('mouseleave', function () { fsHideHint(); });
          ring.hit.addEventListener('click', function (e) {
            e.stopPropagation();
            fsSpinRing(ring);
          });
        })(fsRings[fei]);
      }
      function fsShowHint(ring) {
        for (var hli = 0; hli < fsRings.length; hli++) fsRings[hli].label.setAttribute('opacity', '0');
        ring.label.setAttribute('opacity', '1');
        ring.label.textContent = '+1';
        if (ring.link) {
          var tgt = fsRings[ring.link.target];
          tgt.label.setAttribute('opacity', '1');
          tgt.label.textContent = '+' + ring.link.steps;
        }
      }
      function fsHideHint() {
        for (var hli2 = 0; hli2 < fsRings.length; hli2++) fsRings[hli2].label.setAttribute('opacity', '0');
      }
      function fsSpinRing(ring) {
        fsAddSpin(ring, 1);
        if (ring.link) fsAddSpin(fsRings[ring.link.target], ring.link.steps);
      }
      function fsAddSpin(ring, steps) {
        var sp = ring.spin;
        sp.from = sp.cur;
        sp.t0 = performance.now();
        sp.target += FS.stepDeg * steps;
        sp.spinning = true;
      }
      // 对齐提亮（初始 offset 0 的环立即亮起）
      for (var cai = 0; cai < fsRings.length; cai++) {
        var car = fsRings[cai];
        if (Math.abs(car.spin.cur % 360) < 0.01) car.aligned = true;
      }
      // 常驻 rAF：转动动画 + 对齐状态更新（点击后状态变化实时反映；仅第八段活跃）
      (function fsLoop(t) {
        if (llIdx === 7) {
        for (var fli = 0; fli < fsRings.length; fli++) {
          var flr = fsRings[fli], flsp = flr.spin;
          if (flsp.spinning) {
            var fp = Math.min((t - flsp.t0) / FS.spinMs, 1);
            var fe = fp * fp * (3 - 2 * fp);
            flsp.cur = flsp.from + (flsp.target - flsp.from) * fe;
            flr.grp.setAttribute('transform', 'rotate(' + flsp.cur + ' ' + a.cx + ' ' + a.cy + ')');
            if (fp >= 1) { flsp.cur = flsp.target; flsp.spinning = false; }
          }
          var cal = !flsp.spinning && (Math.abs(flsp.cur % 360) < 0.01);
          if (cal !== flr.aligned) {
            flr.aligned = cal;
            var f2 = cal ? 'brightness(2)' : 'brightness(1.25)';
            for (var caj = 0; caj < flr.arcs.length; caj++) flr.arcs[caj].style.filter = f2;
          }
        }
        }  // fsLoop 活跃段结束
        requestAnimationFrame(fsLoop);
      })(0);
    }

    // ============ anime.js：色块旋转 + 12 图形游走（CDN 失败静默降级） ============
    import('https://esm.sh/animejs@4.4.1').then(function (mod) {
      if (!mod || !mod.animate) return;
      var animate = mod.animate;
      var utils = mod.utils;
      if (squareEl) animate(squareEl, { rotate: 90, loop: true, duration: 500, ease: 'inOutExpo' });
      var SHAPE_LIMIT = 200;   // 活动半径：留出图形外接半径(22) + scale 1.6 放大余量(≈35)，保证不超内环 270
      function randPoint() {
        var ang = Math.random() * Math.PI * 2;
        var r = Math.sqrt(Math.random()) * SHAPE_LIMIT;
        return { x: Math.cos(ang) * r, y: Math.sin(ang) * r };
      }
      shapesEls.forEach(function (el, i) {
        function loop() {
          var p = randPoint();
          animate(el, {
            x: p.x, y: p.y,
            scale: utils.random(0.4, 1.6),
            duration: utils.random(600, 1400),
            ease: 'out(3)',
          });
          window.setTimeout(loop, utils.random(500, 1100));
        }
        window.setTimeout(loop, utils.random(0, 900));
      });
    }).catch(function () {});

    // ============ 滚轮驱动（照搬 animation-lab：滚动推进 8 段，rAF 平滑逼近） ============
    var llTarget = 0, llCurrent = 0;
    var llIdx = -1;   // 初始 -1：首帧强制 llSetIdx(0)（设置显隐/颜色/刻度长度）
    var llLabel = document.getElementById('ll-label');
    var dotsAnim = document.getElementById('ll-dots-anim');
    var hintEl = document.getElementById('ll-hint');
    var dotStates = ['_', '.', '..', '...', ''];
    var dotIdx = 0;
    setInterval(function () { if (dotsAnim) dotsAnim.textContent = dotStates[dotIdx]; dotIdx = (dotIdx + 1) % dotStates.length; }, 400);
    // 8 段在 7 屏内滚完（最后一段结束时 sticky 恰好到底，进入首页内容）
    var LL_SCROLL = 7 * window.innerHeight;

    // 段切换：背景层始终显示；8 个动画层按 idx 显隐 + 颜色跟随 + 段名
    function llSetIdx(idx) {
      var bgIds = ['ll-dots', 'll-arc', 'll-rings', 'll-tick'];
      for (var bi = 0; bi < bgIds.length; bi++) {
        var be = document.getElementById(bgIds[bi]);
        if (be) be.style.opacity = '1';
      }
      // 第八段隐藏背景点阵（风水转盘区域不需要背景小点）
      if (svgDots) svgDots.style.opacity = (idx === 7) ? '0' : '1';
      var animIds = ['ll-square', 'll-shapes', 'll-ellipse', 'll-track', 'll-burst', 'll-engine', 'll-slots', 'll-fengshui'];
      for (var ai = 0; ai < animIds.length; ai++) {
        var ae = document.getElementById(animIds[ai]);
        if (ae) ae.style.opacity = (ai === idx) ? '1' : '0';
      }
      // 颜色跟随当前弧色（仅段切换时更新，避免每帧 260+ 次 setAttribute 卡顿；引擎段由 engineSpin 管）
      var curCol = a.colors[idx % a.colors.length];
      if (idx !== 5) {
        for (var tki = 0; tki < tickLines.length; tki++) {
          tickLines[tki].el.setAttribute('stroke', curCol);
          // 刻度位置/宽度/线帽复位（离开引擎段时清理外移 + 高亮残留；引擎段由 engineSpin 实时驱动）
          var tk = tickLines[tki];
          var tgeo = (tk.isLong30 ? 40 : 30);
          tk.el.setAttribute('x1', a.cx + TICKS.r * Math.cos(tk.ang));
          tk.el.setAttribute('y1', a.cy + TICKS.r * Math.sin(tk.ang));
          tk.el.setAttribute('x2', a.cx + (TICKS.r - tgeo) * Math.cos(tk.ang));
          tk.el.setAttribute('y2', a.cy + (TICKS.r - tgeo) * Math.sin(tk.ang));
          tk.el.setAttribute('stroke-width', TICKS.width);
          tk.el.setAttribute('stroke-linecap', 'round');
        }
      }
      for (var di = 0; di < dotEls.length; di++) dotEls[di].setAttribute('fill', curCol);
      // 刻度显示长度：第六段满长（offset=余量），其他段 15px（offset = 基础+余量-15）
      for (var tki2 = 0; tki2 < tickLines.length; tki2++) {
        var tlOff = (idx === 5) ? 10 : ((tickLines[tki2].isLong30 ? 30 : 20) + 10 - 15);
        tickLines[tki2].el.setAttribute('stroke-dashoffset', tlOff);
      }
      // RPM 计数器：仅第六段显示
      if (counterEl) counterEl.style.opacity = (idx === 5) ? '1' : '0';
      if (llLabel) llLabel.textContent = 'SEGMENT ' + String(idx + 1).padStart(2, '0') + ' · ' + LL_NAMES[idx];
    }

    // 每帧：current 逼近 target（限速平滑），驱动圆弧/颜色/显隐/引擎/椭圆
    var llLastT = 0;
    function llLoop(t) {
      var dt = llLastT ? Math.min(t - llLastT, 100) : 0;
      llLastT = t;
      // 目标进度 = 滚动位置 / 8 段滚动区间（0~1）
      llTarget = Math.min(window.scrollY / LL_SCROLL, 1);
      // 平滑逼近：每帧限速（一次滚动不瞬间画完大半）
      var diff = llTarget - llCurrent;
      var maxStep = dt / 1000 * 0.6;   // 每秒最多推进 0.6
      llCurrent += (diff > 0) ? Math.min(diff, maxStep) : Math.max(diff, -maxStep);
      llCurrent = Math.min(Math.max(llCurrent, 0), 1);

      var progress = llCurrent;
      var total = a.segments;
      var idx = Math.min(Math.floor(progress * total), total - 1);
      var inSeg = progress * total - idx;
      if (idx !== llIdx) { llIdx = idx; llSetIdx(idx); }

      // 圆弧三态：已过段高亮整段 / 当前段整段加宽 + 顶层进度条按 inSeg 填充 / 未到段暗版
      var BASE_W = 5, GROW_W = 10;
      for (var ai2 = 0; ai2 < total; ai2++) {
        var base = arcBases[ai2], top = arcTops[ai2];
        var col = a.colors[ai2 % a.colors.length];
        if (ai2 < idx) {
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', arcSeg + ' ' + arcC);
          top.setAttribute('stroke-width', BASE_W);
          top.setAttribute('stroke-dasharray', arcSeg + ' ' + arcC);
        } else if (ai2 === idx) {
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', GROW_W);
          base.setAttribute('stroke-dasharray', arcSeg + ' ' + arcC);
          var fillLen = arcSeg * inSeg;
          top.setAttribute('stroke-width', GROW_W);
          top.setAttribute('stroke-dasharray', fillLen + ' ' + (arcC - fillLen));
        } else {
          base.setAttribute('stroke', darken(col, 0.35));
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', arcSeg + ' ' + arcC);
          top.setAttribute('stroke-dasharray', '0 ' + arcC);
        }
      }

      // 第三段 ellipse：段内进度 inSeg 驱动画-保持-擦除（0~2.5）
      if (idx === 2) {
        var eTarget = inSeg * 2.5;
        for (var ei3 = 0; ei3 < ellipseItems.length; ei3++) {
          var item = ellipseItems[ei3];
          var eDiff = eTarget - item.drawP;
          var eMax = 0.05;
          item.drawP += (eDiff > 0) ? Math.min(eDiff, eMax) : Math.max(eDiff, -eMax);
          item.path.setAttribute('stroke-dasharray', item.len + ' ' + item.len);
          item.path.style.opacity = (item.drawP >= 2.5) ? '0' : '1';
          if (item.dot) item.dot.style.opacity = (item.drawP >= 2.5) ? '0' : '1';
          if (item.drawP <= 1) {
            item.path.setAttribute('stroke-dashoffset', item.len * (1 - item.drawP));
          } else if (item.drawP <= 2) {
            item.path.setAttribute('stroke-dashoffset', 0);
          } else {
            var eraseP = (item.drawP - 2) / 0.5;
            item.path.setAttribute('stroke-dashoffset', -item.len * eraseP);
          }
        }
      } else if (llIdx !== 2) {
        // 离开第三段：重置 drawP（回滚后重播）
        for (var ei4 = 0; ei4 < ellipseItems.length; ei4++) ellipseItems[ei4].drawP = 0;
      }
      requestAnimationFrame(llLoop);
    }
    requestAnimationFrame(llLoop);

    // 首屏初始显示滚动提示
    if (hintEl) hintEl.style.opacity = '1';
    // 跳过按钮：平滑滚到动画区结束（800vh 处 = 首页内容开始）
    var skipBtn = document.getElementById('ll-skip');
    if (skipBtn) {
      skipBtn.addEventListener('click', function () {
        window.scrollTo({ top: 8 * window.innerHeight, behavior: 'smooth' });
      });
    }
  })();
</script>

<style is:global>
  #ll-loading { font-family: 'Courier New', 'Consolas', 'Noto Sans SC', monospace; }
  #ll-loading .ll-layer {
    position: absolute;
    inset: 0;
    width: 100%;
