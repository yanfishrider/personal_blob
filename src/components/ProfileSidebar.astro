---
export interface Props {
  postCount: number;
  tagCount: number;
  categoryCount: number;
  recentPosts: Array<{ slug: string; title: string }>;
}

const { postCount, tagCount, categoryCount, recentPosts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="w-full md:w-[12%] md:min-w-[170px] shrink-0 md:relative">
  <div class="md:sticky md:top-[18%] space-y-4">
    <!-- 个人信息卡片 -->
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 shadow-sm space-y-5">
      <div class="text-center">
        <div class="avatar-ring mx-auto relative w-24 h-24 rounded-full bg-[#252423] shadow-lg mb-3 overflow-hidden">
          <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full">
            <circle class="track" cx="100" cy="100" r="70"
              fill="none" stroke="#3a3a3a" stroke-width="8" />
            <circle class="progress" cx="100" cy="100" r="30"
              fill="none" stroke="#ff7b42" stroke-width="8"
              stroke-linecap="round"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
            <circle class="progress-1" cx="100" cy="100" r="40"
              fill="none" stroke="#AAAAAA" stroke-width="10"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
            <circle class="progress-2" cx="100" cy="100" r="50"
              fill="none" stroke="#C5FCE7" stroke-width="10"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
            <circle class="progress-3" cx="100" cy="100" r="60"
              fill="none" stroke="#B7D8FE" stroke-width="10"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
            <circle class="progress-4" cx="100" cy="100" r="70"
              fill="none" stroke="#92C41E" stroke-width="10"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
            <circle class="progress-5" cx="100" cy="100" r="90"
              fill="none" stroke="#E9E9E9" stroke-width="10"
              pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
          </svg>
        </div>
        <h2 class="text-lg font-bold text-gray-800">摸鱼骑士</h2>
        <p id="motto-text" class="text-xs text-gray-500 mt-1">闲来垂钓碧溪上,忽复乘舟梦日边</p>
        <button id="motto-btn" type="button"
          class="inline-flex items-center text-[11px] text-gray-600 border border-gray-300 rounded-full px-3 py-0.5 mt-1.5 transition-colors duration-300 cursor-pointer select-none tracking-widest hover:text-[#49B1F5] hover:border-[#49B1F5]"
          title="切换个性签名">文本改变</button>
        <p class="text-xs text-gray-400 mt-0.5">软件开发</p>
      </div>

      <hr class="border-gray-200" />

      <div class="grid grid-cols-3 text-center">
        <a href={base} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{postCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">文章</div>
        </a>
        <a href={`${base}/tags`} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{tagCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">标签</div>
        </a>
        <a href={`${base}/categories`} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{categoryCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">分类</div>
        </a>
      </div>
    </div>

    <!-- 目录卡片 -->
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">目录</h3>
      <ul class="space-y-1.5">
        {recentPosts.slice(0, 8).map((p) => (
          <li>
            <a href={`${base}/posts/${p.slug}`}
               class="block text-xs text-gray-500 hover:text-blue-600 transition-colors truncate py-0.5">
              {p.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Follow Me -->
    <a href="https://github.com/yanfishrider" target="_blank" rel="noopener noreferrer"
       class="flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-[#49B1F5] hover:bg-[#BEE9D9] hover:text-gray-800 text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      Follow Me
    </a>
  </div>
</aside>

<style is:global>
  .avatar-ring .progress-1 { transform: rotate(130deg); transform-origin: 100px 100px; }
  .avatar-ring .progress-2 { transform: rotate(270deg); transform-origin: 100px 100px; }
  .avatar-ring .progress-3 { transform: rotate(20deg); transform-origin: 100px 100px; }
  .avatar-ring .progress-4 { transform: rotate(-50deg); transform-origin: 100px 100px; }
  .avatar-ring .progress-5 { transform: rotate(160deg); transform-origin: 100px 100px; }
</style>

<script>
  import { animate, scrambleText } from 'https://esm.sh/animejs@4.4.1';

  // 头像卡片：点击「文本改变」轮换个性签名（scrambleText 乱码切换）
  const mottoEl = document.getElementById('motto-text');
  const mottoBtn = document.getElementById('motto-btn');
  if (mottoEl && mottoBtn) {
    const mottoes = [
      '闲来垂钓碧溪上,忽复乘舟梦日边',
      '长风破浪会有时,直挂云帆济沧海',
      '行到水穷处,坐看云起时',
      '竹杖芒鞋轻胜马,谁怕?一蓑烟雨任平生',
      '此心安处是吾乡',
    ];
    let mottoIdx = 0;
    mottoBtn.addEventListener('click', () => {
      mottoIdx = (mottoIdx + 1) % mottoes.length;
      animate(mottoEl, {
        innerHTML: scrambleText({ text: mottoes[mottoIdx] }),
      });
    });
  }

  const avatars = document.querySelectorAll('.avatar-ring');
  if (avatars.length) {
    // 6 层描边动画
    ['progress', 'progress-1', 'progress-2', 'progress-3', 'progress-4', 'progress-5'].forEach(cls => {
      animate(`circle.${cls}`, {
        strokeDashoffset: 0,
        duration: 2000,
        easing: 'easeInOutQuad',
        loop: true,
        direction: 'alternate',
      });
    });
  }
</script>
