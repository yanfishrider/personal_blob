---
export interface Props {
  postCount: number;
  tagCount: number;
  categoryCount: number;
  recentPosts: Array<{ slug: string; title: string }>;
}

const { postCount, tagCount, categoryCount, recentPosts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<aside class="w-full md:w-[12%] md:min-w-[170px] shrink-0 md:relative">
  <div class="md:sticky md:top-[18%] space-y-4">
    <!-- 个人信息卡片 -->
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 shadow-sm space-y-5">
      <div class="text-center">
        <div class="mx-auto w-20 h-20 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg mb-3">
          摸
        </div>
        <h2 class="text-lg font-bold text-gray-800">摸鱼骑士</h2>
        <p class="text-xs text-gray-500 mt-1">闲来垂钓碧溪上,忽复乘舟梦日边</p>
        <p class="text-xs text-gray-400 mt-0.5">软件开发</p>
      </div>

      <hr class="border-gray-200" />

      <div class="grid grid-cols-3 text-center">
        <a href={base} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{postCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">文章</div>
        </a>
        <a href={`${base}/tags`} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{tagCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">标签</div>
        </a>
        <a href={`${base}/categories`} class="group py-1 rounded-lg hover:bg-gray-100 transition-colors">
          <div class="text-lg font-bold text-gray-800">{categoryCount}</div>
          <div class="text-xs text-gray-400 mt-0.5">分类</div>
        </a>
      </div>
    </div>

    <!-- 目录卡片 -->
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 shadow-sm">
      <h3 class="text-sm font-semibold text-gray-700 mb-3">目录</h3>
      <ul class="space-y-1.5">
        {recentPosts.slice(0, 8).map((p) => (
          <li>
            <a href={`${base}/posts/${p.slug}`}
               class="block text-xs text-gray-500 hover:text-blue-600 transition-colors truncate py-0.5">
              {p.title}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Follow Me -->
    <a href="https://github.com/yanfishrider" target="_blank" rel="noopener noreferrer"
       class="flex items-center justify-center gap-2 w-full px-4 py-2.5 bg-[#49B1F5] hover:bg-[#BEE9D9] hover:text-gray-800 text-white text-sm font-medium rounded-xl transition-colors shadow-sm">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      Follow Me
    </a>
  </div>
</aside>
