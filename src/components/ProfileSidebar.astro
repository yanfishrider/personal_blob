---
export interface Props {
  postCount: number;
  tagCount: number;
  categoryCount: number;
  recentPosts: Array<{ slug: string; title: string }>;
}

const { postCount, tagCount, categoryCount, recentPosts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;
---

<aside class="profile">
  <div class="rail-card profile__id">
    <div class="avatar-ring">
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <circle class="track" cx="100" cy="100" r="72" fill="none" stroke="var(--rule)" stroke-width="1" />
        <circle class="progress" cx="100" cy="100" r="34" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
        <circle class="progress-1" cx="100" cy="100" r="44" fill="none" stroke="var(--accent-soft)" stroke-width="1.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
        <circle class="progress-2" cx="100" cy="100" r="54" fill="none" stroke="var(--ink-4)" stroke-width="1.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
        <circle class="progress-3" cx="100" cy="100" r="64" fill="none" stroke="var(--ink-3)" stroke-width="1" stroke-linecap="round" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" />
      </svg>
      <span class="avatar-ring__monogram">摸</span>
    </div>

    <h2 class="profile__name">摸鱼骑士</h2>
    <p id="motto-text" class="profile__motto">闲来垂钓碧溪上，忽复乘舟梦日边</p>
    <button id="motto-btn" type="button" class="profile__motto-btn" title="换一句">
      换一句
      <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <p class="profile__role">软件开发 · 折腾动画</p>

    <div class="profile__stats">
      <a href={base || '/'} class="profile__stat">
        <span class="profile__stat-num">{postCount}</span>
        <span class="profile__stat-label">文章</span>
      </a>
      <a href={href('/tags')} class="profile__stat">
        <span class="profile__stat-num">{tagCount}</span>
        <span class="profile__stat-label">标签</span>
      </a>
      <a href={href('/categories')} class="profile__stat">
        <span class="profile__stat-num">{categoryCount}</span>
        <span class="profile__stat-label">分类</span>
      </a>
    </div>

    <a
      href="https://github.com/yanfishrider"
      target="_blank"
      rel="noopener noreferrer"
      class="btn profile__github"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
      </svg>
      GitHub
    </a>
  </div>

  <div class="rail-card">
    <div class="rail-title">
      <span>最近文章</span>
      <a href={href('/archive')} class="rail-title__link">全部</a>
    </div>
    <ul class="profile__recent">
      {
        recentPosts.map((p) => (
          <li>
            <a href={`${base}/posts/${p.slug}`} class="profile__recent-link">
              <span>{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style is:global>
  .profile {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .profile__id {
    text-align: center;
    padding: 22px 18px 18px;
  }

  .avatar-ring {
    position: relative;
    width: 104px;
    height: 104px;
    margin: 0 auto 14px;
  }
  .avatar-ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .avatar-ring__monogram {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-serif);
    font-size: 34px;
    color: var(--ink);
    letter-spacing: 0.02em;
  }

  .profile__name {
    font-size: 1.18rem;
    letter-spacing: 0.04em;
  }
  .profile__motto {
    margin-top: 8px;
    min-height: 2.6em;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .profile__motto-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    padding: 2px 9px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--ink-4);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 99px;
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .profile__motto-btn:hover {
    color: var(--accent-deep);
    border-color: var(--accent-soft);
  }
  .profile__role {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ink-4);
    text-transform: uppercase;
  }

  .profile__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 16px 0 14px;
    padding: 12px 0;
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .profile__stat {
    display: flex;
    flex-direction: column;
    gap: 1px;
    transition: color 0.2s ease;
  }
  .profile__stat + .profile__stat {
    border-left: 1px solid var(--rule-soft);
  }
  .profile__stat-num {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    color: var(--ink);
    line-height: 1.2;
  }
  .profile__stat-label {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--ink-4);
  }
  .profile__stat:hover .profile__stat-num {
    color: var(--accent-deep);
  }

  .profile__github {
    width: 100%;
    font-size: 12px;
  }

  .rail-title__link {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--ink-4);
    transition: color 0.2s ease;
  }
  .rail-title__link:hover {
    color: var(--accent-deep);
  }

  .profile__recent {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .profile__recent-link {
    display: block;
    padding: 5px 0 5px 11px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-3);
    border-left: 1px solid var(--rule-soft);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .profile__recent-link span {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .profile__recent-link:hover {
    color: var(--accent-deep);
    border-left-color: var(--accent-soft);
  }
</style>

<script>
  import { animate, scrambleText } from 'animejs';

  const mottoEl = document.getElementById('motto-text');
  const mottoBtn = document.getElementById('motto-btn');
  const mottoes = [
    '闲来垂钓碧溪上，忽复乘舟梦日边',
    '长风破浪会有时，直挂云帆济沧海',
    '行到水穷处，坐看云起时',
    '竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生',
    '此心安处是吾乡',
  ];

  if (mottoEl && mottoBtn) {
    let idx = 0;
    mottoBtn.addEventListener('click', () => {
      idx = (idx + 1) % mottoes.length;
      animate(mottoEl, { innerHTML: scrambleText({ text: mottoes[idx] }) });
    });
  }

  const rings = document.querySelectorAll('.avatar-ring');
  if (rings.length) {
    ['progress', 'progress-1', 'progress-2', 'progress-3'].forEach((cls, i) => {
      animate(`circle.${cls}`, {
        strokeDashoffset: 0,
        duration: 1800 + i * 220,
        easing: 'easeInOutQuad',
        loop: true,
        direction: 'alternate',
        delay: i * 120,
      });
    });
  }
</script>

<style is:global>
  .avatar-ring .progress-1 {
    transform: rotate(130deg);
    transform-origin: 100px 100px;
  }
  .avatar-ring .progress-2 {
    transform: rotate(270deg);
    transform-origin: 100px 100px;
  }
  .avatar-ring .progress-3 {
    transform: rotate(20deg);
    transform-origin: 100px 100px;
  }
</style>
