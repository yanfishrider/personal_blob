---
// SideToolbar.astro — 右侧悬浮工具栏
const ANIMATIONS = [
  { key: 'lab', label: '实验室风格' },
  { key: 'nier', label: 'NieR 风格' },
  { key: 'p3re', label: 'P3RE 风格' },
  { key: 'none', label: '无动画' },
];
---

<div id="side-toolbar" class="fixed right-4 bottom-8 z-50 flex flex-col gap-3">
  <!-- 切换动画 -->
  <div class="relative">
    <button
      id="btn-switch"
      title="切换开场动画"
      class="w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-gray-200 shadow-md flex items-center justify-center text-gray-500 hover:text-gray-800 hover:shadow-lg transition-all text-xs"
    >
      <span class="flex flex-col items-center text-base leading-none" style="font-family:monospace"><span>→</span><span>←</span></span>
    </button>

    <!-- 下拉菜单 -->
    <div id="switch-menu" class="hidden absolute right-0 bottom-12 mb-2 bg-white/95 backdrop-blur border border-gray-200 rounded-xl shadow-xl py-1.5 min-w-[140px]">
      <div class="px-3 py-1.5 text-[11px] text-gray-400 tracking-wider uppercase">开场动画</div>
      {ANIMATIONS.map((a) => (
        <button
          data-key={a.key}
          class="w-full text-left px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors flex items-center gap-2"
        >
          <span class="w-4 text-center text-[10px] switch-dot" data-key={a.key}></span>
          {a.label}
        </button>
      ))}
    </div>
  </div>

  <!-- 指示器样式 -->
  <div class="relative">
    <button
      id="btn-indicator"
      title="切换滚动指示器样式"
      class="w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-gray-200 shadow-md flex items-center justify-center text-gray-500 hover:text-gray-800 hover:shadow-lg transition-all text-sm"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 12l3-2"/><path d="M12 7V5"/></svg>
    </button>

    <!-- 下拉菜单 -->
    <div id="indicator-menu" class="hidden absolute right-0 bottom-12 mb-2 bg-white/95 backdrop-blur border border-gray-200 rounded-xl shadow-xl py-1.5 min-w-[140px]">
      <div class="px-3 py-1.5 text-[11px] text-gray-400 tracking-wider uppercase">指示器样式</div>
      <button data-indicator="ruler" class="w-full text-left px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors flex items-center gap-2">
        <span class="w-4 text-center text-[10px] indicator-dot" data-indicator="ruler"></span>
        横条刻度尺
      </button>
      <button data-indicator="clock" class="w-full text-left px-3 py-1.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors flex items-center gap-2">
        <span class="w-4 text-center text-[10px] indicator-dot" data-indicator="clock"></span>
        圆形表盘时针
      </button>
    </div>
  </div>

  <!-- 重播加载动画 -->
  <button
    id="btn-replay"
    title="重播开场动画"
    class="w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-gray-200 shadow-md flex items-center justify-center text-gray-500 hover:text-gray-800 hover:shadow-lg transition-all text-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
  </button>

  <!-- 回到顶部 -->
  <button
    id="btn-top"
    title="回到顶部"
    class="w-10 h-10 rounded-full bg-white/90 backdrop-blur border border-gray-200 shadow-md flex items-center justify-center text-gray-500 hover:text-gray-800 hover:shadow-lg transition-all text-sm"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
  </button>
</div>

<script>
  const btn = document.getElementById('btn-switch');
  const menu = document.getElementById('switch-menu');
  const indBtn = document.getElementById('btn-indicator');
  const indMenu = document.getElementById('indicator-menu');

  function currentKey() {
    return localStorage.getItem('loading-animation') || 'nier';
  }
  function currentIndicator() {
    return localStorage.getItem('scroll-indicator-style') || 'ruler';
  }

  function updateDots() {
    const cur = currentKey();
    document.querySelectorAll<HTMLElement>('.switch-dot').forEach((el) => {
      el.textContent = el.dataset.key === cur ? '●' : '○';
    });
  }

  function updateIndicatorDots() {
    const cur = currentIndicator();
    document.querySelectorAll<HTMLElement>('.indicator-dot').forEach((el) => {
      el.textContent = el.dataset.indicator === cur ? '●' : '○';
    });
  }

  function closeMenus() {
    menu?.classList.add('hidden');
    indMenu?.classList.add('hidden');
  }

  // 回到顶部
  document.getElementById('btn-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // 重播开场动画：清掉本次会话的「已看过」标记后重载
  document.getElementById('btn-replay')?.addEventListener('click', () => {
    sessionStorage.removeItem('nier-intro-done');
    sessionStorage.removeItem('p3re-intro-done');
    location.reload();
  });

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    updateDots();
    indMenu?.classList.add('hidden');
    menu?.classList.toggle('hidden');
  });

  indBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    updateIndicatorDots();
    menu?.classList.add('hidden');
    indMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', closeMenus);

  menu?.querySelectorAll<HTMLButtonElement>('button[data-key]').forEach((b) => {
    b.addEventListener('click', () => {
      const key = b.dataset.key;
      if (!key) return;
      localStorage.setItem('loading-animation', key);
      sessionStorage.removeItem('nier-intro-done');
      sessionStorage.removeItem('p3re-intro-done');
      location.reload();
    });
  });

  indMenu?.querySelectorAll<HTMLButtonElement>('button[data-indicator]').forEach((b) => {
    b.addEventListener('click', () => {
      const style = b.dataset.indicator;
      if (!style) return;
      localStorage.setItem('scroll-indicator-style', style);
      location.reload();
    });
  });
</script>
