---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import { getBlogData } from '../../lib/blog-data';
import { buildTaxonomy } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const all = await getCollection('posts', ({ data }) => !data.draft);
  const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const categories = buildTaxonomy(posts, 'category');

  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      name: cat.name,
      count: cat.count,
      posts: posts.filter((p) => p.data.category === cat.name),
      allCategories: categories,
    },
  }));
}

const { name, count, posts, allCategories } = Astro.props;
const { postCount, tagCount, categoryCount, recentPosts } = await getBlogData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentSlug = Astro.params.slug;
---

<BaseLayout
  title={`分类：${name} - 摸鱼骑士 知识库`}
  description={`分类「${name}」下的 ${count} 篇文章。`}
>
  <ProfileSidebar
    slot="sidebar"
    postCount={postCount}
    tagCount={tagCount}
    categoryCount={categoryCount}
    recentPosts={recentPosts}
  />

  <div>
    <header class="page-head">
      <a href={`${base}/categories`} class="page-head__back">← 全部分类</a>
      <span class="page-head__eyebrow">Category</span>
      <h1 class="page-head__title">{name}</h1>
      <p class="page-head__lead">共 {count} 篇文章</p>
    </header>

    <div class="flex flex-col gap-3">
      {posts.map((post) => <PostCard post={post} showDateRail />)}
    </div>

    {
      allCategories.length > 1 && (
        <div class="mt-10 border-t border-[var(--rule)] pt-6">
          <div class="section-label">其他分类</div>
          <div class="flex flex-wrap gap-2">
            {allCategories
              .filter((c) => c.slug !== currentSlug)
              .map((c) => (
                <a href={`${base}/categories/${c.slug}`} class="tag-chip">
                  {c.name}
                  <span class="ml-1 opacity-50">{c.count}</span>
                </a>
              ))}
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
