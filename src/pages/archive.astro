---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped: Record<string, typeof sorted> = {};
sorted.forEach(p => {
  const year = p.data.date.getFullYear().toString();
  if (!grouped[year]) grouped[year] = [];
  grouped[year].push(p);
});
---

<BaseLayout title="归档 - 摸鱼骑士 知识库">
  <h1 class="text-3xl font-bold mb-8">归档</h1>
  {
    Object.entries(grouped).map(([year, posts]) => (
      <section class="mb-8">
        <h2 class="text-xl font-bold text-gray-400 mb-4">{year}</h2>
        <ul class="space-y-3">
          {posts.map(p => (
            <li class="flex items-baseline gap-4">
              <span class="text-sm text-gray-400 shrink-0 w-16">{p.data.date.toISOString().slice(5, 10)}</span>
              <a href={`${import.meta.env.BASE_URL}/posts/${p.slug}`} class="text-gray-700 hover:text-blue-600 transition-colors">
                {p.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
