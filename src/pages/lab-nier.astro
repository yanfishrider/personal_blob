---
// lab-nier.astro — 动画馆 iframe 内容页 2/3：NieR 风格加载动画（演示模式）
// 从 LoadingScreen.astro 的 runNier 抽取核心：canvas 网格点阵徽章 + LOADING 打字 + 终端行逐字
// 演示模式改动：无滚动翻转/无滚动指示器/无点击进入，播完停留，提供"重播"按钮
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>NieR 加载动画</title>
  <style>
    html, body { height: 100%; margin: 0; background: #1C1814; }
    body {
      font-family: 'Courier New', 'Source Code Pro', 'Consolas', 'Noto Sans SC', monospace;
      letter-spacing: 0.05em; overflow: hidden;
    }
    /* 网格背景：5px 点阵感（同原 #nier-stage 背景） */
    #nier-stage {
      position: relative; width: 100vw; height: 100vh; overflow: hidden;
      background: #1C1814;
      background-image: linear-gradient(rgba(0,0,0,0.15) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.15) 1px, transparent 1px);
      background-size: 5px 5px;
    }
    #nier-grid-art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; }
    #nier-loading-text { position: absolute; top: 8vh; left: 8vh; z-index: 10; }
    #nier-loading-text .big { color: #fff; }
    #nier-loading-text .big .main { font-size: 2.4rem; letter-spacing: 0.15em; }
    #nier-loading-text .big .sub { font-size: 1.1rem; }
    #nier-dots { font-size: 1.1rem; }
    #nier-lines { position: absolute; top: 28vh; left: 8vh; z-index: 10; }
    #nier-lines p { margin: 0 0 6px; font-size: 0.9rem; letter-spacing: 0.05em; }
    #nier-lines p span { color: #fff; }
    /* 重播按钮 */
    #nier-replay {
      position: absolute; right: 8vh; bottom: 6vh; z-index: 20;
      padding: 10px 26px; border-radius: 999px;
      font-family: inherit; font-size: 0.8rem; letter-spacing: 0.25em;
      color: rgba(255,255,255,.9); border: 1px solid rgba(255,255,255,.35);
      background: rgba(255,255,255,.08); cursor: pointer;
      opacity: 0; pointer-events: none; transition: opacity .5s ease, background .3s ease;
    }
    #nier-replay.show { opacity: 1; pointer-events: auto; }
    #nier-replay:hover { background: rgba(34,211,238,.15); border-color: rgba(34,211,238,.8); color: #7FF3FF; }
  </style>
</head>
<body>
  <div id="nier-stage">
    <canvas id="nier-grid-art"></canvas>
    <div id="nier-loading-text">
      <p class="big">
        <span class="main">LOADING</span><span class="sub">_系统启动中</span><span id="nier-dots"></span>
      </p>
    </div>
    <div id="nier-lines"></div>
    <button id="nier-replay">↻ 重播</button>
  </div>

  <script type="module">
    import('../../ascii-art.txt?raw').then(function (m) {
      var ASCII_EMBLEM = m.default.split('\n').filter(function (r) { return r.length > 0; });

      var GLITCH_CHARS = '!@#$%^&*<>?|/\\{}[]±§☆★○●◇◆□■△▲▽▼→←↑↓↔↕♠♣♥♦♂♀∞≈≠≤≥';
      function randomGlitch() { return GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)]; }
      function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

      var lines = [
        '连接服务器 - 完成', '页面资源 - 完毕', '渲染引擎 - 初始化',
        '全局样式表 - 已解析', '字体文件 - 已加载', '脚本模块 - 已编译',
        'WebSocket连接 - 已建立', '路由表 - 初始化', '资源完整性 - 已验证', '页面准备就绪',
      ];

      var CELL = 1.5, GAP = 0, STEP = CELL + GAP;
      var DOT = 2, OFF = (CELL - DOT) / 2;
      var STRETCH_Y = 2.75, STRETCH_X = 1.5;
      var DENSITY_MAP = {
        ' ': 0, '@': 0.50, '#': 0.44, '%': 0.38, '*': 0.32, '=': 0.26,
        '+': 0.20, '-': 0.14, ':': 0.08, '.': 0.04,
      };

      var canvas = document.getElementById('nier-grid-art');
      var container = document.getElementById('nier-lines');
      var dotsEl = document.getElementById('nier-dots');
      var replayBtn = document.getElementById('nier-replay');
      var running = false;
      var dotTimer = null;

      function drawGridArt() {
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        function drawDots(arr, ox, oy) {
          for (var r = 0; r < arr.length; r++) {
            var row = arr[r];
            for (var c = 0; c < row.length; c++) {
              var a = DENSITY_MAP[row[c]] || 0;
              if (a > 0) {
                ctx.fillStyle = 'rgba(200,200,210,' + a + ')';
                ctx.fillRect(ox + c * STEP * STRETCH_X + OFF, oy + r * STEP * STRETCH_Y + OFF, DOT * STRETCH_X, DOT * STRETCH_Y);
              }
            }
          }
        }
        var ew = ASCII_EMBLEM[0].length * STEP * STRETCH_X;
        var eh = ASCII_EMBLEM.length * STEP * STRETCH_Y;
        var ox = (canvas.width - ew) / 2;
        var oy = (canvas.height - eh) / 2;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drawDots(ASCII_EMBLEM, ox, oy);
      }

      drawGridArt();
      window.addEventListener('resize', drawGridArt);

      var CHAR_DELAY = 22, GLITCH_DURATION = 28;
      var glitchChance = Math.random() * 0.08;
      var dotStates = ['_', '.', '..', '...', ''];

      function startDots() {
        if (dotTimer) clearInterval(dotTimer);
        var dotIdx = 0;
        dotTimer = setInterval(function () {
          if (dotsEl) dotsEl.textContent = dotStates[dotIdx];
          dotIdx = (dotIdx + 1) % dotStates.length;
        }, 400);
      }

      async function typeLine(text, isLast) {
        var el = document.createElement('p');
        container.appendChild(el);
        for (var i = 0; i < text.length; i++) {
          var span = document.createElement('span');
          span.style.color = 'rgba(255,255,255,0.2)'; span.textContent = text[i];
          if (Math.random() < glitchChance) {
            var gs = document.createElement('span'); gs.textContent = randomGlitch(); gs.style.color = 'rgba(255,255,255,0.5)';
            el.appendChild(gs); await sleep(GLITCH_DURATION); el.removeChild(gs);
          }
          el.appendChild(span);
          requestAnimationFrame(function () { span.style.transition = 'color 0.25s ease-out'; span.style.color = '#fff'; });
          await sleep(CHAR_DELAY);
        }
        if (isLast) {
          var c = document.createElement('span'); c.style.color = '#fff'; c.textContent = '_';
          el.appendChild(c); await sleep(300); c.style.opacity = '0'; await sleep(200); c.style.opacity = '1'; await sleep(300);
        }
        await sleep(80);
      }

      async function run() {
        running = true;
        replayBtn.classList.remove('show');
        container.innerHTML = '';
        startDots();
        for (var i = 0; i < lines.length; i++) await typeLine(lines[i], i === lines.length - 1);
        clearInterval(dotTimer); if (dotsEl) dotsEl.textContent = '';
        await sleep(500);
        running = false;
        replayBtn.classList.add('show');
      }

      replayBtn.addEventListener('click', function () { run(); });
      run();
    });
  </script>
</body>
</html>
