---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import SiteStats from '../components/SiteStats.astro';
import BlogCalendar from '../components/BlogCalendar.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const tagSet = new Set<string>();
const catSet = new Set<string>();
posts.forEach(p => {
  p.data.tags?.forEach(t => tagSet.add(t));
  if (p.data.category) catSet.add(p.data.category);
});
const tagCount = tagSet.size;
const catCount = catSet.size;

const recentPosts = posts.slice(0, 8).map(p => ({ slug: p.slug, title: p.data.title }));

const postDates = posts.map(p => {
  const d = p.data.date;
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
});

const lastUpdate = posts.length > 0 ? posts[0].data.date : new Date();
---

<BaseLayout title="摸鱼骑士 知识库" description="代码如诗，架构如画。">
  <ProfileSidebar slot="sidebar" postCount={posts.length} tagCount={tagCount} categoryCount={catCount} recentPosts={recentPosts} />

  <div id="center-view" class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
    <h2 class="section-header text-sm font-medium text-gray-400 uppercase tracking-wider mb-6">最新文章</h2>

    {
      posts.length === 0 ? (
        <p class="text-gray-400 text-center py-20">还没有文章。</p>
      ) : (
        <div class="post-grid grid gap-5 grid-cols-1 md:grid-cols-2">
          {posts.map((post) => (
            <a href={`${import.meta.env.BASE_URL}/posts/${post.slug}`}
               class="post-card group block bg-gray-50 rounded-xl border border-gray-200 p-5 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
              <time class="text-xs text-gray-400">
                {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h3 class="text-base font-semibold text-gray-800 group-hover:text-blue-600 transition-colors mt-2 mb-1.5 line-clamp-2">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="text-sm text-gray-500 line-clamp-2 mb-3">{post.data.description}</p>
              )}
              <div class="flex items-center gap-2 flex-wrap">
                {post.data.category && (
                  <span class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-600 font-medium">{post.data.category}</span>
                )}
                {post.data.tags?.map((tag: string) => (
                  <span class="text-xs px-2 py-0.5 rounded bg-gray-100 text-gray-500">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <aside slot="rightSidebar" class="w-full md:w-[14%] md:min-w-[150px] shrink-0 md:relative">
    <div class="md:sticky md:top-[18%] space-y-4">
      <SiteStats postCount={posts.length} lastUpdate={lastUpdate} />
      <BlogCalendar postDates={postDates} />
    </div>
  </aside>
</BaseLayout>

<script src={`${import.meta.env.BASE_URL}/scripts/spa-loader.js`}></script>
