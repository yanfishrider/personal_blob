---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import PostCard from '../components/PostCard.astro';
import SiteStats from '../components/SiteStats.astro';
import BlogCalendar from '../components/BlogCalendar.astro';
import { getBlogData, formatDate, isoDate } from '../lib/blog-data';

const { posts, postCount, tagCount, categoryCount, recentPosts, postDates, lastUpdate } =
  await getBlogData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="摸鱼骑士 知识库"
  description="前端、动画与一些奇怪想法的实现记录。"
>
  <ProfileSidebar
    slot="sidebar"
    postCount={postCount}
    tagCount={tagCount}
    categoryCount={categoryCount}
    recentPosts={recentPosts}
  />

  <div id="center-view">
    <header class="page-head">
      <span class="page-head__eyebrow">Field Notes</span>
      <h1 class="page-head__title">最新文章</h1>
      <p class="page-head__lead">
        前端、动画，以及一些奇怪想法的实现记录。共 {postCount} 篇，最近更新于
        <time datetime={isoDate(lastUpdate)} class="whitespace-nowrap">{formatDate(lastUpdate)}</time>。
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty-state">还没有文章。</p>
      ) : (
        <div class="flex flex-col gap-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }

    {
      posts.length > 6 && (
        <div class="mt-8 text-center">
          <a href={`${base}/archive`} class="btn">
            查看全部归档
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      )
    }
  </div>

  <div slot="rightSidebar" class="flex flex-col gap-3">
    <SiteStats postCount={postCount} lastUpdate={lastUpdate} />
    <BlogCalendar postDates={postDates} />
  </div>
</BaseLayout>

<script src={`${base}/scripts/spa-loader.js`}></script>
