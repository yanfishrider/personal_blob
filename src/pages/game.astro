---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="打靶游戏 · 摸鱼骑士">
  <div id="app" data-base={import.meta.env.BASE_URL}></div>
  <canvas id="game-canvas"></canvas>

  <div id="hud">
    <div>命中 <span id="hud-hits">0</span></div>
    <div>柱子 <span id="hud-pillars">0</span></div>
    <div class="key">空格 射击 · 光标自动转向最近柱子</div>
  </div>

  <!-- 转向版徽章光标（32×46，顶部朝最近柱子）。BaseLayout 的 16×16 静态光标在本页隐藏 -->
  <div id="game-cursor" aria-hidden="true">
    <div class="cursor-svg"><svg xmlns="http://www.w3.org/2000/svg" viewBox="72.9 8.1 299 432.9" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
