---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description || '',
  tags: p.data.tags || [],
  date: p.data.date.toISOString().slice(0, 10),
}));
---

<BaseLayout title="搜索 - 摸鱼骑士 知识库">
  <h1 class="text-3xl font-bold mb-8">搜索</h1>
  <div class="max-w-md">
    <input
      type="text"
      id="search-input"
      placeholder="输入关键词搜索文章…"
      class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none"
      autofocus
    />
  </div>
  <div id="search-results" class="mt-8 space-y-4"></div>
</BaseLayout>

<script>
  const postData = JSON.parse('{JSON.stringify(posts)}');
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;
  const baseUrl = import.meta.env.BASE_URL;

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (!q) { results.innerHTML = ''; return; }
    const filtered = postData.filter((p: any) =>
      p.title.toLowerCase().includes(q) ||
      p.description.toLowerCase().includes(q) ||
      p.tags.some((t: string) => t.toLowerCase().includes(q))
    );
    results.innerHTML = filtered.length
      ? filtered.map((p: any) => `
        <a href="${baseUrl}posts/${p.slug}" class="card block p-4 hover:shadow-md transition-shadow">
          <h3 class="font-medium text-gray-800">${p.title}</h3>
          <p class="text-sm text-gray-400 mt-1">${p.date}</p>
        </a>`).join('')
      : '<p class="text-gray-400">未找到相关文章</p>';
  });
</script>
