---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.map(p => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description || '',
  tags: p.data.tags || [],
  date: p.data.date.toISOString().slice(0, 10),
}));
---

<BaseLayout title="搜索 - 摸鱼骑士 知识库">
  <script type="application/json" id="post-data" data-base={import.meta.env.BASE_URL}>{JSON.stringify(posts)}</script>
  <h1 class="text-3xl font-bold mb-8">搜索</h1>
  <div class="max-w-md">
    <input
      type="text"
      id="search-input"
      placeholder="输入关键词搜索文章…"
      class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none"
      autofocus
    />
  </div>
  <div id="search-results" class="mt-8 space-y-4"></div>
</BaseLayout>

<script>
  var postData = JSON.parse(document.getElementById('post-data').textContent);
  var input = document.getElementById('search-input');
  var results = document.getElementById('search-results');
  var baseUrl = document.querySelector('#post-data').getAttribute('data-base') || '/astro-blog';

  var timer = null;
  input && input.addEventListener('input', function() {
    clearTimeout(timer);
    timer = setTimeout(function() {
      var q = input.value.trim().toLowerCase();
      if (!q) { results.innerHTML = ''; return; }
      var filtered = postData.filter(function(p) {
        return p.title.toLowerCase().indexOf(q) !== -1 ||
               p.description.toLowerCase().indexOf(q) !== -1 ||
               p.tags.some(function(t) { return t.toLowerCase().indexOf(q) !== -1; });
      });
      results.innerHTML = filtered.length
        ? filtered.map(function(p) {
            return '<a href="' + baseUrl + '/posts/' + p.slug + '" class="card block p-4 hover:shadow-md transition-shadow">' +
              '<h3 class="font-medium text-gray-800">' + p.title + '</h3>' +
              '<p class="text-sm text-gray-400 mt-1">' + p.date + '</p></a>';
          }).join('')
        : '<p class="text-gray-400">未找到相关文章</p>';
    }, 300);
  });
</script>
