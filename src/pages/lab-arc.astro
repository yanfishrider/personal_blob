    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid #000;
  }
  .lab-ring-665 {
    width: calc(100% - 85px);   /* 750 - 85 = 665 */
    height: calc(100% - 85px);
  }
  .lab-ring-660 {
    width: calc(100% - 100px);  /* 750 - 100 = 650 */
    height: calc(100% - 100px);
  }
  /* 725 圆弧层：铺满整个圆区域，弧段由 JS 生成 */
  .lab-arc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* 横向刻度尺容器：圆形容器外，fixed 右下角（右 12%、底 10%），350×40 圆角背景 #2F2E2D */
  .lab-ruler {
    position: fixed;
    right: 12%;
    bottom: 10%;
    z-index: 10;
    width: 350px;
    height: 40px;
    background: #2F2E2D;
    border-radius: 10px;
    box-sizing: border-box;
    cursor: pointer;
  }
  .lab-ruler svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 刻度尺上方浮动代码卡片：进入浮起 + 持续上下浮动 */
  .lab-code-card {
    position: fixed;
    right: 12%;
    bottom: calc(10% + 52px);
    z-index: 10;
    max-width: 360px;
    background: rgba(47, 46, 45, 0.92);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 11px;
    line-height: 1.6;
    color: #7FF3FF;
    font-family: 'Courier New', 'Consolas', monospace;
    white-space: pre-wrap;
    word-break: break-all;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
  }
  .lab-code-card.show {
    opacity: 1;
    animation: lab-code-enter .9s cubic-bezier(.22, 1, .36, 1);
  }
  /* 进入：从下方浮起（缓慢平滑） */
  @keyframes lab-code-enter {
    from { transform: translateY(24px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }


  /* 圆外左侧介绍长条：每张卡片占满整屏高度，随进度整屏上移；无色块融入背景 */
  .lab-left {
    position: fixed;
    left: 12.5%;
    top: 0;
    width: 15%;
    height: 100vh;
    z-index: 10;
    overflow: hidden;
    pointer-events: none;
  }
  .lab-left-list {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  .lab-left-card {
    width: 100%;
    height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: transparent;   /* 融入页面背景 */
    border: none;              /* 去除边框 */
    padding: 24px 20px;
    font-size: 13px;
    line-height: 1.8;
    color: rgba(201, 232, 239, 0.85);
    letter-spacing: 0.05em;
    text-align: center;
  }
  .lab-left-card .lc-title {
    font-size: 20px;
    font-weight: bold;
    color: #7FF3FF;
    letter-spacing: 0.2em;
    /* 艺术字效果：细描边 + 微光 */
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.55), 0 0 20px rgba(34, 211, 238, 0.25);
  }

  /* 中心场景容器 */
  .lab-center {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 300px;
    height: 300px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  /* 12 图形随机游走层：盖住点阵/圆环，第二段圆弧显示（opacity 过渡），整体提亮 */
  .lab-shapes {
    z-index: 6;
    transition: opacity .35s ease;
    filter: brightness(1.5);
  }
  .lab-shapes .shape {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* 椭圆轨迹层：半透明椭圆线条（JS 生成，当前不可见），第三段圆弧显示 */
  .lab-ellipse {
    z-index: 6;
    transition: opacity .35s ease;
  }
  /* 引擎仪表盘层：齿轮 + 指针（JS 生成），第六段圆弧显示（opacity 过渡） */
  .lab-engine {
    z-index: 6;
    opacity: 0;
    transition: opacity .35s ease;
  }
  /* 闭合赛道层：圆点沿闭合 path 绕行 + 轨道描边生长（JS 生成），第四段圆弧显示 */
  .lab-track {
    z-index: 6;
    opacity: 0;
    transition: opacity .35s ease;
  }
  /* 绽开特效层：中心自动循环 圆环扩散 + 彩色圆点绽开（JS 生成），第五段圆弧显示 */
  .lab-burst {
    z-index: 6;
    opacity: 0;
    transition: opacity .35s ease;
  }

  /* 第七段层：老虎机竖条 + 4x4 网格推箱子绕行（JS 生成），第七段圆弧显示 */
  .lab-slots {
    z-index: 6;
    opacity: 0;
    transition: opacity .35s ease;
  }

  /* 第八段层：风水转盘 8 同心环 × 8 段弧，点击联动（JS 生成），第八段圆弧显示 */
  .lab-fengshui {
    z-index: 6;
    opacity: 0;
    transition: opacity .35s ease;
  }
  /* 命中层：覆盖全局 cursor:none（同 !important 拼 specificity），hover 显示手型 */
  .lab-fengshui [data-native-cursor] {
    cursor: pointer !important;
  }


  /* 第四段形状菜单：fixed 右下角（代码卡片上方），仅第四段显示 */
  .lab-shape-menu {
    position: fixed;
    right: 12%;
    bottom: calc(10% + 165px);
    z-index: 30;
    display: flex;
    gap: 6px;
    padding: 6px;
    background: rgba(10, 14, 18, 0.72);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .35s ease;
  }
  .lab-shape-menu button {
    padding: 4px 12px;
    border: 1px solid rgba(34, 211, 238, 0.35);
    border-radius: 6px;
    background: rgba(20, 28, 36, 0.85);
    color: #7FF3FF;
    font-size: 13px;
    cursor: pointer;
    transition: all .2s ease;
  }
  .lab-shape-menu button:hover { background: rgba(34, 211, 238, 0.15); }
  .lab-shape-menu button.active {
    background: rgba(34, 211, 238, 0.25);
    border-color: #22D3EE;
    box-shadow: 0 0 8px rgba(34, 211, 238, 0.4);
  }
  /* 引擎 RPM 计数器：齿轮下方，等宽数字 + 荧光，第四段显示 */
  .lab-counter {
    position: absolute;
    left: 50%;
    bottom: 5%;
    transform: translateX(-50%);
    z-index: 6;
    font-family: 'Courier New', 'Consolas', monospace;
    font-size: 34px;
    font-weight: bold;
    letter-spacing: 0.18em;
    color: #6A9622;
    filter: brightness(1.42);
    text-shadow: 0 0 10px rgba(106, 150, 34, 0.8), 0 0 26px rgba(106, 150, 34, 0.4);
    opacity: 0;
    transition: opacity .35s ease;
    pointer-events: none;
    text-align: center;
    line-height: 1.15;
    white-space: nowrap;
  }
  .lab-counter .lc-unit {
    display: block;
    font-size: 13px;
    letter-spacing: 0.4em;
    opacity: 0.75;
    margin-top: 2px;
  }
  /* 中心旋转色块：圆角正方（inset 0 + margin auto 绝对居中，双向可靠），颜色由 JS 取第一段弧色 + brightness 高亮（无荧光） */
  .lab-square {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin: auto;
    width: 200px;
    height: 200px;
    border-radius: 24px;
    will-change: transform;
    transition: opacity .35s ease;
  }
  .lab-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 0.2em;
    color: #7FF3FF;
    text-shadow: 0 0 12px rgba(34, 211, 238, 0.7), 0 0 30px rgba(34, 211, 238, 0.35);
    opacity: 0;
    transition: opacity .4s ease;
  }
  .lab-scene.active {
    opacity: 1;
  }

  /* 占位动画（后续替换为真实 JS 动画） */
  @keyframes anim-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.15); } }
  @keyframes anim-ripple { 0% { transform: scale(.6); opacity: 1; } 100% { transform: scale(1.8); opacity: 0; } }
  @keyframes anim-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes anim-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.35); } }
  @keyframes anim-sweep { 0% { transform: translateX(-30%); } 100% { transform: translateX(30%); } }
  @keyframes anim-count { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes anim-twinkle { 0%,100% { opacity: .5; } 50% { opacity: 1; } }
  @keyframes anim-swirl { from { transform: rotate(0deg) scale(1); } to { transform: rotate(90deg) scale(.85); } }
  .lab-scene .scene-anim {
    animation-duration: 1.6s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }
  .anim-breathe .scene-anim { animation-name: anim-breathe; }
  .anim-ripple .scene-anim { animation-name: anim-ripple; }
  .anim-spin .scene-anim { animation-name: anim-spin; animation-timing-function: linear; }
  .anim-pulse .scene-anim { animation-name: anim-pulse; }
  .anim-sweep .scene-anim { animation-name: anim-sweep; }
  .anim-count .scene-anim { animation-name: anim-count; }
  .anim-twinkle .scene-anim { animation-name: anim-twinkle; }
  .anim-swirl .scene-anim { animation-name: anim-swirl; }
</style>
</body>
</html>

