    overflow: hidden;
    background: #252423;
    color: #22D3EE;
    font-family: 'Courier New', 'Consolas', monospace;
    position: relative;
  }
  .lab-stage {
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    box-sizing: border-box;
  }
  /* 主动画区域：750×750 大圆，黑色边框；小视口自动缩小保证完整显示 */
  .lab-circle {
    position: relative;
    width: min(750px, 92vw, 92vh);
    height: min(750px, 92vw, 92vh);
    border-radius: 50%;
    border: 2px solid #000;
    flex-shrink: 0;
  }
  /* 内部同心圆：700×700（外圆减 50px），仅黑色线条，随外圆自适应缩放 */
  .lab-circle-inner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(100% - 50px);
    height: calc(100% - 50px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid #000;
  }
  /* 665/660 圆环：黑色线条，同心 */
  .lab-ring {
    position: absolute;
