---
// lab-arc.astro — 动画馆 iframe 内容页 1/3：圆弧动画（animation-lab 原样剥离 BaseLayout，fixed 定位相对 iframe 视口）
// 必须有完整 <html> 骨架：否则 Astro 不注入 @vite/client/CSS 引用，页面无样式（2026-09 实测）
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>圆弧动画</title>
</head>
<body>
<main id="anim-lab" class="anim-lab">
    <!-- 测试内容：750 主动画区域 + 700 内圆 + 725 圆弧分段 + 665/660 圆环 + 667 刻度线 -->
    <!-- 圆弧区：页面固定 100vh 聚焦圆环，wheel 滚轮驱动进度 -->
    <div class="lab-stage">
      <div id="lab-circle" class="lab-circle">
        <svg id="lab-dots" class="lab-arc" viewBox="0 0 750 750"></svg>
        <div id="lab-circle-inner" class="lab-circle-inner"></div>
        <div id="lab-ring-665" class="lab-ring lab-ring-665"></div>
        <div id="lab-ring-660" class="lab-ring lab-ring-660"></div>
        <svg id="lab-arc" class="lab-arc" viewBox="0 0 750 750"></svg>
        <svg id="lab-ticks" class="lab-arc" viewBox="0 0 750 750"></svg>
        <svg id="lab-rings" class="lab-arc" viewBox="0 0 750 750"></svg>
        <!-- 12 图形随机游走层：6 实心 + 6 线框（第二段圆弧显示） -->
        <svg id="lab-shapes" class="lab-arc lab-shapes" viewBox="0 0 750 750"></svg>
        <!-- 椭圆轨迹层：轨迹不可见，色块（弧段样式）绕椭圆运动构建 3D 球（第三段圆弧显示，先单椭圆验证） -->
        <svg id="lab-ellipse" class="lab-arc lab-ellipse" viewBox="0 0 750 750"></svg>
        <!-- 引擎仪表盘层：齿轮咬合 + 转速指针（第六段圆弧显示，rAF 时间驱动） -->
        <svg id="lab-engine" class="lab-arc lab-engine" viewBox="0 0 750 750"></svg>
        <!-- 闭合赛道层：圆点沿闭合 path 绕行 + 轨道描边生长（第四段圆弧显示，形状可切换） -->
        <svg id="lab-track" class="lab-arc lab-track" viewBox="0 0 750 750"></svg>
        <!-- 绽开特效层：中心自动循环 圆环扩散 + 彩色圆点绽开（第五段圆弧显示，独立 rAF） -->
        <svg id="lab-burst" class="lab-arc lab-burst" viewBox="0 0 750 750"></svg>
        <!-- 第七段层：老虎机竖条挤出 + 4x4 网格推箱子绕行（第七段圆弧显示，独立 rAF） -->
        <svg id="lab-slots" class="lab-arc lab-slots" viewBox="0 0 750 750"></svg>
        <!-- 第八段层：风水转盘 8 同心环 × 8 段弧，点击联动 + 数字提示（第八段圆弧显示，独立 rAF） -->
        <svg id="lab-fengshui" class="lab-arc lab-fengshui" viewBox="0 0 750 750"></svg>
        <!-- 中心旋转色块：相对主圆容器居中（第一段圆弧色高亮无荧光，anime.js 旋转） -->
        <div id="lab-square" class="lab-square"></div>
        <!-- 引擎 RPM 计数器：齿轮下方（第四段显示，随指针转速跳动） -->
        <div id="lab-counter" class="lab-counter"><span id="lab-counter-val">0000</span><span class="lc-unit">RPM</span></div>
      </div>
    </div>
    <div id="lab-ruler" class="lab-ruler">
      <svg id="lab-ruler-svg" width="350" height="40" viewBox="0 0 350 40"></svg>
    </div>

    <!-- 刻度尺上方浮动代码卡片：显示当前段 SCENES[idx].code -->
    <div id="lab-code-card" class="lab-code-card"></div>

    <!-- 第四段形状菜单：闭合赛道形状切换（仅第四段显示） -->
    <div id="lab-shape-menu" class="lab-shape-menu">
      <button data-shape="solar" class="active">星系</button>
      <button data-shape="circle">圆</button>
      <button data-shape="ellipse">椭圆</button>
      <button data-shape="diamond">菱形</button>
      <button data-shape="heart">心形</button>
      <button data-shape="star">五角星</button>
      <button data-shape="square">方形</button>
      <button data-shape="triangle">三角</button>
    </div>

    <!-- 圆外左侧介绍长条：8 张卡片随进度上移 -->
    <div id="lab-left" class="lab-left">
      <div id="lab-left-list" class="lab-left-list"></div>
    </div>

    <!-- 圆形容器外的横向刻度尺容器：fixed 右下角（right:20% bottom:10%），350×40 圆角 -->
  </main>

<script>
  // ===== 场景数据（8 段占位，改数组长度即可调整段数） =====
  // 每段：title 左侧卡片标题 / desc 左侧介绍（介绍中心旋转色块动画的各方面）/ code 刻度尺上方代码卡片
  var SCENES = [
    { title: '中心色块旋转', desc: 'div 方块填充第一段弧色并 brightness 提亮，anime.js v4 animate() 驱动 rotate 0↔90° 往返，inOutExpo 两端缓入缓出，500ms 无限循环——最基础的 CSS transform 旋转动画。', code: "// 中心色块：弧色填充 + 提亮\nsquareEl.style.background = '#16899B';\nsquareEl.style.filter = 'brightness(1.42)';\n// anime.js 驱动旋转（往返）\nanimate(squareEl, {\n  rotate: 90, loop: true,\n  duration: 500, ease: 'inOutExpo'\n});" },
    { title: '12 图形随机游走', desc: '6 类形状（圆/三角/方/菱形/星/圆弧）× 实心+线框 = 12 个，anime.js 独立循环随机跳点：目标点极坐标随机（活动半径 ≤240）、scale 0.4~1.6、duration 600~1400ms、ease out(3)，间隔 500~1100ms 递归循环。', code: "// 12 图形：6 类形状 × 实心/线框，独立随机游走\\nshapesEls.forEach(function (el, i) {\\n  function loop() {\\n    var p = randPoint();            // 极坐标随机点\\n    animate(el, {\\n      x: p.x, y: p.y,\\n      scale: utils.random(0.4, 1.6),\\n      duration: utils.random(600, 1400),\\n      ease: 'out(3)',\\n    });\\n    setTimeout(loop, utils.random(500, 1100));\\n  }\\n  setTimeout(loop, utils.random(0, 900));\\n});" },
    { title: '3D 球体错觉', desc: '20 条扁椭圆沿对角线对称排布（rx 两端 57.5、中间 258.75，扁度 0.2，rotate -45°）叠出球面纬线投影，滚轮驱动 stroke-dashoffset 逐条画-保持-擦除，组级呼吸浮动（独立 rAF 时间驱动）。', code: "// 20 条椭圆：纬线投影 → 3D 球\\nvar t = (i - 9.5) / 9.5;               // -1 ~ 1\\nvar rx = 57.5 + 201.25 * (1 - t * t);  // 两端小中间大\\n// path: M (cx-rx) cy A rx ry 0 1 0 ...\\n// 滚轮驱动: dashoffset = L * (1 - drawP)\\n// 呼吸浮动: 独立 rAF, sin(t) ±8px" },
    { title: '闭合赛道绕行', desc: '圆点沿闭合 path 匀速绕行（getPointAtLength），轨道描边"跑到哪画到哪"（dashoffset 第一圈画满后保持完整）；菜单可切星系/圆/椭圆/菱形/心形/五角星/方形/三角，星系 = 太阳 + 3 轨道行星自转 + 卫星绕转 + 近大远小。', code: "// 圆点沿闭合 path 绕行 + 轨道描边生长\\nvar pt = path.getPointAtLength(prog * L);\\nvar pt2 = path.getPointAtLength(Math.min(prog * L + 1, L - 0.01));\\nvar ang = Math.atan2(pt2.y - pt.y, pt2.x - pt.x) * 180 / Math.PI;\\ndot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y);\\n// 描边: dasharray = L L, dashoffset = L * (1 - drawP)" },
    { title: '中心绽开特效', desc: '中心自动循环：圆环扩散（0→200px，后 40% 透明度衰减）+ 18 个彩色粒子外飞（随机形状/颜色，飞散距离 40~300），1800ms 间隔触发，1100ms 单次，结束即清理 DOM。', code: "// 圆环 + 18 粒子，1800ms 间隔自动触发\\nfunction burstFire(now) {\\n  // ring: r 0→200, 后 40% 透明度衰减\\n  // dot: 随机形状/颜色, ease 外飞 + scale 缩小\\n}\\n// p >= 1 时 removeChild + splice 清理" },
    { title: '引擎仪表盘', desc: '齿轮榫卯咬合（16/10 齿，速比 1.6 反向旋转）+ RPM 指针 + 刻度线联动：指针扫过时刻度外移高亮、分段弧三态（低亮/高亮/点亮），转速随段内进度驱动（inSeg=1 满速 0.5 圈/秒）。', code: "var ENGINE = { gearMain: {n:16,R:75}, gearSub: {n:10,R:46.9}, rpmMax: 9000 };\\n// 主齿轮 0.5 圈/秒, 小齿轮反向 ×1.6\\n// 指针角度 = 转速; 刻度线 bumpAmp 外移 + 高亮\\n// 分段弧三态: opacity 0.12 / 0.5 / 1" },
    { title: '老虎机排队绕行', desc: '竖条 6 块步进滚动（900ms 移动/1400ms 停顿），底部方块变扁弹射进 5×5 网格（随机圆弧色），沿外圈 16 格 → 内圈 8 格 → 中心 (2,2) 缩小淡出；多实例同轨迹排队，fresh 方块从顶部滑入防重叠。', code: "// 竖条步进滚动: move/pause 相位状态机\\nslotEject();   // 底部方块变扁弹射（副本）\\n// 状态机: squeeze → fly → grid → vanish\\n// 路径: 外圈 16 格 → 内圈 8 格 → 中心 (2,2)" },
    { title: '风水转盘解谜', desc: '8 同心环 × 每环 8 段弧，颜色 = 外层弧色（对齐基准）初始旋转错位打乱；点击环弧顺时针转 1 格 + 联动环转 k 格（k∈{1,2}，每环最多被 1 环关联），hover 显示 +N 提示，转回对齐（cur%360≡0）弧提亮。', code: "// 点击: 源环 +1 格, 联动环 +k 格\\nfsAddSpin(ring, 1);\\nif (ring.link) fsAddSpin(fsRings[ring.link.target], ring.link.steps);\\n// 对齐判定: cur % 360 ≡ 0 → brightness(2)" },
  ];
  var SEG_NUM = SCENES.length;   // 段数由场景数组驱动（当前 8）

  // ===== 725 圆弧分段参数（可调） =====
  var ARC = {
    cx: 375, cy: 375,   // 圆心（viewBox 0 0 750 750）
    r: 357.5,           // 715 直径 → 半径
    width: 5,           // 向内弧线宽度
    segments: SEG_NUM,  // 分段数（= SCENES.length，动态）
    gapDeg: 1,          // 段间空白角度（可调）
    colors: [           // 每段颜色（可自定义，已调暗 ~35%）
      '#16899B', '#539EA6', '#228963', '#6A9622',
      '#A37C17', '#9F4A76', '#6D5AA3', '#AAAAAA',
    ],
  };

  // ===== 667 刻度线参数（可调） =====
  var TICKS = {
    r: 333.5,           // 667 直径 → 半径
    len: 15,            // 刻度线长度（向圆心延伸）
    count: 180,         // 刻度线数量（可调，240 → 180 减少 25%）
    width: 2,           // 刻度线宽度
    startDeg: -90,      // 起点角度：12 点方向
  };

  // ===== 手抖圆环参数（可调） =====
  var RINGS = {
    radii: [310, 305, 290, 295, 275, 270],  // 6 个圆环半径（由外到内）
    width: 2,           // 线条宽度
    jitter: 0.8,        // 随机抖动幅度（px，减小后更接近圆）
    step: 2,            // 每多少度取一个点（越小越精细）
    colors: [           // 每环颜色（可自定义）
      '#000000', '#000000', '#000000',
      '#000000', '#000000', '#000000',
    ],
  };

  // ===== 点阵背景参数（可调） =====
  var DOTS = {
    gap: 30,            // 点阵间隔（方形网格）
    radius: 270,        // 点阵覆盖半径（最小圆环处消失）
    dotR: 2.5,          // 小圆点半径
    minOpacity: 0.06,   // 低于此透明度直接消失（不渲染）
  };

  // ===== 横向刻度尺参数（圆外右下角容器，350×40，分段与圆弧对应） =====
  var RULER = {
    w: 350, h: 40,      // 容器尺寸
    segments: SEG_NUM,  // 分段数（与 ARC.segments 同步，动态）
    ticksPerSeg: 10,    // 每段内竖线条数（5 → 10 密集度翻倍）
    tickH: 10,          // 刻度线高度（容器中间）
    tickW: 2,           // 刻度线宽度
    color: '#393837',   // 非高亮部分颜色
    slider: true,       // 是否显示定位滑块
    sliderMult: 2,      // 滑块宽度 = 刻度线宽度 × 倍数
    sliderH: 12,        // 滑块高度
    sliderBright: 1.26, // 滑块亮度（弧色高亮 1.2 再调亮 5% = 1.2 × 1.05）
  };

  (function () {
    var NS = 'http://www.w3.org/2000/svg';
    var a = ARC;
    var ru = RULER;

    // 颜色工具：hex 变暗（factor < 1 调暗）
    function darken(hex, factor) {
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      r = Math.round(r * factor);
      g = Math.round(g * factor);
      b = Math.round(b * factor);
      return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }

    // ============ 三区域初始化：左侧卡片列表 / 代码卡片 ============
    var leftList = document.getElementById('lab-left-list');
    var codeCard = document.getElementById('lab-code-card');
    var leftCards = [];     // 左侧卡片元素
    var cardStep = window.innerHeight;  // 左侧卡片步进 = 整屏高度（每张卡片占满一屏）

    // 左侧卡片 + 代码卡片（内容取 SCENES；中心场景文字已删除，仅保留色块动画）
    for (var sc = 0; sc < SCENES.length; sc++) {
      var sdata = SCENES[sc];
      // 左侧卡片
      var card = document.createElement('div');
      card.className = 'lab-left-card';
      card.innerHTML = '<div class="lc-title">' + sdata.title + '</div>' + sdata.desc;
      leftList.appendChild(card);
      leftCards.push(card);
    }
    // 初始显示第一段代码卡片
    codeCard.textContent = SCENES[0].code;
    codeCard.classList.add('show');

    // ============ 中心旋转色块 + 12 图形随机游走（anime.js 驱动） ============
    var squareEl = document.getElementById('lab-square');
    if (squareEl) {
      squareEl.style.background = a.colors[0];
      squareEl.style.filter = 'brightness(1.42)';
    }
    // 12 图形：6 类形状 × 2（每类第 1 个实心、第 2 个线框）= 6 实心 + 6 线框
    var shapesSvg = document.getElementById('lab-shapes');
    var shapesEls = [];   // 12 个图形元素（SVG，位于 g[translate 375 375] 内，中心=圆心）
    if (shapesSvg) {
      var NS2 = 'http://www.w3.org/2000/svg';
      var shapeG = document.createElementNS(NS2, 'g');
      shapeG.setAttribute('transform', 'translate(375 375)');
      shapesSvg.appendChild(shapeG);
      function buildShape(type) {
        var el;
        if (type === 'circle') {
          el = document.createElementNS(NS2, 'circle');
          el.setAttribute('r', 20);
        } else if (type === 'triangle') {
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-20 17.3,10 -17.3,10');
        } else if (type === 'rect') {
          // 正方形：36×36 居中，圆角 6px
          el = document.createElementNS(NS2, 'rect');
          el.setAttribute('x', -18); el.setAttribute('y', -18);
          el.setAttribute('width', 36); el.setAttribute('height', 36);
          el.setAttribute('rx', 6);
        } else if (type === 'diamond') {
          // 菱形：更锐利（宽 24 高 44，顶点更尖）
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-22 12,0 0,22 -12,0');
        } else if (type === 'star') {
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-22 5.8,-7 22,-7 9,2 13.6,18 0,10 -13.6,18 -9,2 -22,-7 -5.8,-7');
        } else if (type === 'crossarc') {
          // 十字圆弧：4 段 90° 弧同向首尾相连，连接点 = 十字四臂端点；弧半径加大 → 弧更平直、四瓣更锐利
          el = document.createElementNS(NS2, 'path');
          el.setAttribute('d', 'M -14 0 A 20 20 0 0 1 0 14 A 20 20 0 0 1 14 0 A 20 20 0 0 1 0 -14 A 20 20 0 0 1 -14 0');
        }
        el.setAttribute('class', 'shape');
        return el;
      }
      var shapeTypes = ['circle', 'triangle', 'rect', 'diamond', 'star', 'crossarc'];
      for (var ti = 0; ti < shapeTypes.length; ti++) {
        for (var vi = 0; vi < 2; vi++) {
          var sel = buildShape(shapeTypes[ti]);
          var solid = vi === 0;   // 每类第 1 个实心、第 2 个线框
          var col = a.colors[ti % a.colors.length];
          if (solid) {
            sel.setAttribute('fill', col);
          } else {
            sel.setAttribute('fill', 'none');
            sel.setAttribute('stroke', col);
            sel.setAttribute('stroke-width', 2.25);  // 线框宽度：原 3 缩小 25%
            sel.setAttribute('stroke-linejoin', 'round');
          }
          shapeG.appendChild(sel);
          shapesEls.push(sel);
        }
      }
    }
    // ============ 椭圆轨迹组（第三段，多条线构成 3D 球） ============
    var ellipseSvg = document.getElementById('lab-ellipse');
    // 20 条椭圆：圆心沿通过圆容器圆心的对角线（y = x，中心 375,375）对称排开（Δ12），半径由小到大再到小（球体轮廓）
    // 两端（第一/最后）半径缩小一倍 rx=50，中间最大 rx=225 不变，其他按比例（rx = 50 + 175×(1−t²)）
    // 出现时机：第 i 条 drawRange.start = i×0.0125
    var ELLIPSES = [];
    var ELL_N = 20;
    var ELL_MID = (ELL_N - 1) / 2;
    for (var ei0 = 0; ei0 < ELL_N; ei0++) {
      var et = (ei0 - ELL_MID) / ELL_MID;               // -1 ~ 1
      var erx = 57.5 + 201.25 * (1 - et * et);          // 等比放大 1.15 倍：两端 57.5、中间最大 258.75
      var shift = 48 * (ei0 - ELL_MID) / ELL_MID;       // 沿对角线按比例移动（再继续上移）：第一个 -48、中间最大 0（锚定）、最后 +48
      // 出现时机：第 i 条 drawRange.start = i×0.0125；第二条特殊：第一条路径到 37.5%（inSeg 0.0375）时出现
      var eStart = (ei0 === 1) ? 0.0375 : ei0 * 0.0125;
      ELLIPSES.push({
        cx: 375 + (ei0 - ELL_MID) * 12 + shift,
        cy: 375 + (ei0 - ELL_MID) * 12 + shift,
        rx: erx,
        ry: Math.round(erx * 0.2),                      // 扁度 0.2
        rotate: -45,
        color: a.colors[2 % a.colors.length],
        drawRange: { start: eStart, end: 1 },
        drawScale: 2.5
      });
    }
    var ellipseItems = [];   // { path, len, drawP, cfg }
    if (ellipseSvg) {
      var elNS = 'http://www.w3.org/2000/svg';
      for (var ei = 0; ei < ELLIPSES.length; ei++) {
        var ec = ELLIPSES[ei];
        // 画笔轨迹：椭圆 path（中心 ec.cx/cy），dashoffset 由滚动进度驱动（手动）
        var tp = document.createElementNS(elNS, 'path');
        tp.setAttribute('d', 'M ' + (ec.cx - ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx + ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx - ec.rx) + ' ' + ec.cy);
        tp.setAttribute('fill', 'none');
        tp.setAttribute('stroke', ec.color);
        tp.setAttribute('stroke-width', 3.6);
        tp.setAttribute('stroke-linecap', 'round');
        tp.style.filter = 'brightness(1.42) drop-shadow(0 0 6px ' + ec.color + ')';
        tp.setAttribute('transform', 'rotate(' + ec.rotate + ' ' + ec.cx + ' ' + ec.cy + ')');
        ellipseSvg.appendChild(tp);
        var tlen = (tp.getTotalLength && tp.getTotalLength()) || 1240;
