    width: 10px;
    height: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #2C2C2C;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb {
    background: #D1D1D1;
    border-radius: 5px; /* 宽 10px 的一半 → 上下半圆 */
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #E8E8E8;
  }
  /* Firefox */
  * {
    scrollbar-width: auto;
    scrollbar-color: #D1D1D1 #2C2C2C;
  }

  /* 深色画布：背景 #252423 衬托动画效果 */
  html, body {
    height: 100%;
    margin: 0;
  }
  /* 内容容器全宽：覆盖 BaseLayout 无侧边栏时的 max-w-2xl 限宽（测试画布需要整页空间） */
  header ~ main.max-w-2xl {
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .anim-lab {
