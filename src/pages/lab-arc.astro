      // 竖条方块：n 块圆角矩形，ph 从 0(顶) 到 (n-1)*step(底) 均匀排布（初始填满）
      for (var si = 0; si < nsg.n; si++) {
        slotBars.push({ el: makeBar(si * slotsStep), ph: si * slotsStep, phStart: si * slotsStep, fresh: false });
      }
      // 5x5 网格：25 个空心圆角格子
      var cs = nsg.cell + nsg.cellGap;
      for (var gr = 0; gr < 5; gr++) {
        for (var gc = 0; gc < 5; gc++) {
          var cell = document.createElementNS(NS, 'rect');
          cell.setAttribute('x', nsg.gridCx - 2 * cs + gc * cs);
          cell.setAttribute('y', nsg.gridCy - 2 * cs + gr * cs);
          cell.setAttribute('width', nsg.cell);
          cell.setAttribute('height', nsg.cell);
          cell.setAttribute('rx', 6);
          cell.setAttribute('fill', 'rgba(109, 90, 163, 0.22)');   // 默认填满（暗紫），轨迹亮方块覆盖其上
          cell.setAttribute('stroke', 'rgba(109, 90, 163, 0.5)');
          cell.setAttribute('stroke-width', 1.2);
          slotsSvg.appendChild(cell);
        }
      }
    }
    // 格坐标 (c, r) → 格中心像素（左上角 + 半格，方块中心对齐格子中心）
    function slotCellPos(c, r) {
      var cs = SLOTS.cell + SLOTS.cellGap;
      return { x: SLOTS.gridCx - 2 * cs + c * cs + SLOTS.cell / 2, y: SLOTS.gridCy - 2 * cs + r * cs + SLOTS.cell / 2 };
    }
    // 触发挤出：底部方块副本 变扁 → 弹射到网格外圈起点 → 逐格推箱子 → 中心消失
    // 弹射方块从竖条出来时就带一个随机圆弧色（移动全程保留）
    function slotEject() {
      if (!slotsSvg) return;
      var nsg = SLOTS;
      var p0 = slotCellPos(SLOT_PATH[0][0], SLOT_PATH[0][1]);   // 落点 = 轨迹起点（网格底部）
      var flyEl = document.createElementNS(NS, 'rect');
      flyEl.setAttribute('width', nsg.w);
      flyEl.setAttribute('height', nsg.h);
      flyEl.setAttribute('rx', nsg.rx);
      flyEl.setAttribute('fill', ARC.colors[Math.floor(Math.random() * ARC.colors.length)]);
      flyEl.style.filter = 'brightness(1.5)';
      slotsSvg.appendChild(flyEl);
      var fly = {
        el: flyEl,
        phase: 'squeeze',          // squeeze → fly → grid → vanish
        t0: performance.now(),
        sx: nsg.barX,
        sy: slotsBaseY + (nsg.n - 1) * slotsStep + nsg.h / 2,   // 竖条底部槽位中心（与滚动方块落点对齐）
        ex: p0.x, ey: p0.y,
        gx: 0, gy: 0, gi: 0, gPhase: 'move', tLast: 0, posFrac: 0,
        vanishT: 0,
      };
      flyEl.setAttribute('x', fly.sx - nsg.w / 2);
      flyEl.setAttribute('y', fly.sy - nsg.h / 2);
      slotFlies.push(fly);
    }
    function slotsLoop(t) {
      if (slotsSvg) {
        var nsg = SLOTS;
        var dt = Math.min(t - (slotsLastT || t), 100);
        slotsLastT = t;
        // 1) 竖条步进滚动：平滑移动一步（moveMs）→ 停顿（pauseMs）→ 再移一步
        slotsPhaseT += dt;
        if (slotsPhase === 'move') {
          var bottomPh = (nsg.n - 1) * slotsStep;
          // 进入 move 的第一帧：弹射底部方块（ph>=bottomPh），补入 fresh 顶部方块
          if (slotsPhaseT <= dt) {
            var ejectIdx = -1;
            for (var bi0 = 0; bi0 < slotBars.length; bi0++) {
              if (slotBars[bi0].ph >= bottomPh) { ejectIdx = bi0; break; }
            }
            if (ejectIdx >= 0) {
              slotEject();   // 弹射副本从竖条出来时随机带圆弧色
              if (slotBars[ejectIdx].el.parentNode) slotBars[ejectIdx].el.parentNode.removeChild(slotBars[ejectIdx].el);
              slotBars.splice(ejectIdx, 1);
              // 顶部补入新方块：fresh=true，从竖条上方一格平移滑入（本步不参与滚动）
              var freshEl = makeBar(0);
              freshEl.setAttribute('y', slotsBaseY - slotsStep);
              slotBars.push({ el: freshEl, ph: 0, phStart: 0, fresh: true });
            }
          }
          // 平滑移动一步（moveMs）：非 fresh 方块 ph+step 平滑移动；fresh 方块停顶部
          var mp = Math.min(slotsPhaseT / nsg.moveMs, 1);
          var easeM = mp * mp * (3 - 2 * mp);   // smoothstep 缓动
          for (var bi = 0; bi < slotBars.length; bi++) {
            if (slotBars[bi].fresh) {
              // 新补入：从竖条上方平移滑入顶部槽位（easeM 0→1：上方一格 → 顶部）
              slotBars[bi].el.setAttribute('y', slotsBaseY - slotsStep + slotsStep * easeM);
            } else {
              slotBars[bi].el.setAttribute('y', slotsBaseY + slotBars[bi].phStart + slotsStep * easeM);
            }
          }
          if (mp >= 1) {
            // 步完成：ph 推进（fresh 方块 ph 保持 0，下一轮参与移动）
            for (var bi2 = 0; bi2 < slotBars.length; bi2++) {
              if (!slotBars[bi2].fresh) slotBars[bi2].ph = slotBars[bi2].phStart + slotsStep;
              slotBars[bi2].fresh = false;
            }
            slotsPhase = 'pause'; slotsPhaseT = 0;
          }
        } else {
          if (slotsPhaseT >= nsg.pauseMs) {
            slotsPhase = 'move'; slotsPhaseT = 0;
            for (var bi3 = 0; bi3 < slotBars.length; bi3++) slotBars[bi3].phStart = slotBars[bi3].ph;
          }
        }
        // 3) 挤出方块状态机：遍历所有在途方块（各自独立推进）
        for (var fi = slotFlies.length - 1; fi >= 0; fi--) {
          var f = slotFlies[fi];
          var age = t - f.t0;
          if (f.phase === 'squeeze') {
            // 变扁：高度 46 → 10（宽度不变）
            var sq = Math.min(age / nsg.squeezeDur, 1);
            var hh = nsg.h * (1 - 0.78 * sq);
            f.el.setAttribute('y', f.sy - hh / 2);
            f.el.setAttribute('height', hh);
            if (sq >= 1) { f.phase = 'fly'; f.t0 = t; }
          } else if (f.phase === 'fly') {
            // 弹射：竖条底部 → 网格外圈起点，ease-out，同时恢复原尺寸
            var fp = Math.min(age / nsg.flyDur, 1);
            var fe = 1 - Math.pow(1 - fp, 2);
            var fx = f.sx + (f.ex - f.sx) * fe;
            var fy = f.sy + (f.ey - f.sy) * fe;
            var hh2 = nsg.h * (0.22 + 0.78 * fe);
            f.el.setAttribute('x', fx - nsg.w / 2);
            f.el.setAttribute('y', fy - hh2 / 2);
            f.el.setAttribute('height', hh2);
            if (fp >= 1) {
              f.phase = 'grid';
              f.gi = 0;
              f.gPhase = 'move';
              f.posFrac = 0;
              f.gx = f.ex; f.gy = f.ey;
              f.tLast = t;
              f.el.setAttribute('height', nsg.h);
            }
          } else if (f.phase === 'grid') {
            // 步进平移：每格平滑移动（moveMs）→ 停顿（pauseMs）→ 移动下一格
            if (f.gPhase === 'move') {
              var gp = Math.min((t - f.tLast) / nsg.moveMs, 1);
              var gpe = gp * gp * (3 - 2 * gp);   // smoothstep 缓动
              var ga0 = SLOT_PATH[f.gi], ga1 = SLOT_PATH[f.gi + 1];
              var cc0 = slotCellPos(ga0[0], ga0[1]), cc1 = slotCellPos(ga1[0], ga1[1]);
              var gxe = cc0.x + (cc1.x - cc0.x) * gpe;
              var gye = cc0.y + (cc1.y - cc0.y) * gpe;
              f.el.setAttribute('x', gxe - nsg.w / 2);
              f.el.setAttribute('y', gye - nsg.h / 2);
              if (gp >= 1) {
                f.gi++;
                if (f.gi >= SLOT_PATH.length - 1) {
                  // 内圈最后格 → 网格中心缩小淡出消失
                  f.phase = 'vanish';
                  f.vanishT = t;
                } else {
                  f.gPhase = 'pause';
                  f.tLast = t;
                }
              }
            } else {
              if (t - f.tLast >= nsg.pauseMs) { f.gPhase = 'move'; f.tLast = t; }
            }
          } else if (f.phase === 'vanish') {
            // 内圈最后格 → 网格中心点缩小淡出消失
            var vp = Math.min((t - f.vanishT) / nsg.vanishDur, 1);
            var center = slotCellPos(2, 2);   // 5x5 中心格
            var vw = nsg.w * (1 - vp), vh = nsg.h * (1 - vp);
            f.el.setAttribute('x', center.x - vw / 2);
            f.el.setAttribute('y', center.y - vh / 2);
            f.el.setAttribute('width', vw);
            f.el.setAttribute('height', vh);
            f.el.setAttribute('opacity', 1 - vp);
            if (vp >= 1) {
              if (f.el.parentNode) f.el.parentNode.removeChild(f.el);
              slotFlies.splice(fi, 1);
              continue;
            }
          }
        }
      }
      requestAnimationFrame(slotsLoop);
    }
    var slotsLastT = 0;
    requestAnimationFrame(slotsLoop);


    // ============ 第八段：风水转盘（8 同心环 × 8 段弧，点击联动 + 数字提示，独立 rAF 时间驱动） ============
    var fengshuiSvg = document.getElementById('lab-fengshui');
    var FS = {
      n: 8,                // 环数
      width: 18,           // 弧宽（14 → 18，再增粗）
      gap: 14,             // 环间距（半径步进 32 = width + gap）
      rMin: 25,            // 最内环半径（≈25）
      rMax: 249,           // 最外环半径（≈250，rMin + 7×32）
      segGap: 2,           // 每环段间空隙（角度）
      spinMs: 420,         // 转一格动画时长
      stepDeg: 45,         // 一格角度（顺时针）
    };
    var fsRings = [];      // 每环 { r, grp, spin{cur,target,from,t0,spinning}, link{target,steps}|null, label, hit }
    if (fengshuiSvg) {
      var fsg = FS;
      var fcx = a.cx, fcy = a.cy;
      var fsStep = fsg.width + fsg.gap;    // 半径步进
      // 颜色打乱（Fisher-Yates）
      function fsShuffle(arr) {
        var c = arr.slice();
        for (var si = c.length - 1; si > 0; si--) {
          var sj = Math.floor(Math.random() * (si + 1));
          var st = c[si]; c[si] = c[sj]; c[sj] = st;
        }
        return c;
      }
      // 联动：必定 1 个、最多 2 个独立环（无出边）；其余环各 1 条单向出边
      // 入度 ≤ 1：每个环最多被 1 个环关联（usedTarget 去重）
      // 禁止相互关联：候选排除"已指向自己的环"（A→B 则 B 不能再→A）
      // 步数 1/2 随机
      var indepN = 1 + Math.floor(Math.random() * 2);
      var indepSet = {};
      var shufAll = fsShuffle([0, 1, 2, 3, 4, 5, 6, 7]);
      for (var idi = 0; idi < indepN; idi++) indepSet[shufAll[idi]] = true;
      var usedTarget = {};
      var fsLink = {};
      for (var lki = 0; lki < 8; lki++) {
        if (indepSet[lki]) continue;
        var cands = [];
        for (var cdi = 0; cdi < 8; cdi++) {
          if (cdi === lki) continue;                                  // 不能指向自己
          if (usedTarget[cdi]) continue;                              // 入度 ≤ 1
          if (fsLink[cdi] && fsLink[cdi].target === lki) continue;    // 禁止相互关联
          cands.push(cdi);
        }
        if (!cands.length) continue;   // 极端情况目标全被占：此环不联动
        var lt2 = cands[Math.floor(Math.random() * cands.length)];
        usedTarget[lt2] = true;
        fsLink[lki] = { target: lt2, steps: (Math.random() < 0.5) ? 1 : 2 };
      }
      // 建 8 环
      for (var fri = 0; fri < fsg.n; fri++) {
        var fr = fsg.rMin + fri * fsStep;
        var farcC = 2 * Math.PI * fr;
        var fsegDeg = (360 - fsg.segGap * 8) / 8;
        var fsegLen = farcC * fsegDeg / 360;
        var fsegStep = fsegDeg + fsg.segGap;
        var fgrp = document.createElementNS(NS, 'g');
        var fring = {
          r: fr, grp: fgrp, arcs: [],
          spin: { cur: 0, target: 0, from: 0, t0: 0, spinning: false },
          link: fsLink[fri] || null, label: null, hit: null, aligned: false
        };
        // 1) 槽位暗弧：8 段固定不转（彩色弧的槽底，衬托"弧转动"）
        for (var fsi = 0; fsi < 8; fsi++) {
          var fslot = document.createElementNS(NS, 'circle');
          fslot.setAttribute('cx', fcx); fslot.setAttribute('cy', fcy); fslot.setAttribute('r', fr);
          fslot.setAttribute('fill', 'none');
          fslot.setAttribute('stroke', 'rgba(255,255,255,0.08)');
          fslot.setAttribute('stroke-width', fsg.width);
          fslot.setAttribute('stroke-dasharray', fsegLen + ' ' + (farcC - fsegLen));
          fslot.setAttribute('stroke-dashoffset', -farcC * (fsi * fsegStep) / 360);
          fengshuiSvg.appendChild(fslot);
        }
        // 2) 彩色弧组：8 段弧颜色 = 外层弧色固定顺序（对齐基准），group rotate 驱动转动
        //    打乱 = 每环初始旋转 offset 格（offset×45°），点击转回 offset≡0 即复位
        var fcolors = a.colors.slice();   // 固定外层顺序（不再打乱序列，只靠旋转错位）
        var foff = Math.floor(Math.random() * 8);          // 打乱格数 0~7
        var foffDeg = foff * fsg.stepDeg;
        fring.spin.cur = foffDeg; fring.spin.target = foffDeg;
        for (var fsi2 = 0; fsi2 < 8; fsi2++) {
          var fseg = document.createElementNS(NS, 'circle');
          fseg.setAttribute('cx', fcx); fseg.setAttribute('cy', fcy); fseg.setAttribute('r', fr);
          fseg.setAttribute('fill', 'none');
          fseg.setAttribute('stroke', fcolors[fsi2]);
          fseg.setAttribute('stroke-width', fsg.width);
          fseg.setAttribute('stroke-dasharray', fsegLen + ' ' + (farcC - fsegLen));
          fseg.setAttribute('stroke-dashoffset', -farcC * (fsi2 * fsegStep) / 360);
          fseg.style.filter = 'brightness(1.25)';
          fgrp.appendChild(fseg);
          fring.arcs.push(fseg);
        }
        fgrp.setAttribute('transform', 'rotate(' + foffDeg + ' ' + fcx + ' ' + fcy + ')');
        fengshuiSvg.appendChild(fgrp);
        // 3) 数字提示：环正上方（12 点方向），默认隐藏
        var flb = document.createElementNS(NS, 'text');
        flb.setAttribute('x', fcx);
        flb.setAttribute('y', fcy - fr + fsg.width / 2 - 8);
        flb.setAttribute('text-anchor', 'middle');
        flb.setAttribute('font-size', 11);
        flb.setAttribute('font-weight', 700);
        flb.setAttribute('fill', '#FFFFFF');
        flb.setAttribute('opacity', '0');
        flb.style.pointerEvents = 'none';
        flb.style.filter = 'drop-shadow(0 1px 3px rgba(0,0,0,.85))';
        flb.textContent = '+1';
        fengshuiSvg.appendChild(flb);
        fring.label = flb;
        // 4) 命中层：环形 stroke 带（fill none + stroke 带 = 只命中环带区域，不遮挡内层环），hover/点击区域
        var fhit = document.createElementNS(NS, 'circle');
        fhit.setAttribute('cx', fcx); fhit.setAttribute('cy', fcy);
        fhit.setAttribute('r', fr);
        fhit.setAttribute('fill', 'none');
        fhit.setAttribute('stroke', 'rgba(255,255,255,0.001)');
        fhit.setAttribute('stroke-width', fsg.width + 3);
        fhit.style.pointerEvents = 'stroke';
        fhit.setAttribute('data-native-cursor', 'true');
        fengshuiSvg.appendChild(fhit);
        fring.hit = fhit;
        fsRings.push(fring);
      }
      // 事件绑定（IIFE 捕获，防 var 闭包）
      for (var fei = 0; fei < fsRings.length; fei++) {
        (function (ring) {
          ring.hit.addEventListener('mouseenter', function () { fsShowHint(ring); });
          ring.hit.addEventListener('mouseleave', function () { fsHideHint(); });
          ring.hit.addEventListener('click', function () { fsSpinRing(ring); });
        })(fsRings[fei]);
      }
      // 提示：hover 环 +1，联动目标环 +steps（只显示源环出边，单向）
      function fsShowHint(ring) {
        for (var hli = 0; hli < fsRings.length; hli++) fsRings[hli].label.setAttribute('opacity', '0');
        ring.label.setAttribute('opacity', '1');
        ring.label.textContent = '+1';
        if (ring.link) {
          var tgt = fsRings[ring.link.target];
          tgt.label.setAttribute('opacity', '1');
          tgt.label.textContent = '+' + ring.link.steps;
        }
      }
      function fsHideHint() {
        for (var hli2 = 0; hli2 < fsRings.length; hli2++) fsRings[hli2].label.setAttribute('opacity', '0');
      }
      // 点击：源环转 1 步 + 联动目标转 steps 步
      function fsSpinRing(ring) {
        fsAddSpin(ring, 1);
        if (ring.link) fsAddSpin(fsRings[ring.link.target], ring.link.steps);
      }
      function fsAddSpin(ring, steps) {
        var sp = ring.spin;
        sp.from = sp.cur;              // 从当前显示角平滑续转
        sp.t0 = performance.now();
        sp.target += FS.stepDeg * steps;
        sp.spinning = true;
      }
      // 对齐反馈：环已复位（cur % 360 ≡ 0）时弧提亮（brightness 1.25 → 2），状态变化才改样式
      function fsCheckAligned() {
        for (var cai = 0; cai < fsRings.length; cai++) {
          var car = fsRings[cai];
          if (car.spin.spinning) continue;   // 转动中不判定
          var cal = (Math.abs(car.spin.cur % 360) < 0.01);
          if (cal !== car.aligned) {
            car.aligned = cal;
            var f2 = cal ? 'brightness(2)' : 'brightness(1.25)';
            for (var caj = 0; caj < car.arcs.length; caj++) car.arcs[caj].style.filter = f2;
          }
        }
      }
      // rAF 平滑转动（smoothstep 缓动）
      function fsLoop(t) {
        for (var fli = 0; fli < fsRings.length; fli++) {
          var flr = fsRings[fli], flsp = flr.spin;
          if (!flsp.spinning) continue;
          var fp = Math.min((t - flsp.t0) / FS.spinMs, 1);
          var fe = fp * fp * (3 - 2 * fp);
          flsp.cur = flsp.from + (flsp.target - flsp.from) * fe;
          flr.grp.setAttribute('transform', 'rotate(' + flsp.cur + ' ' + fcx + ' ' + fcy + ')');
          if (fp >= 1) { flsp.cur = flsp.target; flsp.spinning = false; }
        }
        fsCheckAligned();
        requestAnimationFrame(fsLoop);
      }
      requestAnimationFrame(fsLoop);
    }



    // ============ 点阵背景（方形网格小圆点，中心亮边缘暗） ============
    var dotEls = [];   // 已渲染的点（含基准 opacity）
    var svgDots = document.getElementById('lab-dots');
    if (svgDots) {
      var dg = DOTS;
      var cx0 = a.cx, cy0 = a.cy;
      // 从圆心向四周铺方形网格（间隔 gap），点在圆内且 opacity 达标才渲染
      for (var gx = -dg.radius; gx <= dg.radius; gx += dg.gap) {
        for (var gy = -dg.radius; gy <= dg.radius; gy += dg.gap) {
          var dist = Math.sqrt(gx * gx + gy * gy);
          if (dist > dg.radius) continue;                 // 圆外不渲染
          // 亮度随距离衰减：中心最接近弧色，边缘变暗，最暗直接消失
          var t2 = dist / dg.radius;                     // 0 中心 → 1 边缘
          var op = 1 - t2 * t2;                          // 平方衰减
          if (op < dg.minOpacity) continue;              // 最暗直接消失
          var dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', cx0 + gx);
          dot.setAttribute('cy', cy0 + gy);
          dot.setAttribute('r', dg.dotR);
          dot.setAttribute('fill', a.colors[0]);
          dot.setAttribute('opacity', op.toFixed(3));
          svgDots.appendChild(dot);
          dotEls.push(dot);
        }
      }
    }

    // ============ 圆弧分段（每段两层：底层段色 + 顶层高亮进度条） ============
    var arcBases = [];   // 底层：整段（暗/亮弧色，随状态切换）
    var arcTops = [];    // 顶层：高亮进度条（dasharray 按段内进度）
    var C = 0, seg = 0, stepDeg = 0;
    var svgArc = document.getElementById('lab-arc');
    if (svgArc) {
      C = 2 * Math.PI * a.r;              // 周长
      var gap = C * a.gapDeg / 360;       // 空白弧长
      seg = C / a.segments - gap;         // 每段弧长
      stepDeg = 360 / a.segments;
      for (var i = 0; i < a.segments; i++) {
        var rot = 'rotate(' + (i * stepDeg - 90) + ' ' + a.cx + ' ' + a.cy + ')';
        // 底层：整段（初始暗版弧色，细）
        var base = document.createElementNS(NS, 'circle');
        base.setAttribute('cx', a.cx);
        base.setAttribute('cy', a.cy);
        base.setAttribute('r', a.r);
        base.setAttribute('fill', 'none');
        base.setAttribute('stroke', darken(a.colors[i % a.colors.length], 0.35));
        base.setAttribute('stroke-width', 5);
        base.setAttribute('stroke-dasharray', seg + ' ' + C);
        base.setAttribute('transform', rot);
        base.style.transition = 'stroke-width .4s ease';  // 宽度平滑过渡
        svgArc.appendChild(base);
        arcBases.push(base);
        // 顶层：高亮进度条（初始隐藏，dasharray 0；brightness 提亮与段底色区分 + 荧光辉光）
        var top = document.createElementNS(NS, 'circle');
        top.setAttribute('cx', a.cx);
        top.setAttribute('cy', a.cy);
        top.setAttribute('r', a.r);
        top.setAttribute('fill', 'none');
        top.setAttribute('stroke', a.colors[i % a.colors.length]);
        top.setAttribute('stroke-width', 10);
        top.setAttribute('stroke-dasharray', '0 ' + C);
        top.setAttribute('transform', rot);
        top.style.transition = 'stroke-width .4s ease';  // 宽度平滑过渡
        top.style.filter = 'brightness(1.42) drop-shadow(0 0 8px ' + a.colors[i % a.colors.length] + ')';  // 亮度 +5% + 荧光
        svgArc.appendChild(top);
        arcTops.push(top);
      }
    }

    // ============ 667 刻度线（保存引用供圆弧颜色联动） ============
    var svgTicks = document.getElementById('lab-ticks');
    var tickLines = [];   // {el, segIdx} 每条刻度线所属段
    if (svgTicks) {
      var t = TICKS;
      var ticksPerSeg = t.count / a.segments;   // 每段对应的刻度线条数（180/8=22.5）
      var tickColor = darken(a.colors[0], 0.35);  // 初始暗版弧色，后续 updateProgress 联动
      // 刻度线：短刻度几何 20px、30° 长刻度（第四段）几何 40px；显示长度用 stroke-dashoffset 控制
      // 其他段：长短都显示 15px（无长刻度视觉）；第四段：短 20 / 长 40（每 30° 一条）
      var long30 = {};
      for (var l30 = 0; l30 < 12; l30++) long30[Math.round(15 * l30)] = true;   // 每 30° 一条（step 2° → 索引间隔 15）
      for (var i = 0; i < t.count; i++) {
        var ang = (i * (360 / t.count) + t.startDeg) * Math.PI / 180;
        var isLong30 = !!long30[i];
        var geoLen = (isLong30 ? 30 : 20) + ENGINE.bumpAmp;   // 几何长度 = 基础显示 + 隆起余量（短 20→30 / 长 30→40；长 = 短×1.5）
        var line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', a.cx + t.r * Math.cos(ang));
        line.setAttribute('y1', a.cy + t.r * Math.sin(ang));
        line.setAttribute('x2', a.cx + (t.r - geoLen) * Math.cos(ang));
        line.setAttribute('y2', a.cy + (t.r - geoLen) * Math.sin(ang));
        line.setAttribute('stroke', tickColor);
        line.setAttribute('stroke-width', t.width);
        line.setAttribute('stroke-linecap', 'round');
        line.setAttribute('stroke-dasharray', geoLen + ' ' + geoLen);   // 周期 = 几何长度
        line.setAttribute('stroke-dashoffset', String(geoLen - 15));    // 初始显示 15px（从外圈向内画 15）
        // 无 transition：dashoffset 每帧被隆起驱动，CSS 过渡会拖慢/抹平动态变化（2026-08-11 实测）
        // 记录所属段号 + 角度 + 长刻度标记（第四段生长到满长）
        tickLines.push({ el: line, ang: ang, isLong30: isLong30, segIdx: Math.floor(i / ticksPerSeg) });
        svgTicks.appendChild(line);
      }
      // 12 点起始刻度线保持高亮标记
      if (tickLines[0]) tickLines[0].el.style.filter = 'brightness(1.2)';
    }

    // ============ 手抖圆环 ============
    var svgRings = document.getElementById('lab-rings');
    if (svgRings) {
      var rg = RINGS;
      for (var rIdx = 0; rIdx < rg.radii.length; rIdx++) {
        var baseR = rg.radii[rIdx];
        var d = '';
        var points = Math.round(360 / rg.step);
        for (var p = 0; p <= points; p++) {
          var ang = p * rg.step * Math.PI / 180;
          var jit = (Math.random() * 2 - 1) * rg.jitter;
          var rr = baseR + jit;
          var x = (a.cx + rr * Math.cos(ang)).toFixed(2);
          var y = (a.cy + rr * Math.sin(ang)).toFixed(2);
          d += (p === 0 ? 'M' : 'L') + x + ' ' + y;
        }
        d += 'Z';
        var ring = document.createElementNS(NS, 'path');
        ring.setAttribute('d', d);
        ring.setAttribute('fill', 'none');
        ring.setAttribute('stroke', rg.colors[rIdx % rg.colors.length]);
        ring.setAttribute('stroke-width', rg.width);
        ring.setAttribute('stroke-linejoin', 'round');
        svgRings.appendChild(ring);
      }
    }

    // ============ 横向刻度尺 + 滑块 + hover 预览 ============
    var svgRuler = document.getElementById('lab-ruler-svg');
    var sliderEl = null;   // 定位滑块（跟随进度）
    var previewEl = null;  // hover 预览滑块
    var rulerEl = document.getElementById('lab-ruler');
    var sliderX0 = 0;      // 滑块初始 x
    var sw = 0, sy1 = 0;

    if (svgRuler) {
      var segW = ru.w / ru.segments;
      var y1 = (ru.h - ru.tickH) / 2;
      var y2 = y1 + ru.tickH;
      var first = true;
      for (var s = 0; s < ru.segments; s++) {
        for (var t2 = 0; t2 < ru.ticksPerSeg; t2++) {
          var x = s * segW + 6 + t2 * ((segW - 12) / (ru.ticksPerSeg - 1));
          var line = document.createElementNS(NS, 'line');
          line.setAttribute('x1', x); line.setAttribute('y1', y1);
          line.setAttribute('x2', x); line.setAttribute('y2', y2);
          line.setAttribute('stroke-width', ru.tickW);
          line.setAttribute('stroke-linecap', 'round');
          if (t2 === 0) {
            line.setAttribute('stroke', a.colors[s % a.colors.length]);
            if (first) {
              line.style.filter = 'brightness(1.2)';
              first = false;
              sliderX0 = x;
            }
          } else {
            line.setAttribute('stroke', ru.color);
          }
          svgRuler.appendChild(line);
        }
      }
      // 定位滑块（进度）
      if (ru.slider) {
        sliderEl = document.createElementNS(NS, 'rect');
        sw = ru.tickW * ru.sliderMult;
        sy1 = (ru.h - ru.sliderH) / 2;
        sliderEl.setAttribute('x', sliderX0 - sw / 2);
        sliderEl.setAttribute('y', sy1);
        sliderEl.setAttribute('width', sw);
        sliderEl.setAttribute('height', ru.sliderH);
        sliderEl.setAttribute('rx', sw / 2);
        sliderEl.setAttribute('fill', a.colors[0]);
        sliderEl.style.filter = 'brightness(' + ru.sliderBright + ')';
        svgRuler.appendChild(sliderEl);
      }
      // hover 预览滑块（初始隐藏：位于当前滑块位置、尺寸 60%，mousemove 过渡到目标并放大）
      previewEl = document.createElementNS(NS, 'rect');
      previewEl.setAttribute('x', sliderX0 - sw / 2);
      previewEl.setAttribute('y', sy1);
      previewEl.setAttribute('width', sw * 0.6);
      previewEl.setAttribute('height', ru.sliderH * 0.6);
      previewEl.setAttribute('rx', sw / 2);
      previewEl.setAttribute('fill', a.colors[0]);
      previewEl.style.filter = 'brightness(0.95)';  // 变暗 5%
      previewEl.style.opacity = '0';
      previewEl.style.transition = 'opacity .2s ease, x .25s ease-out, width .25s ease-out, height .25s ease-out';
      svgRuler.appendChild(previewEl);
    }

    // ============ 进度驱动（wheel 滚轮，页面固定 100vh；rAF 插值平滑） ============
    var target = 0;     // 目标进度（wheel/点击直接改）
    var current = 0;    // 当前渲染进度（rAF 每帧逼近 target）
    var rafId = null;   // 动画帧句柄
    var lastIdx = -1;   // 上次渲染的段号（场景/代码卡片切换检测）
    var BASE_W = 5;     // 基础宽度（未到段 / 已过段）
    var GROW_W = 10;    // 当前段整段宽度（基础 + 5）

    function updateProgress() {
      var progress = current;  // 用当前渲染进度
      var total = a.segments;
      var idx = Math.min(Math.floor(progress * total), total - 1);  // 当前段
      var inSeg = progress * total - idx;                           // 段内 0~1

      for (var i = 0; i < total; i++) {
        var base = arcBases[i];
        var top = arcTops[i];
        var col = a.colors[i % a.colors.length];
        if (i < idx) {
          // 已过段：弧色保持高亮 + 荧光（顶层整段显示），宽度恢复基础宽
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          top.setAttribute('stroke-width', BASE_W);
          top.setAttribute('stroke-dasharray', seg + ' ' + C);  // 顶层整段 → 荧光保留
        } else if (i === idx) {
          // 当前段：整段宽度 +5，高亮进度条按 inSeg 移动填充
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', GROW_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          var fillLen = seg * inSeg;   // 段内进度条长度（0 → seg）
          top.setAttribute('stroke-width', GROW_W);
          top.setAttribute('stroke-dasharray', fillLen + ' ' + (C - fillLen));
        } else {
          // 未到段：暗版弧色，基础宽，无进度条（初始可见不消失）
          base.setAttribute('stroke', darken(col, 0.35));
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          top.setAttribute('stroke-dasharray', '0 ' + C);
        }
      }

      // 定位滑块：x = progress × 容器宽，颜色 = 当前段弧色高亮版
      if (sliderEl) {
        var sx = progress * ru.w;
        sliderEl.setAttribute('x', sx - sw / 2);
        sliderEl.setAttribute('fill', a.colors[idx % a.colors.length]);
      }

      // 667 刻度线整体同色变化：全部一起变为当前圆弧（当前段）的颜色；第四段跳过（stroke 由 engineSpin 统一管：高亮+外移同步）
      var curColor = a.colors[idx % a.colors.length];
      if (idx !== 5) {
        for (var j = 0; j < tickLines.length; j++) {
          tickLines[j].el.setAttribute('stroke', curColor);
        }
      }

      // 点阵背景：整体变为当前弧色（各点 opacity 基准不变，随位置固定）
      for (var k = 0; k < dotEls.length; k++) {
        dotEls[k].setAttribute('fill', curColor);
      }

      // 左侧介绍列表：随进度连续上移（滚到段 N 第 N 张对齐，上移消失、下一个浮现）
      if (leftList) {
        leftList.style.transform = 'translateY(' + (-progress * (SCENES.length - 1) * cardStep) + 'px)';
      }
      // 中心旋转色块：只关联第一段圆弧（idx 0 显示，进入下一段自动隐藏）
      if (squareEl) {
        squareEl.style.opacity = (idx === 0) ? '1' : '0';
      }
      // 12 图形随机游走：只关联第二段圆弧（idx 1 显示，其他段隐藏）
      if (shapesSvg) {
        shapesSvg.style.opacity = (idx === 1) ? '1' : '0';
      }
      // 椭圆轨迹组（第三段）：每条线 画(0~1) → 保持(1~2) → 擦除(2~3) → 消失；第二条在第一条画到半圆（inSeg 0.05）时出现
      if (ellipseSvg) {
        if (idx === 2) {
          ellipseSvg.style.opacity = '1';
          for (var eii = 0; eii < ellipseItems.length; eii++) {
            var item = ellipseItems[eii];
            var ec = item.cfg;
            var edr = ec.drawRange;
            // 区间映射 × drawScale：0~1 画、1~2 保持、2~3 擦除
            var eTgt = (edr.end > edr.start) ? Math.max((inSeg - edr.start) / (edr.end - edr.start), 0) * ec.drawScale : 0;
            var eDiff = eTgt - item.drawP;
            var eMax = 0.05;
            item.drawP += (eDiff > 0) ? Math.min(eDiff, eMax) : Math.max(eDiff, -eMax);
            item.path.setAttribute('stroke-dasharray', item.len + ' ' + item.len);
            // 擦除完成后彻底消失（不循环重画）：擦除加快半圈后（drawP ≥ 2.5）消失
            item.path.style.opacity = (item.drawP >= 2.5) ? '0' : '1';
            if (item.drawP <= 1) {
              // 第一圈：完整椭圆线条逐渐画出（dashoffset L→0）
              item.path.setAttribute('stroke-dashoffset', item.len * (1 - item.drawP));
            } else if (item.drawP <= 2) {
              // 第二圈：椭圆保持完整（不擦除、无弧段）
              item.path.setAttribute('stroke-dashoffset', 0);
            } else {
              // 第三圈起：从起始位置开始擦除（加快半圈：占 drawP 0.5 单位，2~2.5；dashoffset 0→-L）
              var eraseP = (item.drawP - 2) / 0.5;
              item.path.setAttribute('stroke-dashoffset', -item.len * eraseP);
            }
          }
        } else {
          ellipseSvg.style.opacity = '0';
          for (var eii2 = 0; eii2 < ellipseItems.length; eii2++) ellipseItems[eii2].drawP = 0;
        }
      }
      // 引擎仪表盘（第六段）：idx 5 显示，其他段隐藏（运转状态由 engineSpin 循环按 current 实时驱动）
      if (engineSvg) engineSvg.style.opacity = (idx === 5) ? '1' : '0';
      if (counterEl) counterEl.style.opacity = (idx === 5) ? '1' : '0';
      // 闭合赛道（第四段）：idx 3 显示，其他段隐藏（运转由 trackLoop 常驻 rAF 驱动）
      if (trackSvg) trackSvg.style.opacity = (idx === 3) ? '1' : '0';
      if (trackMenu) {
        trackMenu.style.opacity = (idx === 3) ? '1' : '0';
        trackMenu.style.pointerEvents = (idx === 3) ? 'auto' : 'none';
      }
      // 绽开特效（第五段）：idx 4 显示，其他段隐藏（burstLoop 常驻 rAF 驱动）
      if (burstSvg) burstSvg.style.opacity = (idx === 4) ? '1' : '0';

      // 老虎机竖条 + 4x4 网格（第七段）：idx 6 显示，其他段隐藏（slotsLoop 常驻 rAF 驱动）
      if (slotsSvg) slotsSvg.style.opacity = (idx === 6) ? '1' : '0';

      // 风水转盘（第八段）：idx 7 显示，其他段隐藏（fsLoop 常驻 rAF 驱动）
      if (fengshuiSvg) fengshuiSvg.style.opacity = (idx === 7) ? '1' : '0';
      // 第八段隐藏背景点阵（风水转盘区域不需要背景小点）
      if (svgDots) svgDots.style.opacity = (idx === 7) ? '0' : '1';

      // 代码卡片 + 左侧卡片高亮：idx 变化时切换（中心场景文字已删除）
      if (lastIdx !== idx) {
        lastIdx = idx;
        // 第四段：短刻度显示 20px、30° 长刻度显示 40px（offset = bumpAmp 余量）；其他段长短统一显示 15px —— 仅段切换时变化
        for (var tli = 0; tli < tickLines.length; tli++) {
          var tl = tickLines[tli];
          var tlOff = (idx === 5) ? ENGINE.bumpAmp : ((tl.isLong30 ? 30 : 20) + ENGINE.bumpAmp - 15);
          tl.el.setAttribute('stroke-dashoffset', tlOff);
        }
        if (codeCard && SCENES[idx]) {
          codeCard.textContent = SCENES[idx].code;
          codeCard.classList.remove('show');
          // 触发重排后重新显示（浮入动画）
          void codeCard.offsetWidth;
          codeCard.classList.add('show');
        }
        // 左侧当前卡片高亮
        for (var n = 0; n < leftCards.length; n++) {
          leftCards[n].style.borderLeftColor = (n === idx) ? curColor : '#22D3EE';
          leftCards[n].style.opacity = (n === idx) ? '1' : '0.55';
        }
      }
    }

    // rAF 插值：每帧让 current 平滑逼近 target（滚动停止后自然减速滑行）
    function tick() {
      var diff = target - current;
      if (Math.abs(diff) < 0.0008) {
        current = target;
        updateProgress();
        rafId = null;
        return;
      }
      current += diff * 0.08;   // 插值系数：越小越慢越平滑（0.18 → 0.08）
      updateProgress();
      rafId = requestAnimationFrame(tick);
    }
    function setProgress(p) {
      target = Math.min(Math.max(p, 0), 1);
      if (rafId === null) rafId = requestAnimationFrame(tick);
    }

    updateProgress();

    // wheel 滚轮驱动（页面固定，直接改目标进度；向下滚 deltaY>0 → 进度增加）
    window.addEventListener('wheel', function (e) {
      e.preventDefault();
      var step = e.deltaY > 0 ? 0.01 : -0.01;   // 滚轮灵敏度（减慢：0.02 → 0.01）
      setProgress(target + step);
    }, { passive: false });

    // ============ hover 预览滑块 ============
    if (rulerEl && previewEl && sliderEl) {
      rulerEl.addEventListener('mousemove', function (e) {
        var rect = rulerEl.getBoundingClientRect();
        var px = Math.min(Math.max(e.clientX - rect.left, 0), ru.w);
        var p2 = px / ru.w;
        var idx = Math.min(Math.floor(p2 * a.segments), a.segments - 1);
        // 预览滑块：从当前滑块位置移向鼠标并放大，颜色 = 当前弧段色变暗 5%
        previewEl.setAttribute('x', px - sw / 2);
        previewEl.setAttribute('width', sw);
        previewEl.setAttribute('height', ru.sliderH);
        previewEl.setAttribute('fill', a.colors[idx % a.colors.length]);
        previewEl.style.opacity = '1';
      });
      rulerEl.addEventListener('mouseleave', function () {
        previewEl.style.opacity = '0';
      });
      // 点击：跳转进度到对应位置（平滑插值）
      rulerEl.addEventListener('click', function (e) {
        var rect = rulerEl.getBoundingClientRect();
        var px = Math.min(Math.max(e.clientX - rect.left, 0), ru.w);
        setProgress(px / ru.w);
      });
    }
  })();
</script>

<style is:global>
  /* 自定义滚动条：轨道 #2C2C2C、滑块 #D1D1D1、宽 10px、滑块两端半圆 */
