---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ProfileSidebar from '../../components/ProfileSidebar.astro';
import { getBlogData } from '../../lib/blog-data';
import { buildTaxonomy } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const all = await getCollection('posts', ({ data }) => !data.draft);
  const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const tags = buildTaxonomy(posts, 'tag');

  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      name: tag.name,
      count: tag.count,
      posts: posts.filter((p) => p.data.tags?.includes(tag.name)),
      allTags: tags,
    },
  }));
}

const { name, count, posts, allTags } = Astro.props;
const { postCount, tagCount, categoryCount, recentPosts } = await getBlogData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentSlug = Astro.params.slug;
---

<BaseLayout
  title={`标签：${name} - 摸鱼骑士 知识库`}
  description={`标签「${name}」下的 ${count} 篇文章。`}
>
  <ProfileSidebar
    slot="sidebar"
    postCount={postCount}
    tagCount={tagCount}
    categoryCount={categoryCount}
    recentPosts={recentPosts}
  />

  <div>
    <header class="page-head">
      <a href={`${base}/tags`} class="page-head__back">← 全部标签</a>
      <span class="page-head__eyebrow">Tag</span>
      <h1 class="page-head__title">#{name}</h1>
      <p class="page-head__lead">共 {count} 篇文章</p>
    </header>

    <div class="flex flex-col gap-3">
      {posts.map((post) => <PostCard post={post} showDateRail />)}
    </div>

    {
      allTags.length > 1 && (
        <div class="mt-10 border-t border-[var(--rule)] pt-6">
          <div class="section-label">其他标签</div>
          <div class="flex flex-wrap gap-2">
            {allTags
              .filter((t) => t.slug !== currentSlug)
              .map((t) => (
                <a href={`${base}/tags/${t.slug}`} class="tag-chip">
                  {t.name}
                  <span class="ml-1 opacity-50">{t.count}</span>
                </a>
              ))}
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
