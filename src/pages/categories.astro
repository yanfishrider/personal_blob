---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { getBlogData } from '../lib/blog-data';
import { buildTaxonomy } from '../lib/taxonomy';

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const categories = buildTaxonomy(posts, 'category');

const { postCount, tagCount, categoryCount, recentPosts } = await getBlogData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="分类 - 摸鱼骑士 知识库" description="按分类浏览全部文章。">
  <ProfileSidebar
    slot="sidebar"
    postCount={postCount}
    tagCount={tagCount}
    categoryCount={categoryCount}
    recentPosts={recentPosts}
  />

  <div>
    <header class="page-head">
      <span class="page-head__eyebrow">Categories</span>
      <h1 class="page-head__title">分类</h1>
      <p class="page-head__lead">共 {categories.length} 个分类。</p>
    </header>

    <div class="cat-grid">
      {
        categories.map((cat, i) => (
          <a href={`${base}/categories/${cat.slug}`} class="cat-card">
            <span class="cat-card__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="cat-card__name">{cat.name}</span>
            <span class="cat-card__count">{cat.count} 篇</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
  }
  .cat-card {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 18px 18px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cat-card:hover {
    border-color: var(--accent-soft);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .cat-card__index {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .cat-card__name {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--ink);
  }
  .cat-card__count {
    margin-left: auto;
    font-size: 11px;
    color: var(--ink-4);
  }
</style>
