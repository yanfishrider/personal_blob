    height: min(750px, 92vw, 92vh);
    border-radius: 50%;
    border: 2px solid #000;
    flex-shrink: 0;
  }
  /* 内部同心圆：700×700（外圆减 50px），仅黑色线条，随外圆自适应缩放 */
  .lab-circle-inner {
    position: absolute;
