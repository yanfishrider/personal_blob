---
// animation-lab.astro — 动画展示馆壳页面：左侧菜单 + 右侧 iframe（DIY 展示）
// 三个内容页：lab-arc.astro（圆弧动画）/ lab-nier.astro（NieR 加载动画）/ lab-p3re.astro（P3RE 风格动画）
// 菜单项在 MENU 数组注册即可扩展；hash（#arc/#nier/#p3re）记忆当前选中，刷新恢复
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="动画展示馆" description="动画 DIY 展示：圆弧动画 / NieR / P3RE">
  <div id="lab-shell" class="lab-shell">
    <nav id="lab-menu" class="lab-menu">
      <div class="lab-menu-head">
        <span class="lab-menu-title">动画馆</span>
        <span class="lab-menu-sub">ANIMATION<br/>GALLERY</span>
      </div>
      <div class="lab-menu-list">
        <button class="lab-menu-item" data-key="arc" data-num="01">
          <span class="lm-num">01</span><span class="lm-name">圆弧动画</span>
        </button>
        <button class="lab-menu-item" data-key="nier" data-num="02">
          <span class="lm-num">02</span><span class="lm-name">NieR 加载动画</span>
        </button>
        <button class="lab-menu-item" data-key="p3re" data-num="03">
          <span class="lm-num">03</span><span class="lm-name">P3RE 风格动画</span>
        </button>
        <button class="lab-menu-item" data-key="login" data-num="04">
          <span class="lm-num">04</span><span class="lm-name">互动登录</span>
        </button>
      </div>
      <div class="lab-menu-foot">滚轮/点击驱动各动画<br/>以 iframe 独立运行</div>
    </nav>
    <div class="lab-frame-wrap">
      <iframe id="lab-frame" class="lab-frame" title="动画展示" loading="eager"></iframe>
    </div>
  </div>
</BaseLayout>

<script>
  // ===== 菜单注册表：加新动画只需加一项 =====
  var MENU = [
    { key: 'arc',  page: 'lab-arc',  label: '圆弧动画' },
    { key: 'nier', page: 'lab-nier', label: 'NieR 加载动画' },
    { key: 'p3re', page: 'lab-p3re', label: 'P3RE 风格动画' },
    { key: 'login', page: 'login-demo/index.html', label: '互动登录' },
  ];
  var base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
  var frame = document.getElementById('lab-frame');
  var items = Array.prototype.slice.call(document.querySelectorAll('.lab-menu-item'));

  function select(key, pushHash) {
    var found = null;
    for (var i = 0; i < MENU.length; i++) if (MENU[i].key === key) found = MENU[i];
    if (!found) return;
    // 高亮菜单
    for (var j = 0; j < items.length; j++) items[j].classList.toggle('active', items[j].getAttribute('data-key') === key);
    // 切换 iframe（不同页面才换 src，避免重复加载）
    var target = base + '/' + found.page;
    if (frame.getAttribute('src') !== target) frame.setAttribute('src', target);
    // 更新 hash
    if (pushHash && window.location.hash !== '#' + key) {
      try { history.replaceState(null, '', '#' + key); } catch (e) { window.location.hash = key; }
    }
  }

  // 菜单点击
  for (var k = 0; k < items.length; k++) {
    (function (btn) {
      btn.addEventListener('click', function () {
        select(btn.getAttribute('data-key'), true);
      });
    })(items[k]);
  }

  // 初始化：hash 优先（#arc/#nier/#p3re），默认 arc
  var initial = (window.location.hash || '').replace('#', '');
  var ok = false;
  for (var m = 0; m < MENU.length; m++) if (MENU[m].key === initial) ok = true;
  if (!ok) initial = 'arc';
  select(initial, false);
</script>

<style is:global>
  /* 壳页面布局：左侧菜单固定宽，右侧 iframe 填满 */
  html, body {
    height: 100%;
    margin: 0;
  }
  header ~ main.max-w-2xl {
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .lab-shell {
    display: flex;
    height: 100vh;
    background: #252423;
    color: #22D3EE;
    font-family: 'Courier New', 'Consolas', monospace;
  }
  /* 左侧菜单 */
  .lab-menu {
    width: 210px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #1C1814;
    border-right: 1px solid rgba(34, 211, 238, 0.15);
    box-sizing: border-box;
  }
  .lab-menu-head {
    padding: 24px 18px 18px;
    border-bottom: 1px solid rgba(34, 211, 238, 0.12);
  }
  .lab-menu-title {
    display: block;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.3em;
    color: #7FF3FF;
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.55), 0 0 20px rgba(34, 211, 238, 0.25);
  }
  .lab-menu-sub {
    display: block;
    margin-top: 8px;
    font-size: 9px;
    letter-spacing: 0.25em;
    line-height: 1.7;
    color: rgba(34, 211, 238, 0.45);
  }
  .lab-menu-list {
    flex: 1;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lab-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: rgba(201, 232, 239, 0.6);
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-align: left;
    cursor: pointer;
    transition: all .2s ease;
  }
  .lab-menu-item .lm-num {
    font-size: 11px;
    color: rgba(34, 211, 238, 0.5);
    letter-spacing: 0.1em;
    min-width: 20px;
  }
  .lab-menu-item:hover {
    color: #7FF3FF;
    background: rgba(34, 211, 238, 0.08);
    border-color: rgba(34, 211, 238, 0.25);
  }
  .lab-menu-item.active {
    color: #7FF3FF;
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.15);
  }
  .lab-menu-item.active .lm-num {
    color: #22D3EE;
  }
  .lab-menu-foot {
    padding: 14px 18px;
    font-size: 10px;
    line-height: 1.8;
    letter-spacing: 0.08em;
    color: rgba(34, 211, 238, 0.35);
    border-top: 1px solid rgba(34, 211, 238, 0.12);
  }
  /* 右侧 iframe */
  .lab-frame-wrap {
    flex: 1;
    min-width: 0;
    position: relative;
    background: #252423;
  }
  .lab-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #252423;
  }
</style>
