    left: 50%;
    width: calc(100% - 50px);
    height: calc(100% - 50px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid #000;
  }
  /* 665/660 圆环：黑色线条，同心 */
  .lab-ring {
