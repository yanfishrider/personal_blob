    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid #000;
  }
  .lab-ring-665 {
    width: calc(100% - 85px);   /* 750 - 85 = 665 */
    height: calc(100% - 85px);
  }
  .lab-ring-660 {
