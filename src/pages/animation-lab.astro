---
// animation-lab.astro — 动画展示馆壳页面：左侧菜单 + 右侧 iframe（DIY 展示）
// 新增动画只需在 MENU 里加一项，菜单和数据自动同步
import BaseLayout from '../layouts/BaseLayout.astro';

const MENU = [
  { key: 'arc', page: 'lab-arc', label: '圆弧动画' },
  { key: 'nier', page: 'lab-nier', label: 'NieR 加载动画' },
  { key: 'p3re', page: 'lab-p3re', label: 'P3RE 风格动画' },
  { key: 'login', page: 'login-demo/index.html', label: '互动登录' },
  { key: 'zipper', page: 'lab-zipper', label: '拉链幕布' },
  { key: 'standby', page: 'standby/index.html', label: '叶扇展开' },
  { key: 'ink', page: 'lab-ink/index.html', label: '湖面' },
];
---

<BaseLayout theme="dark" title="动画展示馆 - 摸鱼骑士 知识库" description="把喜欢的游戏 UI 拆开重做：圆弧、NieR、P3RE、拉链幕布。">
  <div id="lab-shell" class="lab-shell">
    <nav id="lab-menu" class="lab-menu" aria-label="动画列表">
      <div class="lab-menu-head">
        <span class="lab-menu-title">动画馆</span>
        <span class="lab-menu-sub">ANIMATION<br />GALLERY</span>
      </div>
      <div class="lab-menu-list">
        {
          MENU.map((item, i) => (
            <button class="lab-menu-item" data-key={item.key} data-page={item.page} type="button">
              <span class="lm-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="lm-name">{item.label}</span>
            </button>
          ))
        }
      </div>
      <div class="lab-menu-foot">滚轮 / 点击驱动各动画<br />以 iframe 独立运行</div>
    </nav>
    <div class="lab-frame-wrap">
      <iframe id="lab-frame" class="lab-frame" title="动画展示" loading="eager"></iframe>
    </div>
  </div>
</BaseLayout>

<script>
  var base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
  var frame = document.getElementById('lab-frame') as HTMLIFrameElement | null;
  var items = Array.prototype.slice.call(document.querySelectorAll('.lab-menu-item'));
  var pages: Record<string, string> = {};
  var labels: Record<string, string> = {};
  items.forEach(function (btn) {
    pages[btn.getAttribute('data-key')] = btn.getAttribute('data-page');
    labels[btn.getAttribute('data-key')] = btn.getAttribute('data-key');
  });

  function select(key: string, pushHash: boolean) {
    if (!pages[key] || !frame) return;
    for (var j = 0; j < items.length; j++) {
      items[j].classList.toggle('active', items[j].getAttribute('data-key') === key);
    }
    var target = base + '/' + pages[key];
    if (frame.getAttribute('src') !== target) frame.setAttribute('src', target);
    if (pushHash && window.location.hash !== '#' + key) {
      try {
        history.replaceState(null, '', '#' + key);
      } catch (e) {
        window.location.hash = key;
      }
    }
  }

  for (var k = 0; k < items.length; k++) {
    (function (btn) {
      btn.addEventListener('click', function () {
        select(btn.getAttribute('data-key'), true);
      });
    })(items[k]);
  }

  var initial = (window.location.hash || '').replace('#', '');
  if (!pages[initial]) initial = 'arc';
  select(initial, false);
</script>

<style is:global>
  /* 用 main.page-main 提高一级优先级：生产构建里 global.css 可能排在本块之后，
     同为 .page-main 时后者会赢，导致面板被压成 860px 居中 */
  main.page-main {
    max-width: none;
    margin: 0;
    padding: 0;
    height: calc(100vh - var(--header-h));
  }
  .lab-shell {
    display: flex;
    height: 100%;
    background: #23211e;
    color: #22d3ee;
    font-family: var(--font-mono);
  }
  .lab-menu {
    width: 210px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #1a1815;
    border-right: 1px solid rgba(34, 211, 238, 0.15);
    box-sizing: border-box;
  }
  .lab-menu-head {
    padding: 24px 18px 18px;
    border-bottom: 1px solid rgba(34, 211, 238, 0.12);
  }
  .lab-menu-title {
    display: block;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.3em;
    color: #7ff3ff;
    text-shadow: 0 0 8px rgba(34, 211, 238, 0.55), 0 0 20px rgba(34, 211, 238, 0.25);
  }
  .lab-menu-sub {
    display: block;
    margin-top: 8px;
    font-size: 9px;
    letter-spacing: 0.25em;
    line-height: 1.7;
    color: rgba(34, 211, 238, 0.45);
  }
  .lab-menu-list {
    flex: 1;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lab-menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: rgba(201, 232, 239, 0.6);
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lab-menu-item .lm-num {
    font-size: 11px;
    color: rgba(34, 211, 238, 0.5);
    letter-spacing: 0.1em;
    min-width: 20px;
  }
  .lab-menu-item:hover {
    color: #7ff3ff;
    background: rgba(34, 211, 238, 0.08);
    border-color: rgba(34, 211, 238, 0.25);
  }
  .lab-menu-item.active {
    color: #7ff3ff;
    background: rgba(34, 211, 238, 0.15);
    border-color: rgba(34, 211, 238, 0.5);
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.15);
  }
  .lab-menu-item.active .lm-num {
    color: #22d3ee;
  }
  .lab-menu-foot {
    padding: 14px 18px;
    font-size: 10px;
    line-height: 1.8;
    letter-spacing: 0.08em;
    color: rgba(34, 211, 238, 0.35);
    border-top: 1px solid rgba(34, 211, 238, 0.12);
  }
  .lab-frame-wrap {
    flex: 1;
    min-width: 0;
    position: relative;
    background: #23211e;
  }
  .lab-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    background: #23211e;
  }

  @media (max-width: 700px) {
    .lab-menu {
      width: 132px;
    }
    .lab-menu-title {
      font-size: 15px;
      letter-spacing: 0.2em;
    }
    .lab-menu-sub,
    .lab-menu-foot {
      display: none;
    }
    .lab-menu-item {
      font-size: 11.5px;
      padding: 10px 8px;
    }
  }
</style>
