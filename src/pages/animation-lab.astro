---
// animation-lab.astro — 复杂页面动画测试页（加载动画 + 滚动指示器同源设计的迭代画布）
// 逐步实现：每一轮迭代在此页面累积效果，验证后迁移回 LoadingScreen / 正式页面
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="动画实验室" description="复杂页面动画测试画布">
  <main id="anim-lab" class="anim-lab">
    <!-- 测试内容：750 主动画区域 + 700 内圆 + 725 圆弧分段 + 665/660 圆环 + 667 刻度线 -->
    <!-- 圆弧区：页面固定 100vh 聚焦圆环，wheel 滚轮驱动进度 -->
    <div class="lab-stage">
      <div id="lab-circle" class="lab-circle">
        <svg id="lab-dots" class="lab-arc" viewBox="0 0 750 750"></svg>
        <div id="lab-circle-inner" class="lab-circle-inner"></div>
        <div id="lab-ring-665" class="lab-ring lab-ring-665"></div>
        <div id="lab-ring-660" class="lab-ring lab-ring-660"></div>
        <svg id="lab-arc" class="lab-arc" viewBox="0 0 750 750"></svg>
        <svg id="lab-ticks" class="lab-arc" viewBox="0 0 750 750"></svg>
        <svg id="lab-rings" class="lab-arc" viewBox="0 0 750 750"></svg>
        <!-- 12 图形随机游走层：6 实心 + 6 线框（第二段圆弧显示） -->
        <svg id="lab-shapes" class="lab-arc lab-shapes" viewBox="0 0 750 750"></svg>
        <!-- 椭圆轨迹层：轨迹不可见，色块（弧段样式）绕椭圆运动构建 3D 球（第三段圆弧显示，先单椭圆验证） -->
        <svg id="lab-ellipse" class="lab-arc lab-ellipse" viewBox="0 0 750 750"></svg>
        <!-- 中心旋转色块：相对主圆容器居中（第一段圆弧色高亮无荧光，anime.js 旋转） -->
        <div id="lab-square" class="lab-square"></div>
      </div>
    </div>
    <div id="lab-ruler" class="lab-ruler">
      <svg id="lab-ruler-svg" width="350" height="40" viewBox="0 0 350 40"></svg>
    </div>

    <!-- 刻度尺上方浮动代码卡片：显示当前段 SCENES[idx].code -->
    <div id="lab-code-card" class="lab-code-card"></div>

    <!-- 圆外左侧介绍长条：8 张卡片随进度上移 -->
    <div id="lab-left" class="lab-left">
      <div id="lab-left-list" class="lab-left-list"></div>
    </div>

    <!-- 圆形容器外的横向刻度尺容器：fixed 右下角（right:20% bottom:10%），350×40 圆角 -->
  </main>
</BaseLayout>

<script>
  // ===== 场景数据（8 段占位，改数组长度即可调整段数） =====
  // 每段：title 左侧卡片标题 / desc 左侧介绍（介绍中心旋转色块动画的各方面）/ code 刻度尺上方代码卡片
  var SCENES = [
    { title: '增强型变换', desc: '将各个 CSS 变换属性与多功能的组合 API 平滑地融合。', code: "animate(square, {\n  rotate: 90, loop: true, duration: 500,\n  ease: 'inOutExpo'\n});" },
    { title: '单个CSS变换', desc: '独立控制 translate / rotate / scale 等每个属性。', code: '// 独立属性\nrotate: 90,\nscale: [0.4, 1.6],\nx: 120, y: 80,' },
    { title: '基于函数的值', desc: '每个元素独立求值，支持随机与计算。', code: '// 函数值：按元素求值\nx: () => utils.random(-240, 240),\ny: () => utils.random(-240, 240),' },
    { title: '混合成分', desc: 'composition 让多个动画平滑叠加混合。', code: "composition: 'blend',\n// 多动画混合叠加" },
    { title: '旋转 25%', desc: 'rotate 90°（圆周的 25%）。', code: '// 旋转幅度\nrotate: 90,' },
    { title: '缓动曲线', desc: 'inOutExpo 两端缓入缓出，往返平滑。', code: "ease: 'inOutExpo'," },
    { title: '循环播放', desc: 'loop 无限往返，500ms 完成一次旋转。', code: 'loop: true,\nduration: 500,' },
    { title: '驱动引擎', desc: 'anime.js v4 动态加载驱动旋转。', code: "import('https://esm.sh/animejs@4.4.1')" },
  ];
  var SEG_NUM = SCENES.length;   // 段数由场景数组驱动（当前 8）

  // ===== 725 圆弧分段参数（可调） =====
  var ARC = {
    cx: 375, cy: 375,   // 圆心（viewBox 0 0 750 750）
    r: 357.5,           // 715 直径 → 半径
    width: 5,           // 向内弧线宽度
    segments: SEG_NUM,  // 分段数（= SCENES.length，动态）
    gapDeg: 1,          // 段间空白角度（可调）
    colors: [           // 每段颜色（可自定义，已调暗 ~35%）
      '#16899B', '#539EA6', '#228963', '#6A9622',
      '#A37C17', '#9F4A76', '#6D5AA3', '#AAAAAA',
    ],
  };

  // ===== 667 刻度线参数（可调） =====
  var TICKS = {
    r: 333.5,           // 667 直径 → 半径
    len: 15,            // 刻度线长度（向圆心延伸）
    count: 180,         // 刻度线数量（可调，240 → 180 减少 25%）
    width: 2,           // 刻度线宽度
    startDeg: -90,      // 起点角度：12 点方向
  };

  // ===== 手抖圆环参数（可调） =====
  var RINGS = {
    radii: [310, 305, 290, 295, 275, 270],  // 6 个圆环半径（由外到内）
    width: 2,           // 线条宽度
    jitter: 0.8,        // 随机抖动幅度（px，减小后更接近圆）
    step: 2,            // 每多少度取一个点（越小越精细）
    colors: [           // 每环颜色（可自定义）
      '#000000', '#000000', '#000000',
      '#000000', '#000000', '#000000',
    ],
  };

  // ===== 点阵背景参数（可调） =====
  var DOTS = {
    gap: 30,            // 点阵间隔（方形网格）
    radius: 270,        // 点阵覆盖半径（最小圆环处消失）
    dotR: 2.5,          // 小圆点半径
    minOpacity: 0.06,   // 低于此透明度直接消失（不渲染）
  };

  // ===== 横向刻度尺参数（圆外右下角容器，350×40，分段与圆弧对应） =====
  var RULER = {
    w: 350, h: 40,      // 容器尺寸
    segments: SEG_NUM,  // 分段数（与 ARC.segments 同步，动态）
    ticksPerSeg: 10,    // 每段内竖线条数（5 → 10 密集度翻倍）
    tickH: 10,          // 刻度线高度（容器中间）
    tickW: 2,           // 刻度线宽度
    color: '#393837',   // 非高亮部分颜色
    slider: true,       // 是否显示定位滑块
    sliderMult: 2,      // 滑块宽度 = 刻度线宽度 × 倍数
    sliderH: 12,        // 滑块高度
    sliderBright: 1.26, // 滑块亮度（弧色高亮 1.2 再调亮 5% = 1.2 × 1.05）
  };

  (function () {
    var NS = 'http://www.w3.org/2000/svg';
    var a = ARC;
    var ru = RULER;

    // 颜色工具：hex 变暗（factor < 1 调暗）
    function darken(hex, factor) {
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      r = Math.round(r * factor);
      g = Math.round(g * factor);
      b = Math.round(b * factor);
      return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
    }

    // ============ 三区域初始化：左侧卡片列表 / 代码卡片 ============
    var leftList = document.getElementById('lab-left-list');
    var codeCard = document.getElementById('lab-code-card');
    var leftCards = [];     // 左侧卡片元素
    var cardStep = window.innerHeight;  // 左侧卡片步进 = 整屏高度（每张卡片占满一屏）

    // 左侧卡片 + 代码卡片（内容取 SCENES；中心场景文字已删除，仅保留色块动画）
    for (var sc = 0; sc < SCENES.length; sc++) {
      var sdata = SCENES[sc];
      // 左侧卡片
      var card = document.createElement('div');
      card.className = 'lab-left-card';
      card.innerHTML = '<div class="lc-title">' + sdata.title + '</div>' + sdata.desc;
      leftList.appendChild(card);
      leftCards.push(card);
    }
    // 初始显示第一段代码卡片
    codeCard.textContent = SCENES[0].code;
    codeCard.classList.add('show');

    // ============ 中心旋转色块 + 12 图形随机游走（anime.js 驱动） ============
    var squareEl = document.getElementById('lab-square');
    if (squareEl) {
      squareEl.style.background = a.colors[0];
      squareEl.style.filter = 'brightness(1.42)';
    }
    // 12 图形：6 类形状 × 2（每类第 1 个实心、第 2 个线框）= 6 实心 + 6 线框
    var shapesSvg = document.getElementById('lab-shapes');
    var shapesEls = [];   // 12 个图形元素（SVG，位于 g[translate 375 375] 内，中心=圆心）
    if (shapesSvg) {
      var NS2 = 'http://www.w3.org/2000/svg';
      var shapeG = document.createElementNS(NS2, 'g');
      shapeG.setAttribute('transform', 'translate(375 375)');
      shapesSvg.appendChild(shapeG);
      function buildShape(type) {
        var el;
        if (type === 'circle') {
          el = document.createElementNS(NS2, 'circle');
          el.setAttribute('r', 20);
        } else if (type === 'triangle') {
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-20 17.3,10 -17.3,10');
        } else if (type === 'rect') {
          // 正方形：36×36 居中，圆角 6px
          el = document.createElementNS(NS2, 'rect');
          el.setAttribute('x', -18); el.setAttribute('y', -18);
          el.setAttribute('width', 36); el.setAttribute('height', 36);
          el.setAttribute('rx', 6);
        } else if (type === 'diamond') {
          // 菱形：更锐利（宽 24 高 44，顶点更尖）
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-22 12,0 0,22 -12,0');
        } else if (type === 'star') {
          el = document.createElementNS(NS2, 'polygon');
          el.setAttribute('points', '0,-22 5.8,-7 22,-7 9,2 13.6,18 0,10 -13.6,18 -9,2 -22,-7 -5.8,-7');
        } else if (type === 'crossarc') {
          // 十字圆弧：4 段 90° 弧同向首尾相连，连接点 = 十字四臂端点；弧半径加大 → 弧更平直、四瓣更锐利
          el = document.createElementNS(NS2, 'path');
          el.setAttribute('d', 'M -14 0 A 20 20 0 0 1 0 14 A 20 20 0 0 1 14 0 A 20 20 0 0 1 0 -14 A 20 20 0 0 1 -14 0');
        }
        el.setAttribute('class', 'shape');
        return el;
      }
      var shapeTypes = ['circle', 'triangle', 'rect', 'diamond', 'star', 'crossarc'];
      for (var ti = 0; ti < shapeTypes.length; ti++) {
        for (var vi = 0; vi < 2; vi++) {
          var sel = buildShape(shapeTypes[ti]);
          var solid = vi === 0;   // 每类第 1 个实心、第 2 个线框
          var col = a.colors[ti % a.colors.length];
          if (solid) {
            sel.setAttribute('fill', col);
          } else {
            sel.setAttribute('fill', 'none');
            sel.setAttribute('stroke', col);
            sel.setAttribute('stroke-width', 2.25);  // 线框宽度：原 3 缩小 25%
            sel.setAttribute('stroke-linejoin', 'round');
          }
          shapeG.appendChild(sel);
          shapesEls.push(sel);
        }
      }
    }
    // ============ 椭圆轨迹组（第三段，多条线构成 3D 球） ============
    var ellipseSvg = document.getElementById('lab-ellipse');
    // 20 条椭圆：圆心沿通过圆容器圆心的对角线（y = x，中心 375,375）对称排开（Δ12），半径由小到大再到小（球体轮廓）
    // 两端（第一/最后）半径缩小一倍 rx=50，中间最大 rx=225 不变，其他按比例（rx = 50 + 175×(1−t²)）
    // 出现时机：第 i 条 drawRange.start = i×0.0125
    var ELLIPSES = [];
    var ELL_N = 20;
    var ELL_MID = (ELL_N - 1) / 2;
    for (var ei0 = 0; ei0 < ELL_N; ei0++) {
      var et = (ei0 - ELL_MID) / ELL_MID;               // -1 ~ 1
      var erx = 57.5 + 201.25 * (1 - et * et);          // 等比放大 1.15 倍：两端 57.5、中间最大 258.75
      var shift = 48 * (ei0 - ELL_MID) / ELL_MID;       // 沿对角线按比例移动（再继续上移）：第一个 -48、中间最大 0（锚定）、最后 +48
      // 出现时机：第 i 条 drawRange.start = i×0.0125；第二条特殊：第一条路径到 37.5%（inSeg 0.0375）时出现
      var eStart = (ei0 === 1) ? 0.0375 : ei0 * 0.0125;
      ELLIPSES.push({
        cx: 375 + (ei0 - ELL_MID) * 12 + shift,
        cy: 375 + (ei0 - ELL_MID) * 12 + shift,
        rx: erx,
        ry: Math.round(erx * 0.2),                      // 扁度 0.2
        rotate: -45,
        color: a.colors[2 % a.colors.length],
        drawRange: { start: eStart, end: 1 },
        drawScale: 10
      });
    }
    var ellipseItems = [];   // { path, len, drawP, cfg }
    if (ellipseSvg) {
      var elNS = 'http://www.w3.org/2000/svg';
      for (var ei = 0; ei < ELLIPSES.length; ei++) {
        var ec = ELLIPSES[ei];
        // 画笔轨迹：椭圆 path（中心 ec.cx/cy），dashoffset 由滚动进度驱动（手动）
        var tp = document.createElementNS(elNS, 'path');
        tp.setAttribute('d', 'M ' + (ec.cx - ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx + ec.rx) + ' ' + ec.cy + ' A ' + ec.rx + ' ' + ec.ry + ' 0 1 0 ' + (ec.cx - ec.rx) + ' ' + ec.cy);
        tp.setAttribute('fill', 'none');
        tp.setAttribute('stroke', ec.color);
        tp.setAttribute('stroke-width', 3.6);
        tp.setAttribute('stroke-linecap', 'round');
        tp.style.filter = 'brightness(1.42) drop-shadow(0 0 6px ' + ec.color + ')';
        tp.setAttribute('transform', 'rotate(' + ec.rotate + ' ' + ec.cx + ' ' + ec.cy + ')');
        ellipseSvg.appendChild(tp);
        var tlen = (tp.getTotalLength && tp.getTotalLength()) || 1240;
        tp.setAttribute('stroke-dasharray', tlen + ' ' + tlen);
        tp.setAttribute('stroke-dashoffset', tlen);  // 初始全隐藏，第三段按进度画出
        ellipseItems.push({ path: tp, len: tlen, drawP: 0, cfg: ec });
      }
    }
    // 呼吸浮动（传递式）：每条椭圆独立浮动，带相位差（第 i 条延迟 i×0.35 rad）→ 波浪从第一个传递到最后一个，不整体一起动
    (function breathLoop() {
      var bt = Date.now() / 1000;
      for (var bi = 0; bi < ellipseItems.length; bi++) {
        var bit = ellipseItems[bi];
        var bec = bit.cfg;
        var bbr = Math.sin(bt * 2 * Math.PI / 3 + bi * 0.35) * 8;   // 相位差 bi×0.35 → 传递式波浪
        var bfx = bbr * 0.707;
        var bfy = bbr * 0.707;
        bit.path.setAttribute('transform', 'translate(' + bfx + ' ' + bfy + ') rotate(' + bec.rotate + ' ' + bec.cx + ' ' + bec.cy + ')');
      }
      requestAnimationFrame(breathLoop);
    })();
    // anime.js 驱动：色块旋转（25%）+ 12 图形随机游走（圆环内独立随机节奏）+ 椭圆色块绕行；CDN 失败静默降级
    import('https://esm.sh/animejs@4.4.1').then(function (mod) {
      if (!mod || !mod.animate) return;
      var animate = mod.animate;
      var utils = mod.utils;
      if (squareEl) {
        animate(squareEl, { rotate: 90, loop: true, duration: 500, ease: 'inOutExpo' });
      }
      // 12 图形随机游走：活动半径 = 内手抖环 270 - 图形外接半径 ~22 - 余量
      var SHAPE_LIMIT = 240;
      function randPoint() {
        var ang = Math.random() * Math.PI * 2;
        var r = Math.sqrt(Math.random()) * SHAPE_LIMIT;
        return { x: Math.cos(ang) * r, y: Math.sin(ang) * r };
      }
      shapesEls.forEach(function (el, i) {
        function loop() {
          var p = randPoint();
          animate(el, {
            x: p.x,
            y: p.y,
            scale: utils.random(0.4, 1.6),
            duration: utils.random(600, 1400),
            ease: 'out(3)',
          });
          window.setTimeout(loop, utils.random(500, 1100));
        }
        window.setTimeout(loop, utils.random(0, 900));
      });
      // 椭圆轨迹为手动模式：滚轮/进度直接驱动（见 updateProgress），无需自动动画
    }).catch(function () {});

    // ============ 点阵背景（方形网格小圆点，中心亮边缘暗） ============
    var dotEls = [];   // 已渲染的点（含基准 opacity）
    var svgDots = document.getElementById('lab-dots');
    if (svgDots) {
      var dg = DOTS;
      var cx0 = a.cx, cy0 = a.cy;
      // 从圆心向四周铺方形网格（间隔 gap），点在圆内且 opacity 达标才渲染
      for (var gx = -dg.radius; gx <= dg.radius; gx += dg.gap) {
        for (var gy = -dg.radius; gy <= dg.radius; gy += dg.gap) {
          var dist = Math.sqrt(gx * gx + gy * gy);
          if (dist > dg.radius) continue;                 // 圆外不渲染
          // 亮度随距离衰减：中心最接近弧色，边缘变暗，最暗直接消失
          var t2 = dist / dg.radius;                     // 0 中心 → 1 边缘
          var op = 1 - t2 * t2;                          // 平方衰减
          if (op < dg.minOpacity) continue;              // 最暗直接消失
          var dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('cx', cx0 + gx);
          dot.setAttribute('cy', cy0 + gy);
          dot.setAttribute('r', dg.dotR);
          dot.setAttribute('fill', a.colors[0]);
          dot.setAttribute('opacity', op.toFixed(3));
          svgDots.appendChild(dot);
          dotEls.push(dot);
        }
      }
    }

    // ============ 圆弧分段（每段两层：底层段色 + 顶层高亮进度条） ============
    var arcBases = [];   // 底层：整段（暗/亮弧色，随状态切换）
    var arcTops = [];    // 顶层：高亮进度条（dasharray 按段内进度）
    var C = 0, seg = 0, stepDeg = 0;
    var svgArc = document.getElementById('lab-arc');
    if (svgArc) {
      C = 2 * Math.PI * a.r;              // 周长
      var gap = C * a.gapDeg / 360;       // 空白弧长
      seg = C / a.segments - gap;         // 每段弧长
      stepDeg = 360 / a.segments;
      for (var i = 0; i < a.segments; i++) {
        var rot = 'rotate(' + (i * stepDeg - 90) + ' ' + a.cx + ' ' + a.cy + ')';
        // 底层：整段（初始暗版弧色，细）
        var base = document.createElementNS(NS, 'circle');
        base.setAttribute('cx', a.cx);
        base.setAttribute('cy', a.cy);
        base.setAttribute('r', a.r);
        base.setAttribute('fill', 'none');
        base.setAttribute('stroke', darken(a.colors[i % a.colors.length], 0.35));
        base.setAttribute('stroke-width', 5);
        base.setAttribute('stroke-dasharray', seg + ' ' + C);
        base.setAttribute('transform', rot);
        base.style.transition = 'stroke-width .4s ease';  // 宽度平滑过渡
        svgArc.appendChild(base);
        arcBases.push(base);
        // 顶层：高亮进度条（初始隐藏，dasharray 0；brightness 提亮与段底色区分 + 荧光辉光）
        var top = document.createElementNS(NS, 'circle');
        top.setAttribute('cx', a.cx);
        top.setAttribute('cy', a.cy);
        top.setAttribute('r', a.r);
        top.setAttribute('fill', 'none');
        top.setAttribute('stroke', a.colors[i % a.colors.length]);
        top.setAttribute('stroke-width', 10);
        top.setAttribute('stroke-dasharray', '0 ' + C);
        top.setAttribute('transform', rot);
        top.style.transition = 'stroke-width .4s ease';  // 宽度平滑过渡
        top.style.filter = 'brightness(1.42) drop-shadow(0 0 8px ' + a.colors[i % a.colors.length] + ')';  // 亮度 +5% + 荧光
        svgArc.appendChild(top);
        arcTops.push(top);
      }
    }

    // ============ 667 刻度线（保存引用供圆弧颜色联动） ============
    var svgTicks = document.getElementById('lab-ticks');
    var tickLines = [];   // {el, segIdx} 每条刻度线所属段
    if (svgTicks) {
      var t = TICKS;
      var ticksPerSeg = t.count / a.segments;   // 每段对应的刻度线条数（180/8=22.5）
      var tickColor = darken(a.colors[0], 0.35);  // 初始暗版弧色，后续 updateProgress 联动
      for (var i = 0; i < t.count; i++) {
        var ang = (i * (360 / t.count) + t.startDeg) * Math.PI / 180;
        var line = document.createElementNS(NS, 'line');
        line.setAttribute('x1', a.cx + t.r * Math.cos(ang));
        line.setAttribute('y1', a.cy + t.r * Math.sin(ang));
        line.setAttribute('x2', a.cx + (t.r - t.len) * Math.cos(ang));
        line.setAttribute('y2', a.cy + (t.r - t.len) * Math.sin(ang));
        line.setAttribute('stroke', tickColor);
        line.setAttribute('stroke-width', t.width);
        line.setAttribute('stroke-linecap', 'round');
        // 记录所属段号（起始 -90° 与圆弧同向：第 i 条属于 floor(i / 每段条数) 段）
        tickLines.push({ el: line, segIdx: Math.floor(i / ticksPerSeg) });
        svgTicks.appendChild(line);
      }
      // 12 点起始刻度线保持高亮标记
      if (tickLines[0]) tickLines[0].el.style.filter = 'brightness(1.2)';
    }

    // ============ 手抖圆环 ============
    var svgRings = document.getElementById('lab-rings');
    if (svgRings) {
      var rg = RINGS;
      for (var rIdx = 0; rIdx < rg.radii.length; rIdx++) {
        var baseR = rg.radii[rIdx];
        var d = '';
        var points = Math.round(360 / rg.step);
        for (var p = 0; p <= points; p++) {
          var ang = p * rg.step * Math.PI / 180;
          var jit = (Math.random() * 2 - 1) * rg.jitter;
          var rr = baseR + jit;
          var x = (a.cx + rr * Math.cos(ang)).toFixed(2);
          var y = (a.cy + rr * Math.sin(ang)).toFixed(2);
          d += (p === 0 ? 'M' : 'L') + x + ' ' + y;
        }
        d += 'Z';
        var ring = document.createElementNS(NS, 'path');
        ring.setAttribute('d', d);
        ring.setAttribute('fill', 'none');
        ring.setAttribute('stroke', rg.colors[rIdx % rg.colors.length]);
        ring.setAttribute('stroke-width', rg.width);
        ring.setAttribute('stroke-linejoin', 'round');
        svgRings.appendChild(ring);
      }
    }

    // ============ 横向刻度尺 + 滑块 + hover 预览 ============
    var svgRuler = document.getElementById('lab-ruler-svg');
    var sliderEl = null;   // 定位滑块（跟随进度）
    var previewEl = null;  // hover 预览滑块
    var rulerEl = document.getElementById('lab-ruler');
    var sliderX0 = 0;      // 滑块初始 x
    var sw = 0, sy1 = 0;

    if (svgRuler) {
      var segW = ru.w / ru.segments;
      var y1 = (ru.h - ru.tickH) / 2;
      var y2 = y1 + ru.tickH;
      var first = true;
      for (var s = 0; s < ru.segments; s++) {
        for (var t2 = 0; t2 < ru.ticksPerSeg; t2++) {
          var x = s * segW + 6 + t2 * ((segW - 12) / (ru.ticksPerSeg - 1));
          var line = document.createElementNS(NS, 'line');
          line.setAttribute('x1', x); line.setAttribute('y1', y1);
          line.setAttribute('x2', x); line.setAttribute('y2', y2);
          line.setAttribute('stroke-width', ru.tickW);
          line.setAttribute('stroke-linecap', 'round');
          if (t2 === 0) {
            line.setAttribute('stroke', a.colors[s % a.colors.length]);
            if (first) {
              line.style.filter = 'brightness(1.2)';
              first = false;
              sliderX0 = x;
            }
          } else {
            line.setAttribute('stroke', ru.color);
          }
          svgRuler.appendChild(line);
        }
      }
      // 定位滑块（进度）
      if (ru.slider) {
        sliderEl = document.createElementNS(NS, 'rect');
        sw = ru.tickW * ru.sliderMult;
        sy1 = (ru.h - ru.sliderH) / 2;
        sliderEl.setAttribute('x', sliderX0 - sw / 2);
        sliderEl.setAttribute('y', sy1);
        sliderEl.setAttribute('width', sw);
        sliderEl.setAttribute('height', ru.sliderH);
        sliderEl.setAttribute('rx', sw / 2);
        sliderEl.setAttribute('fill', a.colors[0]);
        sliderEl.style.filter = 'brightness(' + ru.sliderBright + ')';
        svgRuler.appendChild(sliderEl);
      }
      // hover 预览滑块（初始隐藏：位于当前滑块位置、尺寸 60%，mousemove 过渡到目标并放大）
      previewEl = document.createElementNS(NS, 'rect');
      previewEl.setAttribute('x', sliderX0 - sw / 2);
      previewEl.setAttribute('y', sy1);
      previewEl.setAttribute('width', sw * 0.6);
      previewEl.setAttribute('height', ru.sliderH * 0.6);
      previewEl.setAttribute('rx', sw / 2);
      previewEl.setAttribute('fill', a.colors[0]);
      previewEl.style.filter = 'brightness(0.95)';  // 变暗 5%
      previewEl.style.opacity = '0';
      previewEl.style.transition = 'opacity .2s ease, x .25s ease-out, width .25s ease-out, height .25s ease-out';
      svgRuler.appendChild(previewEl);
    }

    // ============ 进度驱动（wheel 滚轮，页面固定 100vh；rAF 插值平滑） ============
    var target = 0;     // 目标进度（wheel/点击直接改）
    var current = 0;    // 当前渲染进度（rAF 每帧逼近 target）
    var rafId = null;   // 动画帧句柄
    var lastIdx = -1;   // 上次渲染的段号（场景/代码卡片切换检测）
    var BASE_W = 5;     // 基础宽度（未到段 / 已过段）
    var GROW_W = 10;    // 当前段整段宽度（基础 + 5）

    function updateProgress() {
      var progress = current;  // 用当前渲染进度
      var total = a.segments;
      var idx = Math.min(Math.floor(progress * total), total - 1);  // 当前段
      var inSeg = progress * total - idx;                           // 段内 0~1

      for (var i = 0; i < total; i++) {
        var base = arcBases[i];
        var top = arcTops[i];
        var col = a.colors[i % a.colors.length];
        if (i < idx) {
          // 已过段：弧色保持高亮 + 荧光（顶层整段显示），宽度恢复基础宽
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          top.setAttribute('stroke-width', BASE_W);
          top.setAttribute('stroke-dasharray', seg + ' ' + C);  // 顶层整段 → 荧光保留
        } else if (i === idx) {
          // 当前段：整段宽度 +5，高亮进度条按 inSeg 移动填充
          base.setAttribute('stroke', col);
          base.setAttribute('stroke-width', GROW_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          var fillLen = seg * inSeg;   // 段内进度条长度（0 → seg）
          top.setAttribute('stroke-width', GROW_W);
          top.setAttribute('stroke-dasharray', fillLen + ' ' + (C - fillLen));
        } else {
          // 未到段：暗版弧色，基础宽，无进度条（初始可见不消失）
          base.setAttribute('stroke', darken(col, 0.35));
          base.setAttribute('stroke-width', BASE_W);
          base.setAttribute('stroke-dasharray', seg + ' ' + C);
          top.setAttribute('stroke-dasharray', '0 ' + C);
        }
      }

      // 定位滑块：x = progress × 容器宽，颜色 = 当前段弧色高亮版
      if (sliderEl) {
        var sx = progress * ru.w;
        sliderEl.setAttribute('x', sx - sw / 2);
        sliderEl.setAttribute('fill', a.colors[idx % a.colors.length]);
      }

      // 667 刻度线整体同色变化：全部一起变为当前圆弧（当前段）的颜色
      var curColor = a.colors[idx % a.colors.length];
      for (var j = 0; j < tickLines.length; j++) {
        tickLines[j].el.setAttribute('stroke', curColor);
      }

      // 点阵背景：整体变为当前弧色（各点 opacity 基准不变，随位置固定）
      for (var k = 0; k < dotEls.length; k++) {
        dotEls[k].setAttribute('fill', curColor);
      }

      // 左侧介绍列表：随进度连续上移（滚到段 N 第 N 张对齐，上移消失、下一个浮现）
      if (leftList) {
        leftList.style.transform = 'translateY(' + (-progress * (SCENES.length - 1) * cardStep) + 'px)';
      }
      // 中心旋转色块：只关联第一段圆弧（idx 0 显示，进入下一段自动隐藏）
      if (squareEl) {
        squareEl.style.opacity = (idx === 0) ? '1' : '0';
      }
      // 12 图形随机游走：只关联第二段圆弧（idx 1 显示，其他段隐藏）
      if (shapesSvg) {
        shapesSvg.style.opacity = (idx === 1) ? '1' : '0';
      }
      // 椭圆轨迹组（第三段）：每条线 画(0~1) → 保持(1~2) → 擦除(2~3) → 消失；第二条在第一条画到半圆（inSeg 0.05）时出现
      if (ellipseSvg) {
        if (idx === 2) {
          ellipseSvg.style.opacity = '1';
          for (var eii = 0; eii < ellipseItems.length; eii++) {
            var item = ellipseItems[eii];
            var ec = item.cfg;
            var edr = ec.drawRange;
            // 区间映射 × drawScale：0~1 画、1~2 保持、2~3 擦除
            var eTgt = (edr.end > edr.start) ? Math.max((inSeg - edr.start) / (edr.end - edr.start), 0) * ec.drawScale : 0;
            var eDiff = eTgt - item.drawP;
            var eMax = 0.05;
            item.drawP += (eDiff > 0) ? Math.min(eDiff, eMax) : Math.max(eDiff, -eMax);
            item.path.setAttribute('stroke-dasharray', item.len + ' ' + item.len);
            // 擦除完成后彻底消失（不循环重画）：擦除加快半圈后（drawP ≥ 2.5）消失
            item.path.style.opacity = (item.drawP >= 2.5) ? '0' : '1';
            if (item.drawP <= 1) {
              // 第一圈：完整椭圆线条逐渐画出（dashoffset L→0）
              item.path.setAttribute('stroke-dashoffset', item.len * (1 - item.drawP));
            } else if (item.drawP <= 2) {
              // 第二圈：椭圆保持完整（不擦除、无弧段）
              item.path.setAttribute('stroke-dashoffset', 0);
            } else {
              // 第三圈起：从起始位置开始擦除（加快半圈：占 drawP 0.5 单位，2~2.5；dashoffset 0→-L）
              var eraseP = (item.drawP - 2) / 0.5;
              item.path.setAttribute('stroke-dashoffset', -item.len * eraseP);
            }
          }
        } else {
          ellipseSvg.style.opacity = '0';
          for (var eii2 = 0; eii2 < ellipseItems.length; eii2++) ellipseItems[eii2].drawP = 0;
        }
      }
      // 代码卡片 + 左侧卡片高亮：idx 变化时切换（中心场景文字已删除）
      if (lastIdx !== idx) {
        lastIdx = idx;
        if (codeCard && SCENES[idx]) {
          codeCard.textContent = SCENES[idx].code;
          codeCard.classList.remove('show');
          // 触发重排后重新显示（浮入动画）
          void codeCard.offsetWidth;
          codeCard.classList.add('show');
        }
        // 左侧当前卡片高亮
        for (var n = 0; n < leftCards.length; n++) {
          leftCards[n].style.borderLeftColor = (n === idx) ? curColor : '#22D3EE';
          leftCards[n].style.opacity = (n === idx) ? '1' : '0.55';
        }
      }
    }

    // rAF 插值：每帧让 current 平滑逼近 target（滚动停止后自然减速滑行）
    function tick() {
      var diff = target - current;
      if (Math.abs(diff) < 0.0008) {
        current = target;
        updateProgress();
        rafId = null;
        return;
      }
      current += diff * 0.08;   // 插值系数：越小越慢越平滑（0.18 → 0.08）
      updateProgress();
      rafId = requestAnimationFrame(tick);
    }
    function setProgress(p) {
      target = Math.min(Math.max(p, 0), 1);
      if (rafId === null) rafId = requestAnimationFrame(tick);
    }

    updateProgress();

    // wheel 滚轮驱动（页面固定，直接改目标进度；向下滚 deltaY>0 → 进度增加）
    window.addEventListener('wheel', function (e) {
      e.preventDefault();
      var step = e.deltaY > 0 ? 0.02 : -0.02;   // 滚轮灵敏度（恢复原值；椭圆画出速率由 updateProgress 平滑限速控制）
      setProgress(target + step);
    }, { passive: false });

    // ============ hover 预览滑块 ============
    if (rulerEl && previewEl && sliderEl) {
      rulerEl.addEventListener('mousemove', function (e) {
        var rect = rulerEl.getBoundingClientRect();
        var px = Math.min(Math.max(e.clientX - rect.left, 0), ru.w);
        var p2 = px / ru.w;
        var idx = Math.min(Math.floor(p2 * a.segments), a.segments - 1);
        // 预览滑块：从当前滑块位置移向鼠标并放大，颜色 = 当前弧段色变暗 5%
        previewEl.setAttribute('x', px - sw / 2);
        previewEl.setAttribute('width', sw);
        previewEl.setAttribute('height', ru.sliderH);
        previewEl.setAttribute('fill', a.colors[idx % a.colors.length]);
        previewEl.style.opacity = '1';
      });
      rulerEl.addEventListener('mouseleave', function () {
        previewEl.style.opacity = '0';
      });
      // 点击：跳转进度到对应位置（平滑插值）
      rulerEl.addEventListener('click', function (e) {
        var rect = rulerEl.getBoundingClientRect();
        var px = Math.min(Math.max(e.clientX - rect.left, 0), ru.w);
        setProgress(px / ru.w);
      });
    }
  })();
</script>

<style is:global>
  /* 自定义滚动条：轨道 #2C2C2C、滑块 #D1D1D1、宽 10px、滑块两端半圆 */
