---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import { getBlogData } from '../lib/blog-data';
import { buildTaxonomy } from '../lib/taxonomy';

const all = await getCollection('posts', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const tags = buildTaxonomy(posts, 'tag');

const { postCount, tagCount, categoryCount, recentPosts } = await getBlogData();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const max = tags[0]?.count ?? 1;
---

<BaseLayout title="标签 - 摸鱼骑士 知识库" description="按标签浏览全部文章。">
  <ProfileSidebar
    slot="sidebar"
    postCount={postCount}
    tagCount={tagCount}
    categoryCount={categoryCount}
    recentPosts={recentPosts}
  />

  <div>
    <header class="page-head">
      <span class="page-head__eyebrow">Tags</span>
      <h1 class="page-head__title">标签</h1>
      <p class="page-head__lead">共 {tags.length} 个标签，按文章数排序。</p>
    </header>

    <div class="tag-cloud">
      {
        tags.map((tag) => (
          <a href={`${base}/tags/${tag.slug}`} class="tag-item">
            <span class="tag-item__name">{tag.name}</span>
            <span class="tag-item__bar">
              <i style={`width:${Math.max(12, (tag.count / max) * 100)}%`} />
            </span>
            <span class="tag-item__count">{tag.count}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }
  .tag-item {
    display: grid;
    grid-template-columns: minmax(90px, 180px) 1fr 34px;
    align-items: center;
    gap: 16px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--rule-soft);
    transition: background 0.2s ease, padding 0.2s ease;
  }
  .tag-item:hover {
    background: var(--surface);
    padding-left: 10px;
    padding-right: 10px;
  }
  .tag-item__name {
    font-size: 14px;
    color: var(--ink-2);
    transition: color 0.2s ease;
  }
  .tag-item:hover .tag-item__name {
    color: var(--accent-deep);
  }
  .tag-item__bar {
    display: block;
    height: 2px;
    background: var(--rule-soft);
    border-radius: 2px;
    overflow: hidden;
  }
  .tag-item__bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-soft));
    border-radius: 2px;
    transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tag-item__count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-4);
    text-align: right;
  }
</style>
