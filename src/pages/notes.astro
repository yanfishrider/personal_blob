---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideNav from '../components/notes/SideNav.astro';
import CodeEditor from '../components/notes/CodeEditor.astro';
import PreviewPanel from '../components/notes/PreviewPanel.astro';
---

<BaseLayout theme="dark" title="学习笔记 - 摸鱼骑士 知识库" description="anime.js 交互式学习：左边目录、中间写、右边实时预览。">
  <SideNav slot="sidebar" />
  <CodeEditor />
  <PreviewPanel slot="rightSidebar" />
</BaseLayout>

<style is:global>
  html,
  body {
    overflow: hidden !important;
    height: 100vh !important;
  }
  #side-toolbar {
    display: none !important;
  }

  /* 编辑器整体骨架 */
  #site-shell {
    max-width: 1680px !important;
    height: calc(100vh - var(--header-h));
    padding: 0 14px 14px;
    grid-template-columns: 228px minmax(400px, 1fr) 480px;
    gap: 12px;
    align-items: stretch;
  }
  #site-shell .shell-left,
  #site-shell .shell-right {
    position: static;
    height: 100%;
    min-height: 0;
    max-height: none;
    overflow: visible;
  }
  #site-shell .shell-main {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  #site-shell .shell-main > * {
    flex: 1;
    min-height: 0;
  }

  #site-shell .shell-left > aside,
  #site-shell .shell-right > * {
    width: 100% !important;
    height: 100%;
  }
  #nav-tree {
    position: static !important;
    height: 100%;
    overflow-y: auto;
    padding: 4px 2px 20px;
  }

  #nav-tree .nav-item {
    display: flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 13px;
    color: #b6b0a5;
    cursor: pointer;
    transition: all 0.15s;
    user-select: none;
  }
  #nav-tree .nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #efeae0;
  }
  #nav-tree .nav-item.active {
    background: rgba(255, 123, 66, 0.12);
    color: #ff7b42;
    font-weight: 600;
  }
  .nav-arrow {
    margin-left: auto;
    font-size: 10px;
    opacity: 0.4;
    transition: transform 0.2s;
    display: inline-block;
  }
  .nav-item.expanded .nav-arrow {
    transform: rotate(90deg);
  }
  .nav-sub-wrap {
    border-left: 1px solid #3a3630;
    margin-left: 12px;
  }
  .nav-sub {
    position: relative;
    padding-left: 20px !important;
    font-size: 12px !important;
  }
  .nav-sub::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 10px;
    height: 1px;
    background: #3a3630;
  }
  .nav-sub2 {
    padding-left: 30px !important;
    font-size: 11px !important;
  }
  .nav-sub3 {
    padding-left: 38px !important;
    font-size: 11px !important;
  }

  .cm-editor {
    height: 100%;
    font-size: 14px;
  }
  .cm-editor .cm-scroller {
    overflow: auto;
  }
  .cm-editor.cm-focused {
    outline: none;
  }

  @media (max-width: 1180px) {
    #site-shell {
      grid-template-columns: 200px minmax(320px, 1fr) 360px;
    }
  }

  /* 窄屏放不下三栏：收起实时预览，保留「目录 + 编辑器」两栏 */
  @media (max-width: 900px) {
    #site-shell {
      grid-template-columns: 190px minmax(0, 1fr);
    }
    #site-shell .shell-right {
      display: none;
    }
  }
</style>
