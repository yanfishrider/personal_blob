---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="404 - 摸鱼骑士 知识库" description="页面不存在。">
  <div class="nf">
    <span class="nf__code">404</span>
    <h1 class="nf__title">这一页不在档案里</h1>
    <p class="nf__desc">链接可能已经失效，或者它从来就没被写下来过。</p>
    <div class="nf__actions">
      <a href={base || '/'} class="btn btn--solid">回到首页</a>
      <a href={`${base}/archive`} class="btn">翻翻归档</a>
    </div>
  </div>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    padding: 72px 0 48px;
  }
  .nf__code {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 16vw, 8rem);
    line-height: 0.9;
    color: var(--rule);
    letter-spacing: -0.04em;
    user-select: none;
  }
  .nf__title {
    margin-top: 18px;
    font-size: 1.35rem;
  }
  .nf__desc {
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .nf__actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
</style>
