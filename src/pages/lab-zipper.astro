---
// lab-zipper.astro — 动画馆 iframe 内容页 5：拉链幕布
// 卡片中间一条拉链（左右两排链齿 + 金属拉链头），幕布遮住内容。
// 拖动拉链头或点按钮 → 自上而下拉开：开口先张开到最大半宽 WM，之后等宽往下走；
// 幕布内边缘随开口退向两侧，内容层同步「从里往外推」（scale + 提亮 + 去模糊）。可逆。
// 纯 SVG + rAF 手写 tween，无外部依赖（iframe 内不拉 CDN）。
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>拉链幕布</title>
  <style>
    html, body { height: 100%; margin: 0; background: #1C1814; overflow: hidden; }
    body {
      font-family: 'Courier New', 'Consolas', 'Noto Sans SC', monospace;
      letter-spacing: 0.05em;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 16px;
    }

    /* ===== 卡片 ===== */
    .zip-card {
      position: relative;
      width: min(620px, 92vw, 110vh);
      aspect-ratio: 620 / 400;
      overflow: hidden;
      border-radius: 5px;
      background: #06090c;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .62), 0 0 0 1px rgba(34, 211, 238, .16);
    }

    /* ===== 被幕布遮住的内容层 ===== */
    .zip-content {
      --p: 0;
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      background:
        radial-gradient(120% 105% at 50% 46%, #143b47 0%, #0c1d24 56%, #060b0e 100%);
      transform: scale(calc(.82 + .18 * var(--p))) translateY(calc(18px * (1 - var(--p))));
      filter: brightness(calc(.42 + .58 * var(--p))) blur(calc(2.6px * (1 - var(--p))));
      opacity: calc(.34 + .66 * var(--p));
      will-change: transform, filter, opacity;
    }
    .zc-ring {
      position: absolute; width: 296px; height: 296px; border-radius: 50%;
      border: 1px solid rgba(34, 211, 238, .16);
      box-shadow: inset 0 0 60px rgba(34, 211, 238, .07);
    }
    .zc-inner { position: relative; text-align: center; padding: 0 26px; }
    .zc-kicker { font-size: 10px; letter-spacing: .34em; color: rgba(34, 211, 238, .78); }
    .zc-title {
      margin: 10px 0 12px; font-size: 30px; font-weight: 700; letter-spacing: .2em;
      color: #EAF9FF; text-shadow: 0 0 18px rgba(34, 211, 238, .45);
    }
    .zc-desc { margin: 0 0 18px; font-size: 12px; line-height: 2; color: rgba(210, 236, 246, .74); }
    .zc-tags { display: flex; gap: 8px; justify-content: center; }
    .zc-tags span {
      font-size: 9px; letter-spacing: .22em; padding: 4px 9px;
      color: rgba(34, 211, 238, .82); border: 1px solid rgba(34, 211, 238, .32);
    }

    /* ===== 舞台（幕布 + 链齿 + 拉链头） ===== */
    .zip-stage { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

    /* ===== 卡片下面：提示 + 按钮 ===== */
    .zip-hint {
      font-size: 11px; letter-spacing: .16em; color: rgba(34, 211, 238, .5);
      transition: opacity .3s ease;
    }
    .zip-btn {
      padding: 9px 30px; border-radius: 999px;
      font-family: inherit; font-size: 11px; letter-spacing: .28em;
      color: rgba(255, 255, 255, .9);
      border: 1px solid rgba(34, 211, 238, .45);
      background: rgba(34, 211, 238, .08);
      cursor: pointer; transition: background .25s ease, border-color .25s ease, color .25s ease;
    }
    .zip-btn:hover { background: rgba(34, 211, 238, .18); border-color: rgba(34, 211, 238, .9); color: #7FF3FF; }
  </style>
</head>
<body>
  <div class="zip-card" id="zipCard">
    <!-- 内容（在幕布之下） -->
    <div class="zip-content" id="zipContent">
      <div class="zc-ring"></div>
      <div class="zc-inner">
        <div class="zc-kicker">ANIMATION LAB / 05</div>
        <h2 class="zc-title">拉链幕布</h2>
        <p class="zc-desc">按住中间的拉链头向下拖，或点下面的按钮。<br/>幕布随拉链退向两侧，内容从里往外推出来。</p>
        <div class="zc-tags"><span>SVG</span><span>DRAG</span><span>REVERSIBLE</span></div>
      </div>
    </div>

    <!-- 舞台 -->
    <svg class="zip-stage" id="zipStage" viewBox="0 0 620 400" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- 帆布斜纹 -->
        <pattern id="zCloth" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="7" height="7" fill="#232a35" />
          <line x1="0" y1="0" x2="0" y2="7" stroke="#1a1f28" stroke-width="1.6" />
        </pattern>
        <!-- 统一色 #7DB6BF：单色填充 + 一道高光，不做金属渐变（简化） -->
        <filter id="zDrop" x="-60%" y="-60%" width="220%" height="220%">
          <feDropShadow dx="0" dy="2" stdDeviation="2.2" flood-color="#000" flood-opacity="0.45" />
        </filter>
        <!-- 单个链齿（左右共用，靠 x/y 实例化） -->
        <g id="zTooth">
          <path d="M-2.2 -1.9 L2.2 -1.9 L2.2 0.5 L1 1.7 L1 2.5 L-1 2.5 L-1 1.7 L-2.2 0.5 Z"
                fill="#7DB6BF" stroke="#4a7f88" stroke-width="0.5" />
          <path d="M-1.7 -1.4 L1.7 -1.4" stroke="#cfeaef" stroke-width="0.7" fill="none" opacity="0.8" />
        </g>
      </defs>

      <!-- 两片幕布 + 内边缘的亮边/内侧阴影 -->
      <path id="zClothL" fill="url(#zCloth)" />
      <path id="zClothR" fill="url(#zCloth)" />
      <path id="zShadeL" fill="none" stroke="#05080b" stroke-width="13" opacity="0.5" />
      <path id="zShadeR" fill="none" stroke="#05080b" stroke-width="13" opacity="0.5" />
      <path id="zEdgeL"  fill="none" stroke="#7DB6BF" stroke-width="1.2" opacity="0.3" />
      <path id="zEdgeR"  fill="none" stroke="#7DB6BF" stroke-width="1.2" opacity="0.3" />

      <!-- 两排链齿 -->
      <g id="zTeethL"></g>
      <g id="zTeethR"></g>

      <!-- 拉链头（简化版：单色 #7DB6BF + 一道高光，整体约为原尺寸 2/3） -->
      <g id="zSlider" filter="url(#zDrop)">
        <!-- 拉片（会随拖动摆） -->
        <g id="zTab">
          <circle cx="0" cy="-24" r="3.6" fill="none" stroke="#7DB6BF" stroke-width="2" />
          <path d="M-3 -20.5 L3 -20.5 L2.2 -10 L-2.2 -10 Z" fill="#7DB6BF" stroke="#4a7f88" stroke-width="0.7" />
        </g>
        <!-- 滑块主体 -->
        <path d="M-11 -9 L11 -9 L11 4 L5 14 L-5 14 L-11 4 Z"
              fill="#7DB6BF" stroke="#4a7f88" stroke-width="0.9" />
        <path d="M-5 13 L5 13 L3 20 L-3 20 Z" fill="#6aa4ae" stroke="#4a7f88" stroke-width="0.7" />
        <path d="M-9 -7 L9 -7" stroke="#d8eef2" stroke-width="0.9" opacity="0.7" fill="none" />
        <!-- 抓取区（覆盖滑块 + 拉片）：必须用 id 定位 —— querySelector('rect') 会拿到别的 rect -->
        <rect id="zHit" x="-16" y="-30" width="32" height="54" fill="transparent" pointer-events="all" style="cursor:grab" />
      </g>
    </svg>
  </div>

  <div class="zip-hint" id="zipHint">按住拉链头向下拖，或点下面的按钮</div>
  <button class="zip-btn" id="zipBtn" type="button">拉开</button>

  <script type="module">
    var SVGNS = 'http://www.w3.org/2000/svg';
    var W = 620, H = 400, CX = 310;      // 卡片坐标系（与 viewBox 一致）
    var WM = 118;                        // p=0 时的最大半开口（保留「张开到一定宽度后等宽往下走」）
    var SPREAD = 262;                    // 散开增量：p=1 时最大半开口 = 380 > CX=310 → 两片幕布整片移到容器外
    var L = 150;                         // p=0 时的过渡带长度（斜边长度尺度，越大越斜）
    var PT = 9.5;                        // 链齿齿距（左右错开半格 = 咬合）
    var OPEN_MAX = 400;                  // 已拉开长度上限（p=1 时开口延伸到底边 → 无残留闭合段）
    var HANDLE_PAD = 30;                 // 拉链头中心比开口底端低多少（拉片顶端正好落在开口底端）
    var p = 0;                           // 0 = 全闭，1 = 全开

    var stage = document.getElementById('zipStage');
    var card = document.getElementById('zipCard');
    var content = document.getElementById('zipContent');
    var hint = document.getElementById('zipHint');
    var btn = document.getElementById('zipBtn');
    var clothL = document.getElementById('zClothL'), clothR = document.getElementById('zClothR');
    var shadeL = document.getElementById('zShadeL'), shadeR = document.getElementById('zShadeR');
    var edgeL = document.getElementById('zEdgeL'), edgeR = document.getElementById('zEdgeR');
    var slider = document.getElementById('zSlider');
    var tab = document.getElementById('zTab');
    var gL = document.getElementById('zTeethL'), gR = document.getElementById('zTeethR');

    function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }
    function fmt(n) { return Math.round(n * 100) / 100; }

    // ===== 链齿实例化 =====
    var teethL = [], teethR = [], i, y;
    for (i = 0; i < 41; i++) {
      y = 8 + i * PT;
      var ul = document.createElementNS(SVGNS, 'use');
      ul.setAttribute('href', '#zTooth'); ul.setAttribute('y', y);
      gL.appendChild(ul); teethL.push({ el: ul, y: y });
      var yr = 8 + PT / 2 + i * PT;
      var ur = document.createElementNS(SVGNS, 'use');
      ur.setAttribute('href', '#zTooth'); ur.setAttribute('y', yr);
      gR.appendChild(ur); teethR.push({ el: ur, y: yr });
    }

    // 开口半宽（p、A、T 变化，故在 render 内按当前状态求值）：
    // 拉链头处恒为 0（仍咬合），往上先按斜边张到 A，达到 A 后等宽 —— A/T 都随 p 增大
    function render() {
      var pc = clamp(p, 0, 1);
      var open = pc * OPEN_MAX;              // 已拉开长度（从卡片顶边往下算，= 开口底端 y）
      var ys = open + HANDLE_PAD;            // 拉链头（把手）中心 y：拉片顶端正好落在开口底端
      var A = WM + SPREAD * Math.pow(pc, 1.2);   // 最大半开口：118 → 380（p=1 时 > CX → 出容器）
      var T = L * (1 - 0.84 * pc);               // 过渡带：150 → 24（越拉越陡 → 散开感）
      function xEdge(yy) {
        var d = open - yy;
        if (d <= 0) return 0;
        return d >= T ? A : A * d / T;
      }
      var xT = CX - xEdge(0);                // 顶部内边缘
      var y1 = clamp(open - T, 0, open);     // 达到最大开口的 y
      var a = fmt(xT), b = fmt(CX - A), c = fmt(open), h1 = fmt(y1);
      var lo = fmt(-A), ro = fmt(W + A);     // 幕布外边界（被推出容器的部分，容器外不可见）

      // 左幕布 / 右幕布（右 = 以 CX 镜像）
      clothL.setAttribute('d', 'M' + lo + ' 0 L' + a + ' 0 L' + b + ' ' + h1 + ' L' + CX + ' ' + c + ' L' + CX + ' ' + H + ' L' + lo + ' ' + H + ' Z');
      clothR.setAttribute('d', 'M' + ro + ' 0 L' + fmt(W - xT) + ' 0 L' + fmt(W - (CX - A)) + ' ' + h1 + ' L' + CX + ' ' + c + ' L' + CX + ' ' + H + ' L' + ro + ' ' + H + ' Z');
      // 内边缘：内侧阴影 + 亮边
      var eL = 'M' + a + ' 0 L' + b + ' ' + h1 + ' L' + CX + ' ' + c + ' L' + CX + ' ' + H;
      var eR = 'M' + fmt(W - xT) + ' 0 L' + fmt(W - (CX - A)) + ' ' + h1 + ' L' + CX + ' ' + c + ' L' + CX + ' ' + H;
      edgeL.setAttribute('d', eL); edgeR.setAttribute('d', eR);
      shadeL.setAttribute('d', 'M' + fmt(xT - 6) + ' 0 L' + fmt(CX - A - 6) + ' ' + h1 + ' L' + fmt(CX - 6) + ' ' + c + ' L' + fmt(CX - 6) + ' ' + H);
      shadeR.setAttribute('d', 'M' + fmt(W - xT + 6) + ' 0 L' + fmt(W - (CX - A) + 6) + ' ' + h1 + ' L' + fmt(CX + 6) + ' ' + c + ' L' + fmt(CX + 6) + ' ' + H);

      // 链齿：跟着内边缘走，闭合时错半格咬在中缝
      for (var k = 0; k < teethL.length; k++) {
        teethL[k].el.setAttribute('x', fmt(CX - xEdge(teethL[k].y) - 2.2));
        teethR[k].el.setAttribute('x', fmt(CX + xEdge(teethR[k].y) + 2.2));
      }

      // 拉链头
      slider.setAttribute('transform', 'translate(' + CX + ' ' + fmt(ys) + ')');

      // 内容层：从里往外推
      content.style.setProperty('--p', pc.toFixed(4));
      hint.style.opacity = String(clamp(1 - pc * 9, 0, 1));
      var want = pc > 0.5 ? '拉上' : '拉开';
      if (btn.textContent !== want) btn.textContent = want;
    }

    // ===== tween（按钮触发，带轻微超调，像拉链到头「咔」一下）=====
    var rafId = 0;
    function easeOutBack(t) { var c1 = 1.70158, c3 = c1 + 1; return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2); }
    function tweenTo(target) {
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      var from = p, t0 = performance.now();
      var dur = Math.max(380, Math.abs(target - from) * 820);
      var lastP = from;
      (function step(now) {
        var k = Math.min(1, (now - t0) / dur);
        p = from + (target - from) * easeOutBack(k);
        render();
        swingSet((p - lastP) * 900);         // 拉片随速度摆动
        lastP = p;
        if (k < 1) { rafId = requestAnimationFrame(step); }
        else { p = target; render(); rafId = 0; settle(); }
      })(performance.now());
    }

    // ===== 拉片摆动（速度驱动 + 回正衰减）=====
    var angle = 0, settleId = 0;
    function swingSet(v) { angle = clamp(-v * 1.6, -26, 26); tab.style.transform = 'rotate(' + angle.toFixed(2) + 'deg)'; }
    function settle() {
      if (settleId) cancelAnimationFrame(settleId);
      (function dec() {
        angle *= 0.86;
        tab.style.transform = 'rotate(' + angle.toFixed(2) + 'deg)';
        if (Math.abs(angle) > 0.25) settleId = requestAnimationFrame(dec); else { settleId = 0; tab.style.transform = ''; }
      })();
    }
    // SVG 旋转中心：拉片挂在滑块顶部
    tab.style.transformOrigin = '0px -13px';
    tab.style.transformBox = 'view-box';

    // ===== 拖动（鼠标 / 触摸通用）=====
    var drag = false, dragY0 = 0, dragP0 = 0;
    var hit = document.getElementById('zHit');
    hit.addEventListener('pointerdown', function (e) {
      drag = true; dragY0 = e.clientY; dragP0 = p;
      if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
      if (settleId) { cancelAnimationFrame(settleId); settleId = 0; }
      hit.setPointerCapture(e.pointerId);
      hit.style.cursor = 'grabbing';
      e.preventDefault();
    });
    hit.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var r = stage.getBoundingClientRect();
      var unit = r.height / H;                 // 1 用户单位 = unit 像素
      var prev = p;
      p = clamp(dragP0 + (e.clientY - dragY0) / (unit * OPEN_MAX), 0, 1);
      render();
      swingSet((p - prev) * 900);
    });
    function endDrag(e) {
      if (!drag) return;
      drag = false;
      hit.style.cursor = 'grab';
      try { hit.releasePointerCapture(e.pointerId); } catch (err) {}
      settle();
      if (p > 0.96) tweenTo(1); else if (p < 0.04) tweenTo(0);
    }
    hit.addEventListener('pointerup', endDrag);
    hit.addEventListener('pointercancel', endDrag);

    // ===== 按钮 =====
    btn.addEventListener('click', function () { tweenTo(p > 0.5 ? 0 : 1); });

    render();
  </script>
</body>
</html>
